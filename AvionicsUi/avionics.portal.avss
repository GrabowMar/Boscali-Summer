/* Portal instrument glass. Slate reading planes, ice-blue focus and a separate mint ready light. */
:root {
  ground:          #101922 fb;
  surface:         #233541;
  surface-raised:  #324B59;
  surface-inert:   #192832 f8;
  surface-sunken:  #101C25 fa;
  hairline:        #75909F 48;
  frame:           #86A0B0 84;
  ink:             #EDF5F8;
  ink-dim:         #BCD0DA;
  ink-muted:       #9CB2BF;
  key:             #83CADB;
  select:          #96E3F0;
  ready:           #91DCC2;
  caution:         #F5BA56;
  effort:          #F5BA56;
  danger:          #FF695B;
  info:            #8FD8FF;
  inert:           #3A4855 a6;
  friendly:        friendly;
  hostile:         hostile;
}
