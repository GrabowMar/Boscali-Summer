/* Portal · smoked instrument glass. Cyan = selection/ready, amber = caution, red = danger.
   The nearly opaque ground protects text over bright terrain; inner plates supply the frost depth. */
:root {
  ground:          #0B1419 f5;
  surface:         #20343E e8;
  surface-raised:  #2D4652 f2;
  surface-inert:   #12232B e8;
  surface-sunken:  #0C171D f5;
  hairline:        #78939F 58;
  frame:           #A5BEC8 a8;
  ink:             #EDF5F7;
  ink-dim:         #C0D1D8;
  ink-muted:       #A2B8C2;
  key:             #8DDEEA;
  select:          #8DDEEA;
  ready:           #8DDEEA;
  caution:         #F5BA56;
  effort:          #F5BA56;
  danger:          #FF695B;
  info:            #8FD8FF;
  inert:           #3A4855 a6;
  friendly:        friendly;
  hostile:         hostile;
}
