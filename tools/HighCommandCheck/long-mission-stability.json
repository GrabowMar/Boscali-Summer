{
  "name": "long-mission-stability",
  "description": "Fifteen mission minutes at time scale one in Terminal Control. Checks real operation outcomes, reward/ledger consistency and exceptions with every ordinary gameplay module active. Requests hidden 960x540 rendering, which native launch settings can override; not an FPS or visual-quality benchmark. Run with --speed 1 so seating time-scale reset cannot shorten the toolkit wall budget. Extra wall time accommodates presentation throttling on a locked desktop.",
  "mission": "Terminal Control",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 3600,
  "environment": {
    "config": {
      "bepinex": {
        "Logging.Disk": {
          "WriteUnityLog": true
        }
      }
    },
    "resolution": [
      960,
      540
    ]
  },
  "ops": [
    {
      "op": "seat",
      "id": "player",
      "faction": "Boscali",
      "near": [
        50000,
        15000
      ],
      "altitude": 9000,
      "speed": 200,
      "heading": 0
    },
    {
      "op": "fly",
      "id": "player",
      "program": [
        {
          "orbit": {
            "bank": 30,
            "seconds": 1000
          }
        }
      ]
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.GroundProof.Arm",
      "args": {
        "kinds": "ASSAULT,DEFEND"
      },
      "store": "arm"
    },
    {
      "op": "wait",
      "seconds": 150
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r1"
    },
    {
      "op": "wait",
      "seconds": 150
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r2"
    },
    {
      "op": "wait",
      "seconds": 150
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r3"
    },
    {
      "op": "wait",
      "seconds": 150
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r4"
    },
    {
      "op": "wait",
      "seconds": 150
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r5"
    },
    {
      "op": "wait",
      "seconds": 150
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r6"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.GroundProof.Read",
      "args": {},
      "store": "g"
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_above",
      "path": "r6.war.boscali.resultOutcomeSet",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "r6.war.boscali.resultWhyIsTimeLimit",
      "max": 0
    },
    {
      "check": "result_below",
      "path": "r6.war.boscali.check.rewardMismatch",
      "max": 0
    },
    {
      "check": "result_below",
      "path": "r6.war.boscali.check.rewardLedgerDelta",
      "max": 0
    },
    {
      "check": "result_below",
      "path": "r6.war.boscali.faults",
      "max": 0
    },
    {
      "check": "log_match",
      "pattern": "Exception",
      "max": 0
    }
  ]
}
