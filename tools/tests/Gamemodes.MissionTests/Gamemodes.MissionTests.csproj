<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../../modules/Gamemodes/Domain/GamemodeRules.cs" Link="GamemodeRules.cs" />
    <Compile Include="../../../modules/Gamemodes/Runtime/GamemodeMissionBuilder.cs" Link="GamemodeMissionBuilder.cs" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameDir)\NuclearOption_Data\Managed\Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>
