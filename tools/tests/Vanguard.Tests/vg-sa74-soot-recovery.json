{
  "name": "vg-sa74-soot-recovery",
  "description": "Isolated aged snapshot creates only persistent native soot and crater, never a fresh explosion/decal. Same fixed below-cloud camera captures soot off-before, on, off-after to prove actual projector blackening without an overlapping fresh nuke mark.",
  "mods": ["boscalisummer"],
  "timeout_s": 240,
  "ops": [
    { "op": "spawn", "id": "observer", "type": "VL-49 Tarantula", "faction": "Boscali", "at": { "map": [-24500, -17400] }, "altitude": 3000, "speed": 80, "heading": 0 },
    { "op": "observe", "follow": "observer" },
    { "op": "wait", "seconds": 1 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "time", "hours": 12 } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "recover" }, "store": "recovered" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "sample", "seconds": 1800, "distance": 2300, "height": 350, "side": -1100, "aimHeight": -150, "fov": 68 } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "soot", "visible": false } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" } },
    { "op": "capture", "name": "ground-native-soot-before", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "soot", "visible": true } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" } },
    { "op": "capture", "name": "ground-native-soot-crater", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" }, "store": "scar" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "soot", "visible": false } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" } },
    { "op": "capture", "name": "ground-native-soot-off-comparison", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "soot", "visible": true } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "reset" } },
    { "op": "wait", "seconds": 0.1 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" }, "store": "clean" },
    { "op": "end" }
  ],
  "checks": [
    { "check": "status_ok" },
    { "check": "result_equals", "path": "recovered.nativeBlasts", "value": 0 },
    { "check": "result_equals", "path": "recovered.nativeSootCount", "value": 0 },
    { "check": "result_equals", "path": "recovered.nativePersistentSoot", "value": 1 },
    { "check": "result_equals", "path": "scar.nativeBlasts", "value": 0 },
    { "check": "result_equals", "path": "scar.nativePersistentSoot", "value": 1 },
    { "check": "result_above", "path": "scar.groundProbe.drop", "min": 180 },
    { "check": "result_above", "path": "scar.snowParticles", "min": 1000 },
    { "check": "result_equals", "path": "scar.blastSoundsPlayed", "value": 0 },
    { "check": "result_equals", "path": "scar.particleSystems", "value": 0 },
    { "check": "result_equals", "path": "clean.active", "value": false },
    { "check": "result_equals", "path": "clean.nativePersistentSoot", "value": 0 },
    { "check": "result_below", "path": "clean.groundProbe.restoredError", "max": 0.1 }
  ]
}
