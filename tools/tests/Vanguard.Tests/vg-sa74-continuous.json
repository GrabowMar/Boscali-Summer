{
  "name": "vg-sa74-continuous",
  "description": "Uninterrupted first 30 seconds of a land burst: no effect-age jumps or paused sampling. Checks render, cooling, expanding cloud clearance and reset; native cargo release is a separate scenario.",
  "mods": ["boscalisummer"],
  "timeout_s": 240,
  "ops": [
    { "op": "spawn", "id": "observer", "type": "VL-49 Tarantula", "faction": "Boscali", "at": { "map": [-24500, -17400] }, "altitude": 3000, "speed": 80, "heading": 0 },
    { "op": "observe", "follow": "observer" },
    { "op": "wait", "seconds": 1 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "detonate", "land": true }, "store": "blast" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "look", "distance": 20000, "height": 1800, "side": -4000, "aimHeight": 3500, "fov": 75 } },
    { "op": "wait", "seconds": 3 },
    { "op": "capture", "name": "continuous-fireball", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "early" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "look", "distance": 24000, "height": 2200, "side": -4000, "aimHeight": 6500, "fov": 80 } },
    { "op": "wait", "seconds": 7 },
    { "op": "capture", "name": "continuous-buoyancy", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "rising" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "look", "distance": 28000, "height": 4500, "side": -4000, "aimHeight": 11000, "fov": 85 } },
    { "op": "wait", "seconds": 18 },
    { "op": "capture", "name": "continuous-pressure-front", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "front" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "reset" } },
    { "op": "wait", "seconds": 0.1 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "clean" },
    { "op": "end" }
  ],
  "checks": [
    { "check": "status_ok" },
    { "check": "result_equals", "path": "blast.nativeBlasts", "value": 1 },
    { "check": "result_above", "path": "early.thermalPulse", "min": 0.25 },
    { "check": "result_equals", "path": "early.winterBlend", "value": 0 },
    { "check": "result_equals", "path": "early.mushroomReady", "value": true },
    { "check": "result_above", "path": "rising.mushroomFrame", "min": 1 },
    { "check": "result_below", "path": "rising.thermalPulse", "max": 0.5 },
    { "check": "result_below", "path": "front.thermalPulse", "max": 0.05 },
    { "check": "result_above", "path": "front.cloudHoleRadius", "min": 11000 },
    { "check": "result_above", "path": "front.blastColliders", "min": 1 },
    { "check": "result_above", "path": "front.winterBlend", "min": 0.01 },
    { "check": "result_equals", "path": "clean.active", "value": false },
    { "check": "result_equals", "path": "clean.particleSystems", "value": 0 },
    { "check": "result_above", "path": "clean.terrainRestored", "min": 1 }
  ]
}
