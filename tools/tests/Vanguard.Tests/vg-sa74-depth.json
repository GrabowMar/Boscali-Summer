{
  "name": "vg-sa74-depth",
  "description": "Fixed low-eye Weather/mushroom overlap regression: identical camera at600 and960 seconds distinguishes the volumetric composite from the underlying sky. Frozen age fixture, not continuous native simulation.",
  "mods": ["boscalisummer"],
  "timeout_s": 120,
  "ops": [
    { "op": "spawn", "id": "observer", "type": "VL-49 Tarantula", "faction": "Boscali", "at": { "map": [-24500, -17400] }, "altitude": 3000, "speed": 80, "heading": 0 },
    { "op": "observe", "follow": "observer" },
    { "op": "wait", "seconds": 1 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "time", "hours": 12 } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "detonate", "land": true } },
    { "op": "wait", "seconds": 1.2 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "sample", "seconds": 600, "distance": 65000, "height": 650, "side": 2300, "aimHeight": 30000, "fov": 74 } },
    { "op": "capture", "name": "depth-600-first-frame", "hide_ui": true },
    { "op": "capture", "name": "depth-600-weather-foreground", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "cloud" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "sample", "seconds": 960, "distance": 65000, "height": 650, "side": 2300, "aimHeight": 30000, "fov": 74 } },
    { "op": "capture", "name": "depth-960-weather-alone", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "background" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "reset" } },
    { "op": "end" }
  ],
  "checks": [
    { "check": "status_ok" },
    { "check": "result_equals", "path": "cloud.mushroomAfterWeather", "value": true },
    { "check": "result_equals", "path": "cloud.mushroomSites", "value": 1 },
    { "check": "result_above", "path": "cloud.mushroomBytes", "min": 1 },
    { "check": "result_equals", "path": "background.mushroomSites", "value": 0 },
    { "check": "result_equals", "path": "background.mushroomBytes", "value": 0 }
  ]
}
