{
  "name": "vg-sa74-fallback",
  "description": "Three concurrent controlled bursts: two custom volumes plus the older native cloud/fireball fallback. Presentation limit and reset regression; no native release claims.",
  "mods": ["boscalisummer"],
  "timeout_s": 240,
  "ops": [
    { "op": "spawn", "id": "observer", "type": "VL-49 Tarantula", "faction": "Boscali", "at": { "map": [-24500, -17400] }, "altitude": 3000, "speed": 80, "heading": 0 },
    { "op": "observe", "follow": "observer" },
    { "op": "wait", "seconds": 1 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "detonate", "land": true } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "detonate", "x": 20000, "z": 20000 } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "detonate", "x": 40000, "z": 30000 } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "sample", "seconds": 4, "distance": 40000, "height": 8000, "side": -20000, "aimHeight": 3500, "fov": 90 } },
    { "op": "capture", "name": "three-burst-fallback", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "three" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "reset" } },
    { "op": "wait", "seconds": 0.1 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "clean" },
    { "op": "end" }
  ],
  "checks": [
    { "check": "status_ok" },
    { "check": "result_equals", "path": "three.sites", "value": 3 },
    { "check": "result_equals", "path": "three.nativeBlasts", "value": 3 },
    { "check": "result_equals", "path": "three.mushroomSites", "value": 2 },
    { "check": "result_above", "path": "three.mushroomFrame", "min": 1 },
    { "check": "result_equals", "path": "three.nativeFallbackRenderers", "value": 2 },
    { "check": "result_equals", "path": "three.nativeSuppressedRenderers", "value": 4 },
    { "check": "result_equals", "path": "clean.active", "value": false },
    { "check": "result_equals", "path": "clean.nativeFallbackRenderers", "value": 0 },
    { "check": "result_equals", "path": "clean.nativeSuppressedRenderers", "value": 0 }
  ]
}
