{
  "name": "vg-sa74-winter",
  "description": "Mission-long snowfall and readable aftermath, with a prominent ten-minute mushroom and sixteen-minute atmospheric dispersal. Frozen age samples establish appearance and bounded effects, not uninterrupted native simulation.",
  "mods": ["boscalisummer"],
  "timeout_s": 240,
  "ops": [
    { "op": "spawn", "id": "observer", "type": "VL-49 Tarantula", "faction": "Boscali", "at": { "map": [-24500, -17400] }, "altitude": 3000, "speed": 80, "heading": 0 },
    { "op": "wait", "seconds": 2 },
    { "op": "observe", "follow": "observer" },
    { "op": "wait", "seconds": 1 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "time", "hours": 12 } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "detonate", "land": true }, "store": "blast" },
    { "op": "wait", "seconds": 1.2 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "sample", "seconds": 120, "distance": 40000, "height": 3000, "side": -4000, "aimX": 12000, "aimHeight": 1500, "fov": 75 } },
    { "op": "capture", "name": "winter-2min-day-horizon", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "day120" },
    { "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "side": 20000, "fov": 75, "distance": 95000, "aimX": 0, "action": "sample", "seconds": 600, "aimHeight": 36000, "height": 15000 }, "op": "call" },
    { "hide_ui": true, "name": "winter-10min-prominent-mushroom", "op": "capture" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "sample", "seconds": 600, "distance": 65000, "height": 650, "side": 2300, "aimHeight": 30000, "fov": 74 } },
    { "op": "capture", "name": "winter-10min-below-cloud-deck", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "sample", "seconds": 600, "distance": 5500, "height": 6000, "side": -1500, "aimX": 15000, "aimHeight": 200, "fov": 75 } },
    { "op": "capture", "name": "winter-10min-day-native-soot-snow", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "day600" },
    { "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "side": 20000, "fov": 75, "distance": 95000, "aimX": 0, "action": "sample", "seconds": 960, "aimHeight": 36000, "height": 15000 }, "op": "call" },
    { "hide_ui": true, "name": "winter-16min-mushroom-dispersed", "op": "capture" },
    { "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "day960", "op": "call" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "sample", "seconds": 1200, "distance": 4000, "height": 900, "side": -1000, "aimX": 20000, "aimHeight": 1500, "fov": 75 } },
    { "op": "capture", "name": "winter-20min-day-local-fallout", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "near1200" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "sample", "seconds": 1200, "distance": 120000, "height": 4500, "side": 0, "aimX": 145000, "aimHeight": 1800, "fov": 75 } },
    { "op": "capture", "name": "winter-20min-day-remote-snowfall", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "far1200" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "time", "hours": 0 } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "sample", "seconds": 1200, "distance": 12000, "height": 1500, "side": -2500, "aimX": 20000, "aimHeight": 1200, "fov": 75 } },
    { "op": "capture", "name": "winter-20min-night-preserved", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "night1200" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "reset" } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "time", "hours": 12 } },
    { "op": "wait", "seconds": 0.1 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "clean" },
    { "op": "end" }
  ],
  "checks": [
    { "check": "result_above", "path": "day600.mushroomSites", "min": 1 },
    { "check": "result_above", "path": "day600.mushroomBytes", "min": 1 },
    { "check": "result_above", "path": "day600.mushroomRemaining", "min": 350 },
    { "check": "result_equals", "path": "day960.mushroomSites", "value": 0 },
    { "check": "result_equals", "path": "day960.mushroomBytes", "value": 0 },
    { "check": "result_equals", "path": "day960.mushroomWidth", "value": 0 },
    { "check": "result_above", "path": "day960.mushroomDispersed", "min": 1 },
    { "check": "result_above", "path": "day120.blastRadiusKm", "min": 75 },
    { "check": "result_equals", "path": "near1200.mushroomSites", "value": 0 },
    { "check": "result_equals", "path": "near1200.mushroomBytes", "value": 0 },
    { "check": "result_below", "path": "day120.conditions", "max": 0.6001 },
    { "check": "status_ok" },
    { "check": "result_equals", "path": "blast.events", "value": 1 },
    { "check": "result_equals", "path": "day120.snowEmitting", "value": true },
    { "check": "result_above", "path": "day120.snowParticles", "min": 1000 },
    { "check": "result_below", "path": "day120.snowParticles", "max": 1501 },
    { "check": "result_above", "path": "day120.winterBlend", "min": 0.99 },
    { "check": "result_below", "path": "day120.fogDensity", "max": 7.1E-05 },
    { "check": "result_equals", "path": "day120.cloudHeight", "value": 6000 },
    { "check": "result_above", "path": "day120.atmosphereExposure", "min": -0.36 },
    { "check": "result_below", "path": "day120.atmosphereExposure", "max": -0.34 },
    { "check": "result_equals", "path": "day600.snowEmitting", "value": true },
    { "check": "result_above", "path": "day600.snowParticles", "min": 1000 },
    { "check": "result_below", "path": "day600.snowParticles", "max": 1501 },
    { "check": "result_equals", "path": "day600.dustParticles", "value": 0 },
    { "check": "result_equals", "path": "near1200.snowEmitting", "value": true },
    { "check": "result_above", "path": "near1200.snowParticles", "min": 1000 },
    { "check": "result_above", "path": "near1200.radiationStrength", "min": 0.7 },
    { "check": "result_above", "path": "near1200.radiationGrain", "min": 0.03 },
    { "check": "result_below", "path": "near1200.radiationGrain", "max": 0.051 },
    { "check": "result_equals", "path": "far1200.snowEmitting", "value": true },
    { "check": "result_above", "path": "far1200.snowParticles", "min": 1000 },
    { "check": "result_below", "path": "far1200.radiationStrength", "max": 0.001 },
    { "check": "result_below", "path": "far1200.radiationGrain", "max": 0.001 },
    { "check": "result_equals", "path": "night1200.snowEmitting", "value": true },
    { "check": "result_above", "path": "night1200.snowParticles", "min": 1000 },
    { "check": "result_below", "path": "night1200.fogDensity", "max": 7.1E-05 },
    { "check": "result_equals", "path": "clean.active", "value": false },
    { "check": "result_equals", "path": "clean.snowParticles", "value": 0 },
    { "check": "result_equals", "path": "clean.snowEmitting", "value": false },
    { "check": "result_equals", "path": "clean.radiationStrength", "value": 0 },
    { "check": "result_equals", "path": "clean.radiationGrain", "value": 0 },
    { "check": "result_equals", "path": "clean.atmosphereExposure", "value": 0 }
  ]
 }
