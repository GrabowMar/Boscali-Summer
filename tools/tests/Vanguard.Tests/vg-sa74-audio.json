{
  "name": "vg-sa74-audio",
  "description": "Continuous close-listener pressure arrival: flash first, original pressure boom and rumbling dust tail after the front travels to the listener. No presentation-age jumps.",
  "mods": ["boscalisummer"],
  "timeout_s": 240,
  "ops": [
    { "op": "spawn", "id": "observer", "type": "VL-49 Tarantula", "faction": "Boscali", "at": { "map": [-24500, -17400] }, "altitude": 3000, "speed": 80, "heading": 0 },
    { "op": "observe", "follow": "observer" },
    { "op": "wait", "seconds": 1 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "detonate", "land": true } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "look", "distance": 11000, "height": 500, "side": 0, "aimHeight": 2200, "fov": 100 } },
    { "op": "wait", "seconds": 1 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "before" },
    { "op": "wait", "seconds": 7 },
    { "op": "capture", "name": "pressure-arrival", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "arrival" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "nativeFront" }, "store": "front" },
    { "op": "wait", "seconds": 3 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "tail" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "reset" } },
    { "op": "wait", "seconds": 0.1 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "clean" },
    { "op": "end" }
  ],
  "checks": [
    { "check": "status_ok" },
    { "check": "result_equals", "path": "before.blastSoundsPlayed", "value": 0 },
    { "check": "result_above", "path": "before.blastSoundPending", "min": 1 },
    { "check": "result_equals", "path": "arrival.blastAudioReady", "value": true },
    { "check": "result_equals", "path": "arrival.blastSoundsPlayed", "value": 1 },
    { "check": "result_above", "path": "front.radius", "min": 11000 },
    { "check": "result_above", "path": "arrival.blastSoundVoices", "min": 1 },
    { "check": "result_above", "path": "arrival.nativeAudioSuppressed", "min": 1 },
    { "check": "result_above", "path": "tail.blastSoundOutputRms", "min": 0.0001 },
    { "check": "result_above", "path": "tail.blastSoundVoices", "min": 1 },
    { "check": "result_equals", "path": "tail.blastSoundsPlayed", "value": 1 },
    { "check": "result_equals", "path": "clean.blastSoundVoices", "value": 0 },
    { "check": "result_equals", "path": "clean.blastSoundPending", "value": 0 }
  ]
}
