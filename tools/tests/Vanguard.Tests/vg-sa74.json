{
  "name": "vg-sa74",
  "description": "SA-74N real cargo fit and release, native impact, persistent nuclear winter, and aftermath cleanup. Single-host evidence only.",
  "mods": ["boscalisummer"],
  "timeout_s": 720,
  "ops": [
    { "op": "spawn", "id": "lead", "type": "VL-49 Tarantula", "faction": "Boscali", "at": { "map": [-24500, -17400] }, "altitude": 3000, "speed": 80, "heading": 0 },
    { "op": "fly", "id": "lead", "program": [{ "level": 500 }] },
    { "op": "observe", "follow": "lead" },
    { "op": "wait", "seconds": 8 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74Automation.Step", "args": { "action": "catalog" }, "store": "catalog" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74Automation.Step", "args": { "action": "equip", "type": "Tarantula" }, "store": "fit" },
    { "op": "wait", "seconds": 2 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74Automation.Step", "args": { "action": "status", "type": "Tarantula" }, "store": "loaded" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74Automation.Step", "args": { "action": "look", "type": "Tarantula", "distance": 28 }, "store": "look" },
    { "op": "capture", "name": "sa74n-two-cargo-carriage", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74Automation.Step", "args": { "action": "unfreeze" }, "store": "unfreeze" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74Automation.Step", "args": { "action": "release", "type": "Tarantula" }, "store": "release" },
    { "op": "wait", "seconds": 5 },
    { "op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": { "step": "state" }, "store": "releaseRadio" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74Automation.Step", "args": { "action": "status", "type": "Tarantula" }, "store": "flight" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74Automation.Step", "args": { "action": "lookBomb", "distance": 16 }, "store": "lookBomb" },
    { "op": "capture", "name": "sa74n-bomb-in-flight", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74Automation.Step", "args": { "action": "unfreeze" }, "store": "unfreezeFlight" },
    { "op": "wait", "seconds": 40 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "impact" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "look", "distance": 16000, "height": 7000 }, "store": "lookBlast" },
    { "op": "capture", "name": "sa74n-flashback-cloud", "hide_ui": true },
    { "op": "wait", "seconds": 160 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "winter" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "look", "distance": 5000, "height": 3500 }, "store": "lookCrater" },
    { "op": "capture", "name": "sa74n-persistent-nuclear-winter", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "reset" }, "store": "reset" },
    { "op": "wait", "seconds": 2 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "clean" },
    { "op": "capture", "name": "sa74n-cleanup-restored", "hide_ui": true },
    { "op": "end" }
  ],
  "checks": [
    { "check": "status_ok" },
    { "check": "result_equals", "path": "catalog.built", "value": true },
    { "check": "result_above", "path": "fit.capacitySlots", "min": 2 },
    { "check": "result_equals", "path": "fit.conflictRejected", "value": true },
    { "check": "result_above", "path": "loaded.loadedRounds", "min": 1 },
    { "check": "result_above", "path": "loaded.modelRenderers", "min": 1 },
    { "check": "result_above", "path": "flight.flightCount", "min": 1 },
    { "check": "result_above", "path": "releaseRadio.nuclearDrop", "min": 1 },
    { "check": "result_equals", "path": "releaseRadio.nuclearBlocking", "value": true },
    { "check": "result_equals", "path": "releaseRadio.nuclearBlackout", "value": false },
    { "check": "result_equals", "path": "impact.active", "value": true },
    { "check": "result_equals", "path": "impact.events", "value": 1 },
    { "check": "result_equals", "path": "impact.nativeBlasts", "value": 1 },
    { "check": "result_above", "path": "impact.blastColliders", "min": 1 },
    { "check": "result_equals", "path": "impact.terrainSurface", "value": "water" },
    { "check": "result_equals", "path": "impact.terrainChanged", "value": 0 },
    { "check": "result_equals", "path": "impact.nativePersistentSoot", "value": 0 },
    { "check": "result_equals", "path": "winter.active", "value": true },
    { "check": "result_equals", "path": "winter.events", "value": 1 },
    { "check": "result_equals", "path": "winter.audio", "value": true },
    { "check": "result_equals", "path": "winter.ash", "value": true },
    { "check": "result_equals", "path": "winter.tint", "value": true },
    { "check": "result_above", "path": "winter.winterBlend", "min": 0.99 },
    { "check": "result_equals", "path": "winter.snowEmitting", "value": true },
    { "check": "result_equals", "path": "clean.active", "value": false },
    { "check": "result_equals", "path": "clean.events", "value": 0 },
    { "check": "result_equals", "path": "clean.terrainRestored", "value": 0 }
  ]
}
