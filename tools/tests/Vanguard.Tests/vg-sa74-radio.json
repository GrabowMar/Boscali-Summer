{
  "name": "vg-sa74-radio",
  "description": "Recorded drop warning, four frightened impact calls, timed silence, late-state replay suppression and survivor recovery. Phase fixtures and clock tests cover the 600-second silent interval.",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 300,
  "ops": [
    {
      "op": "wait",
      "seconds": 35
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": { "step": "reset" }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "nuclearreset"
      },
      "store": "reset"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "nuclearrelease"
      },
      "store": "drop"
    },
    {
      "op": "wait",
      "seconds": 10
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "state"
      },
      "store": "warning"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "nuclear"
      },
      "store": "impact"
    },
    {
      "op": "wait",
      "seconds": 42
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "state"
      },
      "store": "panic"
    },
    {
      "op": "wait",
      "seconds": 8
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "state"
      },
      "store": "silence"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "direct"
      },
      "store": "blocked"
    },
    {
      "op": "wait",
      "seconds": 5
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "state"
      },
      "store": "stillSilent"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "nuclearlate"
      },
      "store": "lateFixture"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "state"
      },
      "store": "late"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "nuclearsurvivor"
      },
      "store": "survivorFixture"
    },
    {
      "op": "wait",
      "seconds": 32
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "state"
      },
      "store": "survivor"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "nuclearreset"
      },
      "store": "clear"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "state"
      },
      "store": "clean"
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_equals",
      "path": "warning.nuclearBlocking",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "warning.nuclearBlackout",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "warning.eventCounts.command_sa74_release",
      "value": 1
    },
    {
      "check": "result_above",
      "path": "warning.voiced",
      "min": 1
    },
    {
      "check": "result_equals",
      "path": "panic.nuclearEmergencyCalls",
      "value": 5
    },
    {
      "check": "result_equals",
      "path": "panic.eventCounts.command_sa74_flash",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "panic.eventCounts.command_sa74_ground",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "panic.eventCounts.command_sa74_wing",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "panic.eventCounts.command_sa74_last",
      "value": 1
    },
    {
      "check": "result_above",
      "path": "panic.voiced",
      "min": 5
    },
    {
      "check": "result_equals",
      "path": "silence.nuclearSilence",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "silence.sounding",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "blocked.secondAccepted",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "stillSilent.survivors",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "stillSilent.nuclearEmergencyCalls",
      "value": 5
    },
    {
      "check": "result_equals",
      "path": "late.nuclearEmergencyCalls",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "late.nuclearSilence",
      "value": true
    },
    {
      "check": "result_above",
      "path": "survivor.survivors",
      "min": 1
    },
    {
      "check": "result_equals",
      "path": "survivor.nuclearSilence",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "clean.nuclearBlocking",
      "value": false
    }
  ]
}
