{
  "name": "vg-sa74-look",
  "description": "Controlled land-burst volumetric mushroom views at explicit effect ages. Visual fixture; native carriage and impact are tested separately.",
  "mods": ["boscalisummer"],
  "timeout_s": 480,
  "ops": [
    { "op": "spawn", "id": "observer", "type": "VL-49 Tarantula", "faction": "Boscali", "at": { "map": [-24500, -17400] }, "altitude": 3000, "speed": 80, "heading": 0 },
    { "op": "observe", "follow": "observer" },
    { "op": "wait", "seconds": 5 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "detonate", "land": true }, "store": "blast" },
    { "op": "wait", "seconds": 6 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "age", "seconds": 25 }, "store": "shock" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "look", "distance": 22000, "height": 3000, "side": -6000, "aimHeight": 4000, "fov": 80 }, "store": "shockView" },
    { "op": "wait", "seconds": 2 },
    { "op": "capture", "name": "sa74n-shock-front-and-ejecta", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "age", "seconds": 75 }, "store": "growing" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "look", "distance": 16000, "height": 1000, "side": -4000, "aimHeight": 14000, "fov": 95 }, "store": "lowView" },
    { "op": "wait", "seconds": 1 },
    { "op": "capture", "name": "sa74n-mushroom-from-ground", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "age", "seconds": 230 }, "store": "mature" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "look", "distance": 80000, "height": 15000, "side": -12000, "aimHeight": 25000, "fov": 75 }, "store": "wideView" },
    { "op": "wait", "seconds": 1 },
    { "op": "capture", "name": "sa74n-volumetric-mushroom-wide", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "look", "distance": 20000, "height": 500, "side": -5000, "aimHeight": 17000, "fov": 100 }, "store": "overheadView" },
    { "op": "wait", "seconds": 1 },
    { "op": "capture", "name": "sa74n-mushroom-overhead", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "look", "distance": 5500, "height": 2600, "side": -1500, "aimHeight": 0, "fov": 70 }, "store": "craterView" },
    { "op": "wait", "seconds": 1 },
    { "op": "capture", "name": "sa74n-land-crater", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "reset" }, "store": "reset" },
    { "op": "wait", "seconds": 1 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "status" }, "store": "clean" },
    { "op": "end" }
  ],
  "checks": [
    { "check": "status_ok" },
    { "check": "result_equals", "path": "blast.events", "value": 1 },
    { "check": "result_equals", "path": "blast.nativeBlasts", "value": 1 },
    { "check": "result_above", "path": "blast.terrainChanged", "min": 1 },
    { "check": "result_equals", "path": "mature.active", "value": true },
    { "check": "result_equals", "path": "wideView.mushroomReady", "value": true },
    { "check": "result_above", "path": "wideView.mushroomFrame", "min": 1 },
    { "check": "result_above", "path": "wideView.mushroomSites", "min": 1 },
    { "check": "result_above", "path": "wideView.cloudClearanceCount", "min": 1 },
    { "check": "result_equals", "path": "wideView.particlesReady", "value": true },
    { "check": "result_above", "path": "wideView.particleSystems", "min": 6 },
    { "check": "result_above", "path": "wideView.snowParticles", "min": 1000 },
    { "check": "result_equals", "path": "clean.active", "value": false },
    { "check": "result_equals", "path": "clean.cloudClearanceCount", "value": 0 },
    { "check": "result_equals", "path": "clean.mushroomSites", "value": 0 },
    { "check": "result_equals", "path": "clean.particleSystems", "value": 0 },
    { "check": "result_equals", "path": "clean.particles", "value": 0 },
    { "check": "result_above", "path": "clean.terrainRestored", "min": 1 }
  ]
}
