{
  "name": "vg-sa74-ground",
  "description": "Native dry-ground crater collision, native textured persistent soot, cleanup, and water/high-airburst exclusions. Late ground appearance is sampled; the high-airburst capture advances ten uninterrupted native seconds.",
  "mods": ["boscalisummer"],
  "timeout_s": 240,
  "ops": [
    { "op": "spawn", "id": "observer", "type": "VL-49 Tarantula", "faction": "Boscali", "at": { "map": [-24500, -17400] }, "altitude": 3000, "speed": 80, "heading": 0 },
    { "op": "observe", "follow": "observer" },
    { "op": "wait", "seconds": 1 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "time", "hours": 12 } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "land" }, "store": "ground" },
    { "op": "wait", "seconds": 1.2 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "sample", "seconds": 1800, "distance": 2300, "height": 350, "side": -1100, "aimHeight": -150, "fov": 68 } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" } },
    { "op": "capture", "name": "ground-native-soot-crater", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "soot", "visible": false } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" } },
    { "op": "capture", "name": "ground-native-soot-off-comparison", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "soot", "visible": true } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" }, "store": "scar" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "reset" }, "store": "restored" },
    { "op": "wait", "seconds": 0.1 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" }, "store": "clean" },
    { "op": "capture", "name": "ground-terrain-restored", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "air", "height": 6000 }, "store": "air" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "look", "distance": 28000, "height": 0, "side": -7000, "aimHeight": 1500, "fov": 70 } },
    { "op": "wait", "seconds": 10 },
    { "op": "capture", "name": "airburst-10s-lateral", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" }, "store": "airLater" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "reset" } },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "water" }, "store": "water" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step", "args": { "action": "look", "distance": 26000, "height": 5000, "side": -6000, "aimHeight": 2500, "fov": 70 } },
    { "op": "wait", "seconds": 3 },
    { "op": "capture", "name": "water-surface-burst", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "reset" } },
    { "op": "wait", "seconds": 0.1 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.Sa74GroundAutomation.Step", "args": { "action": "probe" }, "store": "final" },
    { "op": "end" }
  ],
  "checks": [
    { "check": "status_ok" },
    { "check": "result_equals", "path": "ground.terrainSurface", "value": "ground" },
    { "check": "result_above", "path": "ground.terrainChanged", "min": 1 },
    { "check": "result_above", "path": "scar.nativePersistentSoot", "min": 1 },
    { "check": "result_above", "path": "scar.groundProbe.drop", "min": 180 },
    { "check": "result_below", "path": "scar.groundProbe.drop", "max": 290 },
    { "check": "result_above", "path": "scar.snowParticles", "min": 1000 },
    { "check": "result_equals", "path": "clean.active", "value": false },
    { "check": "result_equals", "path": "clean.nativePersistentSoot", "value": 0 },
    { "check": "result_above", "path": "clean.terrainRestored", "min": 1 },
    { "check": "result_below", "path": "clean.groundProbe.restoredError", "max": 0.1 },
    { "check": "result_equals", "path": "air.terrainSurface", "value": "air" },
    { "check": "result_above", "path": "air.groundClearance", "min": 5900 },
    { "check": "result_equals", "path": "air.terrainChanged", "value": 0 },
    { "check": "result_equals", "path": "air.nativePersistentSoot", "value": 0 },
    { "check": "result_below", "path": "airLater.groundProbe.restoredError", "max": 0.1 },
    { "check": "result_equals", "path": "water.terrainSurface", "value": "water" },
    { "check": "result_equals", "path": "water.terrainChanged", "value": 0 },
    { "check": "result_equals", "path": "water.nativePersistentSoot", "value": 0 },
    { "check": "result_equals", "path": "final.active", "value": false },
    { "check": "result_equals", "path": "final.snowParticles", "value": 0 }
  ]
}
