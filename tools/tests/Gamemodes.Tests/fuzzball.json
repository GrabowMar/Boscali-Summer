{
  "name": "gamemode-fuzzball", "mission": "Fuzzball", "mods": ["boscalisummer"], "timeout_s": 240,
  "description": "Native startup, zero surface units after repeated ticks, enforced module profile, visible scoreboard. Does not prove dogfight balance or multiplayer replication.",
  "ops": [
    {"op":"wait","seconds":12},
    {"op":"call","method":"BoscaliSummer.Modules.Gamemodes.Runtime.GamemodeAutomation.State","store":"first"},
    {"op":"wait","seconds":12},
    {"op":"call","method":"BoscaliSummer.Modules.Gamemodes.Runtime.GamemodeAutomation.State","store":"later"},
    {"op":"capture","name":"fuzzball-scoreboard","hide_ui":false}, {"op":"end"}
  ],
  "checks": [
    {"check":"status_ok"},
    {"check":"result_equals","path":"first.mode","value":"Fuzzball"},
    {"check":"result_equals","path":"first.canFly","value":true},
    {"check":"result_equals","path":"first.ground","value":0},
    {"check":"result_equals","path":"later.ground","value":0},
    {"check":"result_above","path":"later.air","min":1},
    {"check":"result_equals","path":"later.support","value":false},
    {"check":"log_match","pattern":"(Gamemode|Fuzzball).*Exception|Exception.*(Gamemode|Fuzzball)","max":0}
  ]
}
