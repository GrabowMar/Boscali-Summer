{
  "name": "gamemode-play-fuzzball", "mission": "Fuzzball", "mods": ["boscalisummer"], "timeout_s": 240,
  "description": "Native player airborne deployment, native attributed aircraft kill and duplicate rejection. Single host; does not establish remote replication or combat balance.",
  "ops": [
    {"op":"wait","seconds":15},
    {"op":"seat","id":"player","faction":"Boscali","altitude":2500,"speed":180},
    {"op":"call","method":"BoscaliSummer.Modules.Gamemodes.Runtime.GamemodeAutomation.AirCombat","args":{"action":"spawn_player"},"store":"spawn"},
    {"op":"wait","seconds":2},
    {"op":"call","method":"BoscaliSummer.Modules.Gamemodes.Runtime.GamemodeAutomation.AirCombat","store":"airborne"},
    {"op":"call","method":"BoscaliSummer.Modules.Gamemodes.Runtime.GamemodeAutomation.AirCombat","args":{"action":"fixture"},"store":"fixture"},
    {"op":"wait","seconds":2},
    {"op":"call","method":"BoscaliSummer.Modules.Gamemodes.Runtime.GamemodeAutomation.AirCombat","args":{"action":"credit"},"store":"credit"},
    {"op":"call","method":"BoscaliSummer.Modules.Gamemodes.Runtime.GamemodeAutomation.AirCombat","args":{"action":"repeat"},"store":"repeat"},
    {"op":"wait","seconds":2},
    {"op":"call","method":"BoscaliSummer.Modules.Gamemodes.Runtime.GamemodeAutomation.AirCombat","store":"final"},
    {"op":"capture","name":"fuzzball-airborne-score","hide_ui":false}, {"op":"end"}
  ],
  "checks": [
    {"check":"status_ok"},
    {"check":"result_equals","path":"spawn.allowed","value":true},
    {"check":"result_equals","path":"airborne.playerAirborne","value":true},
    {"check":"result_equals","path":"credit.creditedOne","value":true},
    {"check":"result_equals","path":"credit.disabled","value":true},
    {"check":"result_equals","path":"repeat.unchanged","value":true},
    {"check":"result_equals","path":"final.surface","value":0},
    {"check":"result_above","path":"final.score0","min":1},
    {"check":"log_match","pattern":"(Gamemode|Fuzzball).*Exception|Exception.*(Gamemode|Fuzzball)","max":0}
  ]
}
