{
  "name": "gamemode-warbox-archipelago",
  "mission": "WarBox Archipelago",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 300,
  "description": "WarBox built from Terminal Control on the Ignus Archipelago starts as a WarBox with ground forces.",
  "ops": [
    {
      "op": "wait",
      "seconds": 20
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Gamemodes.Runtime.GamemodeAutomation.State",
      "store": "state"
    },
    {
      "op": "capture",
      "name": "warbox-archipelago-brief",
      "hide_ui": false
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_equals",
      "path": "state.mode",
      "value": "WarBox"
    },
    {
      "check": "result_equals",
      "path": "state.dynamicOperations",
      "value": true
    },
    {
      "check": "result_above",
      "path": "state.ground",
      "min": 1
    },
    {
      "check": "log_match",
      "pattern": "(Gamemode|WarBox).*Exception|Exception.*(Gamemode|WarBox)",
      "max": 0
    }
  ]
}
