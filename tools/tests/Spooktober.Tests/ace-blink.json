{
  "name": "spooktober-ace-blink",
  "mods": ["boscalisummer"],
  "timeout_s": 180,
  "ops": [
    { "op": "seat", "id": "player", "faction": "Boscali", "aircraft": "FS-20 Vortex", "near": [50000, 0], "altitude": 5000, "speed": 220, "heading": 90 },
    { "op": "wait", "seconds": 2 },
    { "op": "call", "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step", "args": { "action": "reset" } },
    { "op": "call", "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step", "args": { "action": "spawn", "boss": "FallenAce" }, "store": "spawn" },
    { "op": "wait", "seconds": 1 },
    { "op": "call", "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step", "args": { "action": "ace_hurt", "how": "hull" } },
    { "op": "wait", "seconds": 2 },
    { "op": "call", "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step", "args": { "action": "ace_status" }, "store": "after" },
    { "op": "call", "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step", "args": { "action": "reset" } },
    { "op": "end" }
  ],
  "checks": [
    { "check": "status_ok" },
    { "check": "result_equals", "path": "spawn.message", "value": "FALLEN ACE INBOUND" },
    { "check": "result_equals", "path": "after.alive", "value": true },
    { "check": "result_equals", "path": "after.disabled", "value": false },
    { "check": "result_equals", "path": "after.name", "value": "FALLEN ACE" },
    { "check": "result_equals", "path": "after.lives", "value": 3 },
    { "check": "result_above", "path": "after.blinks", "min": 1 },
    { "check": "result_equals", "path": "after.detached_parts", "value": 0 },
    { "check": "result_above", "path": "after.pilot_hp", "min": 99 }
  ]
}
