{
  "name": "spooktober-hell-dimension",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 240,
  "environment": {
    "config": {
      "mod:com.marci.boscalisummer": {
        "Command": {
          "MapRelief3D": false
        }
      }
    }
  },
  "ops": [
    {
      "op": "wait",
      "seconds": 5
    },
    {
      "op": "seat",
      "id": "player",
      "faction": "Boscali",
      "aircraft": "FS-20 Vortex",
      "near": [
        15000,
        -14000
      ],
      "altitude": 3000,
      "speed": 200,
      "heading": 0
    },
    {
      "op": "atmosphere",
      "time_of_day": 12,
      "conditions": 0.1,
      "cloud_height": 10000,
      "wind_speed": 2,
      "wind_turbulence": 0,
      "wind_heading": 90,
      "moon_phase": 14
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "reset"
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "spawn",
        "boss": "HellsArmy"
      },
      "store": "spawned"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "hell_flight_dive"
      },
      "store": "diving"
    },
    {
      "op": "wait",
      "seconds": 0.9
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "hell_status"
      },
      "store": "entered"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "look",
        "at": "anchor",
        "distance": 950,
        "height": 350,
        "bearing": 40,
        "fov": 65
      }
    },
    {
      "op": "wait",
      "seconds": 0.5
    },
    {
      "op": "capture",
      "name": "hell-dimension-soot",
      "hide_ui": true
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "hell_hurt_anchor"
      }
    },
    {
      "op": "wait",
      "seconds": 0.3
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "hell_status"
      },
      "store": "one"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "hell_retreat"
      }
    },
    {
      "op": "wait",
      "seconds": 0.3
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "hell_status"
      },
      "store": "retreated"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "look",
        "at": "portal",
        "distance": 1200,
        "height": 600,
        "bearing": 30,
        "fov": 65
      }
    },
    {
      "op": "wait",
      "seconds": 0.5
    },
    {
      "op": "capture",
      "name": "restored-world-clouds",
      "hide_ui": true
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "hell_enter"
      }
    },
    {
      "op": "wait",
      "seconds": 0.3
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "hell_hurt_anchor"
      }
    },
    {
      "op": "wait",
      "seconds": 0.3
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "hell_hurt_anchor"
      }
    },
    {
      "op": "wait",
      "seconds": 0.5
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "hell_status"
      },
      "store": "won"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "reset"
      },
      "store": "cleanup"
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_equals",
      "path": "entered.inside_hell",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "entered.anchors_remaining",
      "value": 3
    },
    {
      "check": "result_equals",
      "path": "entered.defeated",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "one.anchors_broken",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "retreated.gate_open",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "retreated.inside_hell",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "won.defeated",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "won.gate_open",
