{
  "name": "ops-compounds-prewarm",
  "mission": "Escalation",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 600,
  "environment": {
    "config": {
      "com.marci.boscalisummer": {
        "Mission": {
          "AskAtStart": false
        },
        "Debug": {
          "BypassRequirements": true,
          "DisableOpsCooldowns": true
        }
      }
    }
  },
  "ops": [
    {
      "method": "BoscaliSummer.Modules.Support.Visuals.OpsCompoundVisuals.Probe",
      "args": {},
      "op": "call",
      "store": "startup"
    },
    {
      "op": "seat",
      "id": "player",
      "altitude": 1500,
      "speed": 180,
      "heading": 0
    },
    {
      "op": "wait",
      "seconds": 20
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb",
      "store": "sync",
      "args": {
        "verb": "sync"
      }
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb",
      "store": "q_pad",
      "args": {
        "verb": "queue",
        "front": 0,
        "programme": 2
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb",
      "store": "q_dc",
      "args": {
        "verb": "queue",
        "front": 1,
        "programme": 4
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb",
      "store": "q_camp",
      "args": {
        "verb": "queue",
        "front": 2,
        "programme": 8
      }
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb",
      "store": "d_pad",
      "args": {
        "verb": "donate",
        "front": 0,
        "programme": 2,
        "amount": 400
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb",
      "store": "d_dc",
      "args": {
        "verb": "donate",
        "front": 1,
        "programme": 4,
        "amount": 400
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb",
      "store": "d_camp",
      "args": {
        "verb": "donate",
        "front": 2,
        "programme": 8,
        "amount": 400
      }
    },
    {
      "op": "wait",
      "seconds": 60
    },
    {
      "op": "wait",
      "seconds": 60
    },
    {
      "op": "wait",
      "seconds": 40
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Visuals.OpsCompoundVisuals.Probe",
      "store": "dressed",
      "args": {}
    },
    {
      "op": "end"
    }
  ],
  "description": "Cold mission verifies all five compound meshes were prepared before play and live anchors reuse them without an in-mission build.",
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "value": 5,
      "path": "startup.cachedModels",
      "check": "result_equals"
    },
    {
      "value": 5,
      "path": "startup.prewarmedModels",
      "check": "result_equals"
    },
    {
      "value": 0,
      "path": "startup.missionBuiltModels",
      "check": "result_equals"
    },
    {
      "min": 3,
      "path": "dressed.count",
      "check": "result_above"
    },
    {
      "value": 5,
      "path": "dressed.cachedModels",
      "check": "result_equals"
    },
    {
      "value": 0,
      "path": "dressed.missionBuiltModels",
      "check": "result_equals"
    },
    {
      "check": "log_clean",
      "sources": [
        "Boscali Summer"
      ]
    },
    {
      "pattern": "Unexpected message.*BoscaliSummer",
      "max": 0,
      "check": "log_match"
    }
  ]
}
