{
  "name": "ops-satellite-launch-regression",
  "mission": "Escalation",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 1200,
  "_note": "Hosted support regression: real pad and satellite funding/completion, launch bits, and duplicate refusal. Records a high-altitude pilot; survival during this active combat mission is not a launch-system criterion. Ends after the state checks, without the optional spectator/plume demonstrations. No multiplayer assertion.",
  "environment": {
    "config": {
      "com.marci.boscalisummer": {
        "Mission": {
          "AskAtStart": false
        },
        "Debug": {
          "BypassRequirements": true
        },
        "Support": {
          "FrontSeed": 0,
          "FrontShare": 0,
          "FrontShareCap": 0,
          "ProgrammeCostScale": 1
        }
      }
    },
    "resolution": [
      960,
      540
    ]
  },
  "ops": [
    {
      "op": "seat",
      "id": "player",
      "altitude": 6000,
      "speed": 230,
      "heading": 0
    },
    {
      "hz": 1,
      "ids": [
        "player"
      ],
      "op": "record"
    },
    {
      "program": [
        {
          "orbit": {
            "bank": 20,
            "seconds": 1200
          }
        }
      ],
      "op": "fly",
      "id": "player"
    },
    {
      "op": "wait",
      "seconds": 20
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb",
      "args": {
        "verb": "sync"
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Window",
      "args": {
        "front": 0
      }
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb",
      "args": {
        "verb": "queue",
        "front": 0,
        "programme": 2,
        "bearing": 180,
        "metres": 1500
      },
      "store": "queuePad"
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb",
      "args": {
        "verb": "donate",
        "front": 0,
        "programme": 2,
        "amount": 400
      },
      "store": "fundPad"
    },
    {
      "op": "wait",
      "seconds": 130
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.SoloRead",
      "args": {},
      "store": "padBuilt"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb",
      "args": {
        "verb": "queue",
        "front": 0,
        "programme": 1,
        "kind": 0
      },
      "store": "queueBird"
    },
    {
      "op": "wait",
      "seconds": 12
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb",
      "args": {
        "verb": "donate",
        "front": 0,
        "programme": 1,
        "amount": 400
      },
      "store": "fundBird"
    },
    {
      "op": "wait",
      "seconds": 12
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.SoloRead",
      "args": {},
      "store": "funded"
    },
    {
      "op": "wait_until",
      "path": "BoscaliSummer.Modules.Support.Runtime.SupportManager.Active.OpsMirror.State.BirdsLaunched",
      "eq": 1,
      "timeout_s": 110
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.SoloRead",
      "args": {},
      "store": "launched"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb",
      "args": {
        "verb": "queue",
        "front": 0,
        "programme": 1,
        "kind": 0
      },
      "store": "duplicate"
    },
    {
      "op": "wait",
      "seconds": 12
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.SoloRead",
      "args": {},
      "store": "refused"
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_above",
      "path": "queuePad.request",
      "min": 0.5
    },
    {
      "check": "result_above",
      "path": "fundPad.request",
      "min": 0.5
    },
    {
      "check": "result_above",
      "path": "queueBird.request",
      "min": 0.5
    },
    {
      "check": "result_above",
      "path": "fundBird.request",
      "min": 0.5
    },
    {
      "check": "result_above",
      "path": "duplicate.request",
      "min": 0.5
    },
    {
      "check": "result_equals",
      "path": "padBuilt.ownPads",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "padBuilt.ownBirdsUp",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "funded.lastOutcome",
      "value": 3
    },
    {
      "check": "result_equals",
      "path": "funded.front0Queue",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "funded.front0Pct",
      "value": 100
    },
    {
      "check": "result_equals",
      "path": "launched.ownBirdsUp",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "launched.ownBirdsLaunched",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "refused.lastOutcome",
      "value": 40
    },
    {
      "check": "result_equals",
      "path": "refused.front0Queue",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "refused.ownBirdsUp",
      "value": 1
    },
    {
      "check": "log_clean"
    },
    {
      "check": "log_match",
      "pattern": "\\[Support\\.(Space|Fronts)\\].*(Tick failed|tick failed|effect failed|effect threw)",
      "max": 0
    }
  ]
}
