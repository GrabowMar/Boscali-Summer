{
  "name": "missile-water-impact",
  "description": "Hosted native armed-missile water collision regression. The proof calls actual DetectCollisions on three disposable network-spawned missiles, after native initialization. The unpatched armed-water branch emits one kinematic velocity warning with its native stack; unarmed-water and armed-air controls remain dynamic. Strict zero-warning expectation deliberately fails before the native call-site guard. Does not alter quality, time scale, physics settings or a global Rigidbody setter.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "timeout_s": 180,
  "ops": [
    {"op": "seat", "id": "player", "faction": "Boscali", "aircraft": "FS-20 Vortex", "altitude": 3000, "speed": 220, "heading": 0},
    {"op": "call", "method": "BoscaliSummer.Modules.CombatAdjust.Runtime.MissileWaterProof.Step", "args": {"action": "spawn"}, "store": "spawn"},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.CombatAdjust.Runtime.MissileWaterProof.Step", "args": {"action": "impact"}, "store": "impact"},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.CombatAdjust.Runtime.MissileWaterProof.Step", "args": {"action": "cleanup"}, "store": "cleanup"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "result_equals", "path": "spawn.count", "value": 3},
    {"check": "result_equals", "path": "impact.armedWater.wasArmed", "value": true},
    {"check": "result_equals", "path": "impact.armedWater.serverAfter", "value": true},
    {"check": "result_equals", "path": "impact.armedWater.disabled", "value": true},
    {"check": "result_equals", "path": "impact.armedWater.kinematic", "value": true},
    {"check": "result_equals", "path": "impact.armedWater.detonated", "value": true},
    {"check": "result_equals", "path": "impact.armedWater.disabledEvents", "value": 1},
    {"check": "result_equals", "path": "impact.armedWater.kinematicWarnings", "value": 0},
    {"check": "result_equals", "path": "impact.unarmedWater.disabled", "value": false},
    {"check": "result_equals", "path": "impact.unarmedWater.kinematic", "value": false},
    {"check": "result_equals", "path": "impact.unarmedWater.detonated", "value": false},
    {"check": "result_equals", "path": "impact.unarmedWater.kinematicWarnings", "value": 0},
    {"check": "result_equals", "path": "impact.armedAir.disabled", "value": false},
    {"check": "result_equals", "path": "impact.armedAir.kinematic", "value": false},
    {"check": "result_equals", "path": "impact.armedAir.detonated", "value": false},
    {"check": "result_equals", "path": "impact.armedAir.kinematicWarnings", "value": 0},
    {"check": "result_equals", "path": "cleanup.remaining", "value": 0},
    {"check": "log_match", "pattern": "Exception", "max": 0}
  ]
}
