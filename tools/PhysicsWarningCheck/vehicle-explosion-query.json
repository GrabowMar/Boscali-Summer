{
  "name": "vehicle-explosion-query",
  "description": "Actual native-engine production ImpactFireManager query over a disposable nonconvex MapBuilding, after a running mission and positive mission clock are observed. Strict zero-unsupported-warning criterion is expected to fail on the unfixed production path. Temporary cooldown prevents ignition; all objects, cache entries and listeners are restored. Native fallback loading is allowed; its startup message alone is not a failure.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "timeout_s": 300,
  "environment": { "config": { "bepinex": { "Logging.Disk": { "WriteUnityLog": true } } } },
  "ops": [
    { "op": "wait_until", "path": "MissionManager.IsRunning", "eq": true, "timeout_s": 30, "store": "missionRunning" },
    { "op": "wait", "seconds": 1 },
    { "op": "read", "path": "NetworkSceneSingleton<MissionManager>.i.MissionTime", "store": "missionTime" },
    { "op": "call", "method": "BoscaliSummer.Core.Diagnostics.PhysicsWarningProbe.Install", "args": {}, "store": "started" },
    { "op": "call", "method": "BoscaliSummer.Fire.VehicleExplosionProof.Run", "args": {}, "store": "vehicle" },
    { "op": "call", "method": "BoscaliSummer.Core.Diagnostics.PhysicsWarningProbe.Read", "args": {}, "store": "trace" },
    { "op": "call", "method": "BoscaliSummer.Core.Diagnostics.PhysicsWarningProbe.Stop", "args": {}, "store": "stopped" },
    { "op": "end" }
  ],
  "checks": [
    { "check": "status_ok" },
    { "check": "result_equals", "path": "started.installed", "value": true },
    { "check": "result_equals", "path": "vehicle.ok", "value": true },
    { "check": "result_equals", "path": "vehicle.visitedFixture", "value": true },
    { "check": "result_equals", "path": "vehicle.colliderNonconvex", "value": true },
    { "check": "result_equals", "path": "vehicle.firesUnchanged", "value": true },
    { "check": "result_equals", "path": "vehicle.cooldownRestored", "value": true },
    { "check": "result_below", "path": "vehicle.unsupportedWarnings", "max": 0 },
    { "check": "result_equals", "path": "stopped.installed", "value": false },
    { "check": "log_match", "pattern": "[A-Za-z][A-Za-z0-9_.]*Exception:", "max": 0 },
    { "check": "result_equals", "path": "missionRunning", "value": true },
    { "check": "result_above", "path": "missionTime", "min": 0.001 }
  ]
}
