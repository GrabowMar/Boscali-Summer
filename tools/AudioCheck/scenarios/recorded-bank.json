      "path": "loop_start.loop",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "loop_running.playing",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "loop_running.id",
      "value": "cockpit-wind"
    },
    {
      "check": "result_equals",
      "path": "loop_running.fxLoops",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "loop_running.effectsMixer",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "zero.playing",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "zero.gain",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "zero.loop",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "zero.fxLoops",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "loop_restart.accepted",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "muted.playing",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "muted.gain",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "muted.loop",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "muted.fxLoops",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "muted_start.accepted",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "muted_start.playing",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "muted_start.fxLoops",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "zero_start.accepted",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "zero_start.playing",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "zero_start.fxLoops",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "clean.playing",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "clean.fxLoops",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "clean.fxShots",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "clean.audioCachedClips",
      "value": 119
    },
    {
      "check": "result_equals",
      "path": "clean.audioFailed",
      "value": 0
    },
    {
      "check": "log_match",
      "pattern": "Exception",
      "max": 0
    },
    {
      "check": "result_equals",
      "path": "thunder_0.accepted",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "thunder_0.id",
      "value": "weather-thunder-0"
    },
    {
      "check": "result_equals",
      "path": "thunder_0.newDecodes",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "thunder_0_sounding.playing",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "thunder_0_sounding.interfaceMixer",
      "value": true
    },
    {
      "check": "result_above",
      "path": "thunder_0_sounding.seconds",
      "min": 3
    },
    {
      "check": "result_equals",
      "path": "thunder_1.accepted",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "thunder_1.id",
      "value": "weather-thunder-1"
    },
    {
      "check": "result_equals",
      "path": "thunder_1.newDecodes",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "thunder_1_sounding.playing",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "thunder_1_sounding.interfaceMixer",
      "value": true
    },
    {
      "check": "result_above",
      "path": "thunder_1_sounding.seconds",
      "min": 3
    },
    {
      "check": "result_equals",
      "path": "thunder_stopped.playing",
      "value": false
    }
  ]
}
