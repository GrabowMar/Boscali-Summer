    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step",
      "args": {
        "action": "detonate",
        "x": 200000,
        "z": 200000,
        "y": 10
      },
      "store": "detonated"
    },
    {
