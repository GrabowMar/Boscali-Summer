    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step",
      "args": {
        "action": "status"
      },
      "store": "tail"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step",
      "args": {
        "action": "reset"
      }
    },
    {
      "op": "wait",
      "seconds": 0.1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step",
      "args": {
