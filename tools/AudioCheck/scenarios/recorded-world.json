{
  "name": "recorded-world-audio",
  "description": "Production pilot and weather recorded effects, view transition ownership, and one physically delayed SA-74N pressure arrival.",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 210,
  "timescale": 1,
  "environment": {
    "config": {
      "bepinex": {
        "Logging.Disk": {
          "WriteUnityLog": true
        }
      },
      "com.marci.boscalisummer": {
        "Mission": {
          "AskAtStart": false
        },
        "Weather": {
          "Enabled": true,
          "RainAudioEnabled": true,
          "LightningEnabled": false
        },
        "Immersion": {
          "Enabled": true,
          "PilotBreathingEnabled": true,
          "WindAudioEnabled": true
        }
      }
    }
  },
  "_note": "Uses the real PilotPhysiology breath clock, rain presenter and SA-74N Detonate/ApplySite pipeline, without directly playing their clips through a generic probe. Readouts identify actual accepted pilot sound IDs and native source clip names/mixer groups. The nuke is placed far from the local aircraft and observed from 4 km; no age scrubbing is used. It asserts one delayed arrival and a sounding tail, then explicit source/queue cleanup. Does not validate artillery/LANCE triggers, native nuclear damage coverage, subjective sound quality, FPS or multiplayer. Manual fallout reset stops voices but a short remaining global one-shot reservation can persist until its duration or real scene reset. Before the actual detonation, six effectively inaudible requests (volume 0.0001) reserve the ordinary one-shot budget for the long blast recording; each replaces the one probe source, so these do not form an audible wall. A normal UI request must be refused both before and during the real nuclear arrival. The SA-74N dedicated three-source pool must still sound exactly once while those ordinary reservations are full. The jet starts at 220 m/s and the rain readout must show the high-speed canopy brightness (cutoff at least 4800 Hz), with the speed-conditioned filter and gain bounded at 5300 Hz and 0.59. Source inspection confirms the real aircraft speed reaches the rain math, which deliberately keeps rain pitch unchanged and caps the response at 250 m/s. Natural storm timing is not tested; the separate bank scenario checks both thunder recordings sounding through its generic source. ForceWeather(follow=player) calls SetFollowingUnit, which can select orbit view; the fixture explicitly restores cockpit after each weather override before any pilot/rain assertion. The final nuclear listener uses the existing free-camera View hook and Sa74FalloutAutomation.look, without attempting spectator join while the local player already owns a faction.",
  "ops": [
    {
      "op": "seat",
      "id": "player",
      "aircraft": "FS-20 Vortex",
      "near": [
        0,
        130000
      ],
      "altitude": 3000,
      "speed": 220,
      "heading": 0,
      "view": "cockpit",
      "timeout": 30
    },
    {
      "op": "fly",
      "id": "player",
      "program": [
        {
          "level": 300
        }
      ]
    },
    {
      "op": "wait",
      "seconds": 5
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": {
        "action": "stop",
        "receive": false
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Core.Diagnostics.AudioAutomation.Step",
      "args": {
        "action": "stop"
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.SetEnabled",
      "args": {
        "enabled": true
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Configure",
      "args": {
        "breathing": true
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.ForceWeather",
      "args": {
        "conditions": 0.1,
        "cloudHeight": 6000,
        "rain": 0,
        "follow": "player"
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.View",
      "args": {
        "view": "cockpit"
      }
    },
    {
      "op": "wait",
      "seconds": 7
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout",
      "args": {},
      "store": "pilot"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.AudioCensus",
      "args": {
        "mod": true
      },
      "store": "pilot_sources"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.ForceWeather",
      "args": {
        "conditions": 0.92,
        "cloudHeight": 4500,
        "rain": 1,
        "regime": "RainSquall",
        "seed": 91,
        "follow": "player"
      },
      "store": "rain_forced"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.View",
      "args": {
        "view": "cockpit"
      }
    },
    {
      "op": "wait",
      "seconds": 20
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout",
      "args": {},
      "store": "rain_cockpit"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.View",
      "args": {
        "view": "orbit",
        "follow": "player"
      }
    },
    {
      "op": "wait",
      "seconds": 3
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout",
      "args": {},
      "store": "rain_exterior"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.View",
      "args": {
        "view": "cockpit",
        "follow": "player"
      }
    },
    {
      "op": "wait",
      "seconds": 3
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout",
      "args": {},
      "store": "rain_return"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.SetEnabled",
      "args": {
        "enabled": false
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.ForceWeather",
      "args": {
        "conditions": 0.1,
        "cloudHeight": 6000,
        "rain": 0,
        "follow": "player"
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.View",
      "args": {
        "view": "cockpit"
      }
    },
    {
      "op": "wait",
      "seconds": 3
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout",
      "args": {},
      "store": "rain_dry"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Core.Diagnostics.AudioAutomation.Step",
      "args": {
        "action": "state"
      },
      "store": "world_released"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.View",
      "args": {
        "view": "free"
      },
      "store": "free_camera"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step",
      "args": {
        "action": "reset"
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Core.Diagnostics.AudioAutomation.Step",
      "args": {
        "action": "play",
        "id": "sa74-blast",
        "volume": 0.0001
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Core.Diagnostics.AudioAutomation.Step",
      "args": {
        "action": "play",
        "id": "sa74-blast",
        "volume": 0.0001
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Core.Diagnostics.AudioAutomation.Step",
      "args": {
        "action": "play",
        "id": "sa74-blast",
        "volume": 0.0001
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Core.Diagnostics.AudioAutomation.Step",
      "args": {
        "action": "play",
        "id": "sa74-blast",
        "volume": 0.0001
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Core.Diagnostics.AudioAutomation.Step",
      "args": {
        "action": "play",
        "id": "sa74-blast",
        "volume": 0.0001
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Core.Diagnostics.AudioAutomation.Step",
      "args": {
        "action": "play",
        "id": "sa74-blast",
        "volume": 0.0001
      }
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Core.Diagnostics.AudioAutomation.Step",
