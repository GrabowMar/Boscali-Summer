        "action": "look",
        "distance": 4000,
        "height": 500,
        "side": 0,
        "aimHeight": 2200,
        "fov": 90
      }
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step",
      "args": {
        "action": "status"
      },
      "store": "before"
    },
    {
      "op": "wait",
      "seconds": 7
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step",
      "args": {
