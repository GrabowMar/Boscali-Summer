{
  "name": "battlefield-radio",
  "description": "Rendered acceptance of cold voice loading, protected battlefield traffic, cooldowns, military mute and music ducking.",
  "mods": ["boscalisummer"],
  "timeout_s": 360,
  "timescale": 1,
  "_note": "Synthetic publishers use the production director, audio bank and real Update clock. A cold base report must wait for all 360 clips, then five required messages survive a 32-offer ambient burst. Native capture/kill trigger semantics, subjective listening, FPS and multiplayer are outside this scenario. Run using this explicit path; the kit may have older scenarios with the same short name.",
  "environment": {"config": {"bepinex": {"Logging.Disk": {"WriteUnityLog": true}}}},
  "ops": [
    {"op": "seat", "id": "player", "aircraft": "FS-20 Vortex", "near": [0, 130000], "altitude": 3000, "speed": 220, "heading": 0, "view": "cockpit", "timeout": 30},
    {"op": "fly", "id": "player", "program": [{"level": 300}]},
    {"op": "wait", "seconds": 5},
    {"op": "call", "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step", "args": {"station": "base-broadcast", "receive": true, "music_volume": 0.5, "military_volume": 0.75}, "store": "music_start"},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "cold"}, "store": "cold"},
    {"op": "wait", "seconds": 25},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "state"}, "store": "ready"},
    {"op": "call", "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step", "args": {"action": "state", "faction": "Boscali"}, "store": "base_boscali"},
    {"op": "call", "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step", "args": {"action": "state", "faction": "Primeva"}, "store": "base_pala"},
    {"op": "call", "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step", "args": {"action": "state", "faction": "PMC"}, "store": "base_pmc"},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "burst"}, "store": "burst"},
    {"op": "wait", "seconds": 1},
    {"op": "capture", "name": "priority-transmission"},
    {"op": "wait", "seconds": 49},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "state"}, "store": "burst_done"},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "reset"}, "store": "isolated"},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "ship"}, "store": "ship_first"},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "state"}, "store": "ship_voice"},
    {"op": "call", "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step", "args": {"action": "state"}, "store": "ducked"},
    {"op": "call", "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step", "args": {"action": "state", "receive": false}, "store": "mute_requested"},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "state"}, "store": "muted"},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "bases"}, "store": "muted_offers"},
    {"op": "call", "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step", "args": {"action": "state"}, "store": "released"},
    {"op": "call", "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step", "args": {"action": "stop", "receive": true}, "store": "music_stopped"},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "state"}, "store": "resumed"},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "aircraft"}, "store": "air_first"},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "state"}, "store": "air_voice"},
    {"op": "wait", "seconds": 6},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "event"}, "store": "event_first"},
    {"op": "wait", "seconds": 9},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "insertion"}, "store": "insertion"},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "state"}, "store": "drop_voice"},
    {"op": "wait", "seconds": 7},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "aircraft"}, "store": "air_ready"},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "ship"}, "store": "ship_blocked"},
    {"op": "wait", "seconds": 15},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "ship"}, "store": "ship_ready"},
    {"op": "wait", "seconds": 8},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "event"}, "store": "event_blocked"},
    {"op": "wait", "seconds": 22},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "event"}, "store": "event_ready"},
    {"op": "wait", "seconds": 9},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance", "args": {"step": "state"}, "store": "final"},
    {"op": "call", "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Read", "args": {}, "store": "catalog"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "result_equals", "path": "cold.accepted", "value": 1},
    {"check": "result_equals", "path": "cold.loading", "value": true},
    {"check": "result_equals", "path": "cold.aired", "value": 0},
    {"check": "result_equals", "path": "cold.pending", "value": 1},
    {"check": "result_equals", "path": "ready.loading", "value": false},
    {"check": "result_equals", "path": "ready.clips", "value": 360},
    {"check": "result_equals", "path": "ready.builtInPacks", "value": 9},
    {"check": "result_above", "path": "ready.voiced", "min": 1},
    {"check": "result_above", "path": "ready.eventCounts.command_baselost", "min": 1},
    {"check": "result_equals", "path": "base_boscali.set", "value": "bb-pmc"},
    {"check": "result_equals", "path": "base_pala.set", "value": "bb-pmc"},
    {"check": "result_equals", "path": "base_pmc.set", "value": "bb-pmc"},
    {"check": "result_equals", "path": "burst.accepted", "value": 5},
    {"check": "result_above", "path": "burst_done.dropped", "min": 24},
    {"check": "result_equals", "path": "burst_done.eventCounts.command_superevent", "value": 2},
    {"check": "result_equals", "path": "burst_done.eventCounts.command_baselost", "value": 1},
    {"check": "result_equals", "path": "burst_done.eventCounts.command_basetaken", "value": 1},
    {"check": "result_equals", "path": "burst_done.eventCounts.command_enemybase", "value": 1},
    {"check": "result_equals", "path": "ship_first.accepted", "value": 1},
    {"check": "result_equals", "path": "ship_first.secondAccepted", "value": false},
    {"check": "result_equals", "path": "ship_voice.sounding", "value": true},
    {"check": "result_equals", "path": "ducked.duck_active", "value": true},
    {"check": "result_equals", "path": "ducked.music_volume", "value": 0.5},
    {"check": "result_equals", "path": "muted.receiving", "value": false},
    {"check": "result_equals", "path": "muted.sounding", "value": false},
    {"check": "result_equals", "path": "muted.fxSounding", "value": false},
    {"check": "result_equals", "path": "muted.pending", "value": 0},
    {"check": "result_equals", "path": "muted_offers.accepted", "value": 0},
    {"check": "result_equals", "path": "released.duck_active", "value": false},
    {"check": "result_equals", "path": "released.duck_gain", "value": 1},
    {"check": "result_equals", "path": "released.music_volume", "value": 0.5},
    {"check": "result_equals", "path": "music_stopped.source_playing", "value": false},
    {"check": "result_equals", "path": "music_stopped.receive_military", "value": true},
    {"check": "result_equals", "path": "resumed.pending", "value": 0},
    {"check": "result_equals", "path": "resumed.sounding", "value": false},
    {"check": "result_equals", "path": "air_first.accepted", "value": 1},
    {"check": "result_equals", "path": "air_first.secondAccepted", "value": false},
    {"check": "result_equals", "path": "air_voice.sounding", "value": true},
    {"check": "result_equals", "path": "event_first.accepted", "value": 1},
    {"check": "result_equals", "path": "event_first.secondAccepted", "value": false},
    {"check": "result_equals", "path": "insertion.accepted", "value": 1},
    {"check": "result_equals", "path": "drop_voice.sounding", "value": true},
    {"check": "result_equals", "path": "air_ready.accepted", "value": 1},
    {"check": "result_equals", "path": "ship_blocked.accepted", "value": 0},
    {"check": "result_equals", "path": "ship_ready.accepted", "value": 1},
    {"check": "result_equals", "path": "event_blocked.accepted", "value": 0},
    {"check": "result_equals", "path": "event_ready.accepted", "value": 1},
    {"check": "result_above", "path": "final.characterCounts.captain", "min": 2},
    {"check": "result_above", "path": "final.characterCounts.paratrooper", "min": 1},
    {"check": "result_above", "path": "final.characterCounts.skywatch", "min": 2},
    {"check": "result_equals", "path": "catalog.packErrors", "value": 0},
    {"check": "result_equals", "path": "catalog.unknown", "value": 0},
    {"check": "log_match", "pattern": "Exception", "max": 0}
  ]
}
