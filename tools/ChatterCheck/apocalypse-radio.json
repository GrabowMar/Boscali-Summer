{
  "name": "apocalypse-radio",
  "description": "Actual SA-74N detonation starts emergency calls and ends normal programming; an explicit aged-radio fixture then checks static and survivor routing until mission reset.",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 360,
  "timescale": 1,
  "_note": "Calls the actual host fallout Detonate/ApplySite pipeline at a distant safe point; it does not establish cargo release, native damage propagation timing, multiplayer, subjective acting approval or FPS. It uses real radio/chatter audio outputs. The station-only case tunes a new station and waits beyond the 7.85-second placeholder while military receive is off.",
  "environment": {
    "config": {
      "bepinex": {
        "Logging.Disk": {
          "WriteUnityLog": true
        }
      }
    }
  },
  "ops": [
    {
      "op": "seat",
      "id": "player",
      "aircraft": "FS-20 Vortex",
      "near": [
        0,
        130000
      ],
      "altitude": 3000,
      "speed": 220,
      "heading": 0,
      "view": "cockpit",
      "timeout": 30
    },
    {
      "op": "fly",
      "id": "player",
      "program": [
        {
          "level": 300
        }
      ]
    },
    {
      "op": "wait_until",
      "path": "BoscaliSummer.Modules.Chatter.Runtime.ChatterHost.Instance.Voices.Loading",
      "eq": false,
      "timeout_s": 60
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step",
      "args": {
        "action": "reset"
      },
      "store": "owner_reset"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "reset"
      },
      "store": "clean"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": {
        "station": "agrapol-fm",
        "receive": true,
        "military_volume": 0.75,
        "music_volume": 0.5
      },
      "store": "station"
    },
    {
      "op": "wait_until",
      "path": "BoscaliSummer.Modules.Radio.Runtime.RadioManager.active.receiver.IsPlaying",
      "eq": true,
      "timeout_s": 10
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "bases"
      },
      "store": "before_blast"
    },
    {
      "op": "wait",
      "seconds": 0.25
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step",
      "args": {
        "action": "detonate",
        "x": 200000,
        "z": 200000,
        "y": 10
      },
      "store": "detonated"
    },
    {
      "op": "wait",
      "seconds": 0.5
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "state"
      },
      "store": "silenced"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "bases"
      },
      "store": "blocked"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": { "step": "direct" },
      "store": "direct_blocked"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": {
        "action": "state"
      },
      "store": "blackout"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": { "step": "nuclearsurvivor" },
      "store": "aged_survivor_phase"
    },
    {
      "op": "wait_until",
      "path": "BoscaliSummer.Modules.Chatter.Runtime.ChatterHost.Instance.Voices.Sounding",
      "eq": true,
      "timeout_s": 40
    },
    {
      "op": "wait",
      "seconds": 0.2
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "state"
      },
      "store": "survivor1"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": {
        "action": "state"
      },
      "store": "survivor_duck"
    },
    {
      "op": "capture",
      "name": "apocalypse-survivor"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": { "action": "state", "military_volume": 0 },
      "store": "midline_zero_request"
    },
    { "op": "wait", "seconds": 0.5 },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": { "action": "state" },
      "store": "midline_zero"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": { "action": "state", "military_volume": 0.75 },
      "store": "midline_restored"
    },
    {
      "op": "wait_until",
      "path": "BoscaliSummer.Modules.Chatter.Runtime.ChatterHost.Instance.Voices.Sounding",
      "eq": false,
      "timeout_s": 12
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": {
        "station": "maris-network",
        "receive": false
      },
      "store": "station_only_start"
    },
    {
      "op": "wait",
      "seconds": 11
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": {
        "action": "state"
      },
      "store": "station_only"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": {
        "action": "stop",
        "receive": false
      },
      "store": "all_off_request"
    },
    {
      "op": "wait",
      "seconds": 0.5
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": {
        "action": "state"
      },
      "store": "all_off"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "state"
      },
      "store": "muted"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": {
        "action": "state",
        "receive": true
      },
      "store": "military_only_start"
    },
    {
      "op": "wait",
      "seconds": 0.5
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": {
        "action": "state"
      },
      "store": "military_only"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": {
        "action": "state",
        "military_volume": 0
      },
      "store": "zero_request"
    },
    {
      "op": "wait",
      "seconds": 0.5
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": {
        "action": "state"
      },
      "store": "zero"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": {
        "action": "state",
        "military_volume": 0.75
      },
      "store": "restore_volume"
    },
    {
      "op": "wait_until",
      "path": "BoscaliSummer.Modules.Chatter.Runtime.ChatterHost.Instance.Voices.Sounding",
      "eq": true,
      "timeout_s": 80
    },
    {
      "op": "wait",
      "seconds": 0.2
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "state"
      },
      "store": "survivor2"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.Sa74FalloutAutomation.Step",
      "args": {
        "action": "reset"
      },
      "store": "reset"
    },
    {
      "op": "wait",
      "seconds": 0.5
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "state"
      },
      "store": "reset_comms"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": {
        "action": "state"
      },
      "store": "reset_radio"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": {
        "station": "base-broadcast"
      },
      "store": "restored_start"
    },
    {
      "op": "wait_until",
      "path": "BoscaliSummer.Modules.Radio.Runtime.RadioManager.active.receiver.IsPlaying",
      "eq": true,
      "timeout_s": 10
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Radio.Runtime.RadioAutomation.Step",
      "args": {
        "action": "state"
      },
      "store": "restored"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "bases"
      },
      "store": "restored_bases"
    },
    {
      "op": "wait_until",
      "path": "BoscaliSummer.Modules.Chatter.Runtime.ChatterHost.Instance.Voices.Sounding",
      "eq": true,
      "timeout_s": 20
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Chatter.Runtime.ChatterAutomation.Acceptance",
      "args": {
        "step": "state"
      },
      "store": "restored_voice"
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_equals",
      "path": "before_blast.accepted",
      "value": 3
    },
    {
      "check": "result_equals",
      "path": "detonated.active",
      "value": true
    },
    {
      "check": "result_above",
      "path": "detonated.events",
      "min": 1
    },
    {
      "check": "result_equals",
      "path": "silenced.nuclearBlackout",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "silenced.pending",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "silenced.sounding",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "silenced.fxSounding",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "blocked.accepted",
      "value": 0
    },
    { "check": "result_equals", "path": "direct_blocked.level", "value": "Off" },
    { "check": "result_equals", "path": "direct_blocked.accepted", "value": 0 },
    { "check": "result_equals", "path": "direct_blocked.secondAccepted", "value": false },
    {
      "check": "result_equals",
      "path": "blackout.nuclear_blackout",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "blackout.nuclear_static",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "blackout.source_volume",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "blackout.vanilla_held",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "blackout.program",
      "value": "COMMUNICATIONS BLACKOUT"
    },
    {
      "check": "result_equals",
      "path": "survivor1.survivors",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "survivor1.sounding",
      "value": true
    },
    {
      "check": "result_above",
      "path": "survivor1.eventCounts.command_survivor_ground",
      "min": 1
    },
    {
      "check": "result_equals",
      "path": "survivor_duck.duck_active",
      "value": true
    },
    {
      "check": "result_below",
      "path": "survivor_duck.nuclear_static_volume",
      "max": 0.2
    },
    {
      "check": "result_equals",
      "path": "station_only.receive_military",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "station_only.nuclear_static",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "station_only.source_volume",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "station_only.vanilla_held",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "all_off.nuclear_static",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "all_off.vanilla_held",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "muted.sounding",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "muted.pending",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "military_only.receive_military",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "military_only.source_playing",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "military_only.nuclear_static",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "military_only.vanilla_held",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "zero.nuclear_static",
      "value": false
    },
    { "check": "result_equals", "path": "zero.duck_active", "value": false },
    { "check": "result_equals", "path": "midline_zero.duck_active", "value": false },
    { "check": "result_equals", "path": "midline_zero.duck_gain", "value": 1 },
    {
      "check": "result_equals",
      "path": "zero.vanilla_held",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "survivor2.survivors",
      "value": 2
    },
    {
      "check": "result_equals",
      "path": "survivor2.sounding",
      "value": true
    },
    {
      "check": "result_above",
      "path": "survivor2.eventCounts.awacs_survivor",
      "min": 1
    },
    {
      "check": "result_equals",
      "path": "reset_comms.nuclearBlackout",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "reset_comms.sounding",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "reset_comms.survivors",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "reset_radio.nuclear_static",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "restored.nuclear_blackout",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "restored.source_playing",
      "value": true
    },
    {
      "check": "result_above",
      "path": "restored.source_volume",
      "min": 0.001
    },
    {
      "check": "result_equals",
      "path": "restored_bases.accepted",
      "value": 3
    },
    {
      "check": "result_equals",
      "path": "restored_voice.sounding",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "restored_voice.eventCounts.command_baselost",
      "value": 2
    },
    {
      "check": "log_match",
      "pattern": "Exception",
      "max": 0
    }
  ]
}
