{
  "name": "performance-rendering",
  "mission": "Free Flight - Heartland",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 300,
  "timescale": 1,
  "environment": { "resolution": [1920, 1080] },
  "execution": { "frame_limit": 0 },
  "_note": "Rendered integration smoke for default-off Performance controls. Forces the existing relief-camera fallback only for AO checks, then restores direct drawing. No frame-rate claim. Offline fixtures establish shader parity and lifecycle restoration.",
  "ops": [
    {
      "op": "atmosphere",
      "time_of_day": 17.5,
      "conditions": 0.12,
      "cloud_height": 2500,
      "wind_speed": 3,
      "wind_heading": 90,
      "wind_turbulence": 0,
      "moon_phase": 14
    },
    {
      "op": "seat",
      "id": "player",
      "aircraft": "FS-20 Vortex",
      "near": [
        0,
        130000
      ],
      "altitude": 1000,
      "speed": 200,
      "heading": 240,
      "view": "cockpit",
      "timeout": 30
    },
    {
      "op": "fly",
      "id": "player",
      "program": [
        {
          "level": 180
        }
      ]
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Plugin.Settings.Effects.Enabled.Value",
      "value": false
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Plugin.Settings.Effects.Cinematic.Enabled.Value",
      "value": false
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Plugin.Settings.Performance.IndependentSharpening.Value",
      "value": false
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Plugin.Settings.Performance.OptimizeCinematicStreaks.Value",
      "value": false
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Plugin.Settings.Performance.SkipReliefAmbientOcclusion.Value",
      "value": false
    },
    {
      "op": "wait",
      "seconds": 6
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout",
      "args": {},
      "store": "baseline"
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Plugin.Settings.Performance.IndependentSharpenStrength.Value",
      "value": 0.4
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Plugin.Settings.Performance.IndependentSharpening.Value",
      "value": true
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout",
      "args": {},
      "store": "sharpen"
    },
    {
      "op": "capture",
      "name": "independent-sharpen",
      "hide_ui": false
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Plugin.Settings.Performance.IndependentSharpening.Value",
      "value": false
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout",
      "args": {},
      "store": "restored"
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Plugin.Settings.Effects.Cinematic.Enabled.Value",
      "value": true
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Plugin.Settings.Effects.Cinematic.Bloom.Value",
      "value": 0.7
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout",
      "args": {},
      "store": "originalStreak"
    },
    {
      "op": "capture",
      "name": "original-streaks",
      "hide_ui": false
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Plugin.Settings.Performance.OptimizeCinematicStreaks.Value",
      "value": true
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout",
      "args": {},
      "store": "optimizedStreak"
    },
    {
      "op": "capture",
      "name": "optimized-streaks",
      "hide_ui": false
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Plugin.Settings.Performance.OptimizeCinematicStreaks.Value",
      "value": false
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout",
      "args": {},
      "store": "streakRestored"
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Plugin.Settings.Effects.Cinematic.Enabled.Value",
      "value": false
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.MapInputAutomation.Step",
      "args": {
        "do": "open"
      },
      "store": "mapOpen"
    },
    {
      "op": "wait",
      "seconds": 3
    },
    {
      "op": "read",
      "path": "BoscaliSummer.Modules.Performance.Runtime.RenderTuning.ReliefCameraRegistered",
      "store": "reliefRegistered"
    },
    {
      "op": "read",
      "path": "BoscaliSummer.Modules.Performance.Runtime.RenderTuning.ReliefAoCalls",
      "store": "directAoCalls"
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Modules.Command.Presentation.MapUi.MfdTerrainRelief.DirectDrawOff",
      "value": true
    },
    {
      "op": "wait",
      "seconds": 3
    },
    {
      "op": "read",
      "path": "BoscaliSummer.Modules.Performance.Runtime.RenderTuning.ReliefAoCalls",
      "store": "fallbackAoCalls"
    },
    {
      "op": "read",
      "path": "BoscaliSummer.Modules.Performance.Runtime.RenderTuning.ReliefAoSkipped",
      "store": "beforeSkip"
    },
    {
      "op": "capture",
      "name": "map-native-ao",
      "hide_ui": false
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Plugin.Settings.Performance.SkipReliefAmbientOcclusion.Value",
      "value": true
    },
    {
      "op": "wait",
      "seconds": 3
    },
    {
      "op": "read",
      "path": "BoscaliSummer.Modules.Performance.Runtime.RenderTuning.ReliefAoSkipped",
      "store": "skippedAoCalls"
    },
    {
      "op": "capture",
      "name": "map-skipped-ao",
      "hide_ui": false
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Plugin.Settings.Performance.SkipReliefAmbientOcclusion.Value",
      "value": false
    },
    {
      "op": "write",
      "path": "BoscaliSummer.Modules.Command.Presentation.MapUi.MfdTerrainRelief.DirectDrawOff",
      "value": false
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.ScrollAutomation.Open",
      "args": {
        "codes": "SET",
        "page": 4
      },
      "store": "perfPage"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.ScrollAutomation.Wheel",
      "args": {
        "notches": -5
      },
      "store": "perfScroll"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "capture",
      "name": "performance-controls",
      "hide_ui": false
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.MapInputAutomation.Step",
      "args": {
        "do": "close"
      },
      "store": "mapClose"
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_equals",
      "path": "baseline.grade",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "baseline.sharpen",
      "value": -1
    },
    {
      "check": "result_equals",
      "path": "sharpen.grade",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "sharpen.sharpen",
      "value": 0.4
    },
    {
      "check": "result_equals",
      "path": "restored.sharpen",
      "value": -1
    },
    {
      "check": "result_equals",
      "path": "originalStreak.cinematic",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "originalStreak.cinematicStreakOptimized",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "optimizedStreak.cinematicStreakOptimized",
      "value": true
    },
    {
      "check": "result_above",
      "path": "optimizedStreak.cinematicStreakFrameAge",
      "min": -1
    },
    {
      "check": "result_equals",
      "path": "streakRestored.cinematicStreakOptimized",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "reliefRegistered",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "directAoCalls",
      "value": 0
    },
    {
      "check": "result_above",
      "path": "fallbackAoCalls",
      "min": 0
    },
    {
      "check": "result_equals",
      "path": "beforeSkip",
      "value": 0
    },
    {
      "check": "result_above",
      "path": "skippedAoCalls",
      "min": 0
    },
    {
      "check": "result_equals",
      "path": "perfPage.ok",
      "value": true
    },
    {
      "check": "log_match",
      "pattern": "CinematicStreakPass|CinematicPost|ReliefAmbientOcclusionPatch|Terrain render failed|Direct relief draw failed|Invalid pass|RenderTexture.Create failed",
      "max": 0
    }
  ]
}
