<Project Sdk="Microsoft.NET.Sdk">
  <!-- NATION pure rules (economy and politics v2): a standalone console runner, the exit code is the result. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Core\Contracts\NationTypes.cs" Link="NationTypes.cs" />
    <Compile Include="..\..\Core\Contracts\Politics.cs" Link="Politics.cs" />
    <Compile Include="..\..\modules\Nation\Domain\*.cs" LinkBase="Domain" />
  </ItemGroup>
</Project>
