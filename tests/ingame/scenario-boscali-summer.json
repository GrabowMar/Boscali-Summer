{
  "name": "scenario-boscali-summer",
  "description": "The scripted Boscali Summer mission, launched by script id. The sim plugin wants the mission name to equal the launch argument, so first copy modules/Scenario/Assets/boscali-summer.scenario to <game>/BepInEx/config/BoscaliSummer/scenarios/boscali-sim.scenario with the id boscali-sim, the title scenario:boscali-sim and the campaign boscali-sim. Then: the mission builds and loads, the intro cutscene takes and returns the camera, a seated BDF pilot gets the briefing, and reaching the picket station spawns the raid.",
  "mission": "scenario:boscali-sim",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 300,
  "environment": {
    "config": {
      "bepinex": {
        "Logging.Disk": {
          "WriteUnityLog": true
        }
      }
    }
  },
  "ops": [
    {
      "op": "wait",
      "seconds": 5
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Scenario.Runtime.ScenarioAutomation.State",
      "store": "intro"
    },
    {
      "op": "capture",
      "name": "intro-1-title",
      "hide_ui": false
    },
    {
      "op": "wait",
      "seconds": 8
    },
    {
      "op": "capture",
      "name": "intro-2-coup",
      "hide_ui": false
    },
    {
      "op": "wait",
      "seconds": 9
    },
    {
      "op": "capture",
      "name": "intro-3-capital",
      "hide_ui": false
    },
    {
      "op": "wait",
      "seconds": 9
    },
    {
      "op": "capture",
      "name": "intro-4-front",
      "hide_ui": false
    },
    {
      "op": "wait",
      "seconds": 9
    },
    {
      "op": "capture",
      "name": "intro-5-fleet",
      "hide_ui": false
    },
    {
      "op": "wait",
      "seconds": 9
    },
    {
      "op": "capture",
      "name": "intro-6-column",
      "hide_ui": false
    },
    {
      "op": "wait",
      "seconds": 8
    },
    {
      "op": "capture",
      "name": "intro-7-title",
      "hide_ui": false
    },
    {
      "op": "wait",
      "seconds": 9
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Scenario.Runtime.ScenarioAutomation.State",
      "store": "after_intro"
    },
    {
      "op": "capture",
      "name": "after-intro",
      "hide_ui": false
    },
    {
      "op": "seat",
      "id": "me",
      "faction": "Boscali",
      "aircraft": "FS-20 Vortex",
      "altitude": 500,
      "speed": 110,
      "heading": 185,
      "near": [
        17600,
        7000
      ]
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Scenario.Runtime.ScenarioAutomation.State",
      "store": "joined"
    },
    {
      "op": "capture",
      "name": "briefing-line",
      "hide_ui": false
    },
    {
      "op": "wait",
      "seconds": 40
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Scenario.Runtime.ScenarioAutomation.State",
      "store": "contact"
    },
    {
      "op": "capture",
      "name": "contact-line",
      "hide_ui": false
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_equals",
      "path": "intro.script",
      "value": "boscali-sim"
    },
    {
      "check": "result_above",
      "path": "intro.cut_playing",
      "min": 0.5
    },
    {
      "check": "result_below",
      "path": "after_intro.cut_playing",
      "max": 0.5
    },
    {
      "check": "result_above",
      "path": "after_intro.shots_played",
      "min": 6.5
    },
    {
      "check": "result_above",
      "path": "joined.joined",
      "min": 0.5
    },
    {
      "check": "result_equals",
      "path": "joined.side",
      "value": "Bdf"
    },
    {
      "check": "result_above",
      "path": "joined.lines_said",
      "min": 0.5
    },
    {
      "check": "result_above",
      "path": "contact.lines_said",
      "min": 3.5
    },
    {
      "check": "result_above",
      "path": "contact.objective_events",
      "min": 2.5
    },
    {
      "check": "log_match",
      "pattern": "\\[Scenario\\] 'boscali-sim' is running",
      "min": 1
    },
    {
      "check": "log_match",
      "pattern": "\\[Scenario\\] .*(could not|has no|no such|problem)",
      "max": 0
    },
    {
      "check": "log_match",
      "pattern": "was not found in lookup|MissionLoadException|Failed to load mission",
      "max": 0
    }
  ]
}
