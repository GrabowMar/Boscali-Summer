{
  "name": "weather-rain",
  "mods": ["wingcommand", "boscalisummer"],
  "timeout_s": 300,
  "ops": [
    {"op": "spawn", "id": "lead", "type": "FS-20 Vortex", "at": {"map": [0, 0]}, "altitude": 450, "speed": 110, "heading": 0},
    {"op": "record", "ids": ["lead"], "hz": 2},
    {"op": "fly", "id": "lead", "program": [{"orbit": {"bank": 15, "seconds": 300}}]},
    {"op": "wait", "seconds": 4},
    {"op": "call", "method": "BoscaliSummer.Features.Weather.Runtime.WeatherAutomation.ForceWeather", "store": "force",
     "args": {"conditions": 0.92, "cloudHeight": 4500, "rain": 1.0, "follow": "lead"}},
    {"op": "wait", "seconds": 40},
    {"op": "call", "method": "BoscaliSummer.Features.Weather.Runtime.WeatherAutomation.Readout", "store": "orbit"},
    {"op": "wait", "seconds": 50},
    {"op": "call", "method": "BoscaliSummer.Features.Weather.Runtime.WeatherAutomation.View", "store": "cockpit",
     "args": {"view": "cockpit", "follow": "lead"}},
    {"op": "wait", "seconds": 40},
    {"op": "call", "method": "BoscaliSummer.Features.Weather.Runtime.WeatherAutomation.Readout", "store": "canopy"},
    {"op": "wait", "seconds": 30},
    {"op": "call", "method": "BoscaliSummer.Features.Weather.Runtime.WeatherAutomation.Readout", "store": "late"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "alive", "ids": ["lead"]},
    {"check": "result_above", "path": "orbit.rainSystems", "min": 1},
    {"check": "result_above", "path": "orbit.audioRouted", "min": 1},
    {"check": "result_above", "path": "orbit.audioClipsReady", "min": 1},
    {"check": "result_above", "path": "orbit.atmosphere", "min": 1},
    {"check": "result_above", "path": "orbit.fogMultiplier", "min": 1.3},
    {"check": "result_above", "path": "canopy.canopyDrawnFrames", "min": 30},
        {"check": "result_above", "path": "late.terrainWetness", "min": 0.5}
  ]
}
