{
  "name": "weather-clouds",
  "mods": ["wingcommand", "boscalisummer"],
  "timeout_s": 240,
  "ops": [
    {"op": "spawn", "id": "low", "type": "FS-20 Vortex", "at": {"map": [0, 0]}, "altitude": 500, "speed": 120, "heading": 0},
    {"op": "spawn", "id": "middle", "type": "FS-20 Vortex", "at": {"map": [2000, 0]}, "altitude": 2200, "speed": 130, "heading": 0},
    {"op": "spawn", "id": "high", "type": "FS-20 Vortex", "at": {"map": [4000, 0]}, "altitude": 12000, "speed": 160, "heading": 0},
    {"op": "fly", "id": "low", "program": [{"orbit": {"bank": 12, "seconds": 180}}]},
    {"op": "fly", "id": "middle", "program": [{"orbit": {"bank": 12, "seconds": 180}}]},
    {"op": "fly", "id": "high", "program": [{"orbit": {"bank": 12, "seconds": 180}}]},
    {"op": "call", "method": "BoscaliSummer.Features.Weather.Runtime.WeatherAutomation.ForceWeather", "store": "fixture",
     "args": {"conditions": 0.97, "cloudHeight": 1600, "seed": 91, "modelAge": 780, "follow": "low"}},
    {"op": "wait", "seconds": 5},
    {"op": "capture", "name": "low-altitude"},
    {"op": "perf_window", "store": "low_perf", "seconds": 8, "warmup": 2},
    {"op": "call", "method": "BoscaliSummer.Features.Weather.Runtime.WeatherAutomation.View", "store": "middle_view",
     "args": {"view": "orbit", "follow": "middle"}},
    {"op": "wait", "seconds": 3},
    {"op": "capture", "name": "cloud-layer"},
    {"op": "perf_window", "store": "middle_perf", "seconds": 8, "warmup": 2},
    {"op": "call", "method": "BoscaliSummer.Features.Weather.Runtime.WeatherAutomation.View", "store": "high_view",
     "args": {"view": "orbit", "follow": "high"}},
    {"op": "wait", "seconds": 3},
    {"op": "capture", "name": "above-clouds"},
    {"op": "perf_window", "store": "high_perf", "seconds": 8, "warmup": 2},
    {"op": "call", "method": "BoscaliSummer.Features.Weather.Runtime.WeatherAutomation.Readout", "store": "weather"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "result_above", "path": "weather.flightClouds", "min": 1},
    {"check": "result_above", "path": "weather.cloudBodies", "min": 1},
    {"check": "result_above", "path": "weather.frontCount", "min": 1},
    {"check": "result_above", "path": "weather.cellCount", "min": 1}
  ]
}
