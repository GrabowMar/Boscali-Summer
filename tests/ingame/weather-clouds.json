{
  "name": "weather-clouds",
  "mods": ["wingcommand", "boscalisummer"],
  "timeout_s": 300,
  "ops": [
    {"op": "spawn", "id": "low", "type": "FS-20 Vortex", "at": {"map": [-30000, 0]}, "altitude": 500, "speed": 120, "heading": 90},
    {"op": "spawn", "id": "middle", "type": "FS-20 Vortex", "at": {"map": [-13000, 0]}, "altitude": 2200, "speed": 130, "heading": 90},
    {"op": "spawn", "id": "high", "type": "FS-20 Vortex", "at": {"map": [4000, 0]}, "altitude": 12000, "speed": 160, "heading": 90},
    {"op": "fly", "id": "low", "program": [{"level": 300}]},
    {"op": "fly", "id": "middle", "program": [{"level": 300}]},
    {"op": "fly", "id": "high", "program": [{"level": 300}]},
    {"op": "observe", "follow": "low"},
    {"op": "call", "method": "BoscaliSummer.Features.Weather.Runtime.WeatherAutomation.ForceWeather", "store": "fixture",
     "args": {"conditions": 0.97, "cloudHeight": 1600, "seed": 91, "modelAge": 780, "follow": "low"}},
    {"op": "wait", "seconds": 12},
    {"op": "call", "method": "BoscaliSummer.Features.Weather.Runtime.WeatherAutomation.Readout", "store": "ready",
     "args": {"requireClouds": true}},
    {"op": "observe", "follow": "low"},
    {"op": "camera", "position": [-30000, 1000, 0], "heading": 90, "pitch": 3, "fov": 70},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "low-altitude-fixed", "hide_ui": true},
    {"op": "perf_window", "store": "low_perf", "seconds": 35, "warmup": 2},
    {"op": "capture", "name": "low-altitude-after-refresh", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Features.Weather.Runtime.WeatherAutomation.Readout", "store": "low_weather"},
    {"op": "observe", "follow": "middle"},
    {"op": "camera", "position": [-13000, 2800, 0], "heading": 90, "pitch": 5, "fov": 70},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "cloud-layer-fixed", "hide_ui": true},
    {"op": "perf_window", "store": "middle_perf", "seconds": 8, "warmup": 2},
    {"op": "observe", "follow": "high"},
    {"op": "camera", "position": [4000, 12500, 0], "heading": 90, "pitch": 12, "fov": 70},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "above-clouds-fixed", "hide_ui": true},
    {"op": "perf_window", "store": "high_perf", "seconds": 8, "warmup": 2},
    {"op": "observe", "follow": "high"},
    {"op": "camera", "position": [-10000, 13500, 8000], "heading": 65, "pitch": 15, "fov": 70},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "frontal-towers-fixed", "hide_ui": true},
    {"op": "perf_window", "store": "tower_perf", "seconds": 8, "warmup": 2},
    {"op": "call", "method": "BoscaliSummer.Features.Weather.Runtime.WeatherAutomation.Readout", "store": "weather"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "result_above", "path": "ready.flightClouds", "min": 1},
    {"check": "result_above", "path": "ready.nativeCloudsHidden", "min": 1},
    {"check": "result_above", "path": "weather.flightClouds", "min": 1},
    {"check": "result_above", "path": "weather.cloudBodies", "min": 1},
    {"check": "result_above", "path": "weather.frontCount", "min": 1},
    {"check": "result_above", "path": "weather.cellCount", "min": 1},
    {"check": "result_above", "path": "weather.weatherMapUpdates", "min": 2},
    {"check": "result_above", "path": "weather.cloudShadowActive", "min": 1},
    {"check": "result_above", "path": "weather.cloudShadowUpdates", "min": 2},
    {"check": "result_below", "path": "low_perf.frame_p95_ms", "max": 33.3},
    {"check": "result_below", "path": "middle_perf.frame_p95_ms", "max": 33.3},
    {"check": "result_below", "path": "high_perf.frame_p95_ms", "max": 33.3},
    {"check": "result_below", "path": "tower_perf.frame_p95_ms", "max": 33.3}
  ]
}
