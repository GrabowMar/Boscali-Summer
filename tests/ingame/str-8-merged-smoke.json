      "min": 60
    },
    {
      "check": "result_below",
      "path": "r2.war.boscali.lockSeconds",
      "max": 121
    },
    {
      "check": "result_below",
      "path": "a2.check.effortDelta",
      "max": 0
    },
    {
      "check": "result_above",
      "path": "a2.view.effort.idChanges",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a3.view.effort.groups",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "r3.war.boscali.forcesGroups",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "g3.ground.boscali.assigned",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "g3.ground.boscali.opActive",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "a3.check.effortDelta",
      "max": 0
    },
    {
      "check": "result_below",
      "path": "a3.check.frontsDelta",
      "max": 0
    },
    {
      "check": "log_match",
      "pattern": "\\[TheaterOps\\].*staff fault",
      "max": 0
    },
    {
      "check": "log_match",
      "pattern": "Exception",
      "max": 0
    }
  ]
}
