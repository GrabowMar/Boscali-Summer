{
  "name": "str-8-merged-smoke",
  "description": "STR merged build smoke, mission Escalation: the Station Board opened at about 150 s over a live operation, place names, known census tiles, a pick through the panel verb with its lock and picker, the pilot faction's ground groups on the panel, and the deferred features' empty states; screenshots of the panel beside the map. See tools/Str-Scenarios.py.",
  "mission": "Escalation",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 700,
  "environment": {
    "config": {
      "bepinex": {
        "Logging.Disk": {
          "WriteUnityLog": true
        }
      },
      "boscalisummer": {
        "TheaterOps": {
          "FrontlineTacticsEnabled": true
        }
      }
    }
  },
  "ops": [
    {
      "op": "seat",
      "id": "player",
      "faction": "Boscali",
      "near": [
        -5000,
        30000
      ],
      "altitude": 9000,
      "speed": 200,
      "heading": 0
    },
    {
      "op": "fly",
      "id": "player",
      "program": [
        {
          "orbit": {
            "bank": 30,
            "seconds": 520
          }
        }
      ]
    },
    {
      "op": "wait",
      "seconds": 140
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r1"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.GroundProof.Read",
      "args": {},
      "store": "g1"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.CensusProof.Read",
      "args": {},
      "store": "c1"
    },
    {
      "op": "wait",
      "seconds": 5
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Open",
      "args": {
        "page": "board"
      },
      "store": "o0"
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a0"
    },
    {
      "op": "capture",
      "name": "live-merged-board",
      "hide_ui": false
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Press",
      "args": {
        "id": "tab.sitrep"
      },
      "store": "t1"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a1s"
    },
    {
      "op": "capture",
      "name": "live-merged-sitrep",
      "hide_ui": false
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Press",
      "args": {
        "id": "tab.log"
      },
      "store": "t2"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a1l"
    },
    {
      "op": "capture",
      "name": "live-merged-log",
      "hide_ui": false
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Press",
      "args": {
        "id": "tab.board"
      },
      "store": "t3"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Verb",
      "args": {
        "verb": "redirect",
        "index": 1
      },
      "store": "pk"
    },
    {
      "op": "wait",
      "seconds": 10
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a2"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r2"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.GroundProof.Read",
      "args": {},
      "store": "g2"
    },
    {
      "op": "capture",
      "name": "live-merged-picked",
      "hide_ui": false
    },
    {
      "op": "wait",
      "seconds": 45
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a3"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r3"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.GroundProof.Read",
      "args": {},
      "store": "g3"
    },
    {
      "op": "capture",
      "name": "live-merged-groups",
      "hide_ui": false
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_above",
      "path": "r1.war.boscali.frontsNamed",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "r1.war.boscali.frontsIdLike",
      "max": 0
    },
    {
      "check": "result_above",
      "path": "r1.war.boscali.deckCount",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "r3.war.boscali.faults",
      "max": 0
    },
    {
      "check": "result_above",
      "path": "r1.war.primeva.frontsNamed",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "r1.war.primeva.frontsIdLike",
      "max": 0
    },
    {
      "check": "result_above",
      "path": "r1.war.primeva.deckCount",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "r3.war.primeva.faults",
      "max": 0
    },
    {
      "check": "result_above",
      "path": "r1.war.boscali.opLive",
      "min": 1
    },
    {
      "check": "result_equals",
      "path": "a0.hub",
      "value": true
    },
    {
      "check": "result_above",
      "path": "a0.panel.present",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a0.panel.screenActive",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "a0.panel.page",
      "max": 0
    },
    {
      "check": "result_above",
      "path": "a0.overlay.present",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a0.overlay.visible",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a0.view.revision",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a0.view.fronts",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a0.view.proposals",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a0.view.effort.live",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "a0.overlay.overflow",
      "max": 0
    },
    {
      "check": "result_above",
      "path": "a0.view.ageSeconds",
      "min": 0
    },
    {
      "check": "result_below",
      "path": "a0.view.ageSeconds",
      "max": 15
    },
    {
      "check": "result_below",
      "path": "a0.check.frontsDelta",
      "max": 0
    },
    {
      "check": "result_below",
      "path": "a0.check.proposalsDelta",
      "max": 0
    },
    {
      "check": "result_below",
      "path": "a0.check.effortDelta",
      "max": 0
    },
    {
      "check": "result_below",
      "path": "a0.view.nameIdLike",
      "max": 0
    },
    {
      "check": "result_above",
      "path": "a0.overlay.tags.front",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a0.overlay.tags.prop",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a0.view.tiles.sectors",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a0.view.tiles.air",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a0.view.tiles.ground",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a0.view.alertLevel",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "a0.view.alertLevel",
      "max": 5
    },
    {
      "check": "result_above",
      "path": "c1.census.known",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "c1.census.threat",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "c1.census.threat",
      "max": 5
    },
    {
      "check": "result_equals",
      "path": "c1.check.tickerLevelDelta",
      "value": 0
    },
    {
