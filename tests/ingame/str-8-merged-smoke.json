      "path": "a1s.panel.page",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "a1s.panel.page",
      "max": 1
    },
    {
      "check": "result_above",
      "path": "a1l.panel.page",
      "min": 2
    },
    {
      "check": "result_above",
      "path": "t1.ok",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "t2.ok",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "t3.ok",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "pk.ok",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "pk.pressed",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a2.view.effort.pickedByLocal",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "a2.view.effort.pickedByStaff",
      "max": 0
    },
    {
      "check": "result_above",
      "path": "a2.view.effort.live",
      "min": 1
    },
    {
