{
  "name": "ops-defence",
  "mission": "Escalation",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 600,
  "ops": [
    { "op": "seat", "id": "player", "altitude": 1500, "speed": 180, "heading": 0 },
    { "op": "wait", "seconds": 20 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.DefenceAutomation.Step", "store": "ai_off", "args": { "verb": "ai_off" } },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Window", "store": "net_open", "args": { "front": 1 } },
    { "op": "wait", "seconds": 3 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.DefenceAutomation.Step", "store": "expose", "args": { "verb": "expose" } },
    { "op": "wait", "seconds": 12 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.DefenceAutomation.Step", "store": "breach", "args": { "verb": "breach" } },
    { "op": "wait", "seconds": 45 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.DefenceAutomation.Read", "store": "held", "args": {} },
    { "op": "capture", "name": "defence_network_breached" },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.DefenceAutomation.Step", "store": "purge", "args": { "verb": "purge" } },
    { "op": "wait", "seconds": 4 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.DefenceAutomation.Read", "store": "purging", "args": {} },
    { "op": "capture", "name": "defence_network_purging" },
    { "op": "wait", "seconds": 22 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.DefenceAutomation.Read", "store": "purged", "args": {} },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Window", "store": "sof_open", "args": { "front": 2 } },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.DefenceAutomation.Step", "store": "raid", "args": { "verb": "raid" } },
    { "op": "wait", "seconds": 8 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.DefenceAutomation.Read", "store": "detected", "args": {} },
    { "op": "capture", "name": "defence_shadow_hostile" },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.DefenceAutomation.Step", "store": "sweep", "args": { "verb": "sweep" } },
    { "op": "wait", "seconds": 36 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.DefenceAutomation.Read", "store": "swept", "args": {} },
    { "op": "capture", "name": "defence_shadow_swept" },
    { "op": "end" }
  ],
  "checks": [
    { "check": "status_ok" },
    { "check": "result_above", "path": "expose.stamped", "min": 0.5 },
    { "check": "result_above", "path": "breach.node", "min": 0.5 },
    { "check": "result_above", "path": "held.enemyHoldsOurNode", "min": 0.5 },
    { "check": "result_above", "path": "held.hostBreaches", "min": 0.5 },
    { "check": "result_above", "path": "held.mirrorBreaches", "min": 0.5 },
    { "check": "result_above", "path": "held.toldBreach", "min": 0.5 },
    { "check": "result_above", "path": "purge.request", "min": 0.5 },
    { "check": "result_above", "path": "purging.purgeRunning", "min": 0.5 },
    { "check": "result_above", "path": "purged.purgedReleases", "min": 0.5 },
    { "check": "result_above", "path": "purged.toldPurged", "min": 0.5 },
    { "check": "result_above", "path": "purged.toldEnemyPurged", "min": 0.5 },
    { "check": "result_above", "path": "raid.slot", "min": -0.5 },
    { "check": "result_above", "path": "detected.hostHostiles", "min": 0.5 },
    { "check": "result_above", "path": "detected.mirrorNear", "min": 0.5 },
    { "check": "result_above", "path": "detected.toldHostile", "min": 0.5 },
    { "check": "result_above", "path": "sweep.request", "min": 0.5 },
    { "check": "result_above", "path": "swept.raidHunted", "min": 0.5 },
    { "check": "result_above", "path": "swept.toldQrf", "min": 0.5 },
    { "check": "result_above", "path": "swept.toldEnemyQrf", "min": 0.5 }
  ]
}
