{
  "name": "vg-aegis",
  "_note": "Lead is a CI-22 Cricket: its Outer Left Wing Pylon is a ONE-station set that offers the pod's ECMPod1 donor, so the station holds exactly 3 darts (FS-20 has no legal set; FS-12 / T/A-30 / SFB-81 sets merge two pods into one 6-dart station and break the ammo checks). hit.aegis.doorOpen and hit.aegis.finsOpen need the Door0..2 / FinA..FinD joints of the remade AegisPod / AegisInterceptor models: they stay red on branches without those models and are not a code fault.",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 240,
  "ops": [
    {
      "op": "spawn",
      "id": "lead",
      "type": "CI-22 Cricket",
      "faction": "Boscali",
      "at": {
        "map": [
          0,
          0
        ]
      },
      "altitude": 3000,
      "msl": true,
      "speed": 140,
      "heading": 0
    },
    {
      "op": "spawn",
      "id": "bandit",
      "type": "CI-22 Cricket",
      "faction": "Primeva",
      "at": {
        "near": {
          "id": "lead",
          "offset": [
            0,
            0,
            -1800
          ]
        }
      },
      "speed": 120
    },
    {
      "op": "fly",
      "id": "lead",
      "program": [
        {
          "level": 200
        }
      ]
    },
    {
      "op": "fly",
      "id": "bandit",
      "program": [
        {
          "level": 200
        }
      ]
    },
    {
      "op": "observe",
      "follow": "lead"
    },
    {
      "op": "wait",
      "seconds": 3
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step",
      "args": {
        "action": "aegisfit"
      },
      "store": "fit"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "mark",
      "text": "a hardpoint pair mounts two pods (6 darts): keep 3 so the last-dart rules are reached"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step",
      "args": {
        "action": "aegisfit",
        "darts": 3
      },
      "store": "trim"
    },
    {
      "op": "mark",
      "text": "dry trigger: pod fitted, no lock -> SNAP NO SOLUTION, no dart"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step",
      "args": {
        "action": "snap",
        "target": "none"
      },
      "store": "dry"
    },
    {
      "op": "mark",
      "text": "auto defence: IR missile locks the lead -> AegisService launches a dart"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step",
      "args": {
        "action": "threat",
        "range": 3000,
        "seeker": "IR",
        "climb": 100
      },
      "store": "threat1"
    },
    {
      "op": "wait",
      "seconds": 7
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step",
      "args": {
        "action": "snap",
        "press": 0
      },
      "store": "defence"
    },
    {
      "op": "mark",
      "text": "second threat 6 km out, then SNAP at the bandit ~1.6 km ahead (2 darts left -> allowed)"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step",
      "args": {
        "action": "threat",
        "range": 6000,
        "seeker": "IR",
        "climb": 100
      },
      "store": "threat2"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step",
      "args": {
        "action": "snap"
      },
      "store": "snap"
    },
    {
      "op": "wait",
      "seconds": 0.3
    },
    {
      "op": "capture",
      "name": "aegis-snap-release"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "mark",
      "text": "last dart + threat inbound -> reserved for the defence, no launch"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step",
      "args": {
        "action": "snap",
        "target": "none"
      },
      "store": "reserve"
    },
    {
      "op": "wait",
      "seconds": 7
    },
    {
      "op": "mark",
      "text": "snap result: snapHit needs server contact; doorOpen/finsOpen need the Door0..2 + FinA..FinD joints of the remade pod/dart models (red before those models merge = model dependency, not a code fault)"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step",
      "args": {
        "action": "snap",
        "press": 0
      },
      "store": "hit"
    },
    {
      "op": "wait",
      "seconds": 16
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step",
      "args": {
        "action": "snap",
        "press": 0
      },
      "store": "last"
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_below",
      "path": "dry.aegis.ammoBefore",
      "max": 3
    },
    {
      "check": "result_above",
      "path": "dry.aegis.ammoBefore",
      "min": 3
    },
    {
      "check": "result_above",
      "path": "dry.aegis.ammo",
      "min": 3
    },
    {
      "check": "result_above",
      "path": "dry.aegis.noSolution",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "defence.aegis.defenceLaunch",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "defence.aegis.defenceContact",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "defence.threatsGone",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "snap.aegis.range",
      "max": 2500
    },
    {
      "check": "result_above",
      "path": "snap.aegis.ammoBefore",
      "min": 2
    },
    {
      "check": "result_below",
      "path": "snap.aegis.ammo",
      "max": 1
    },
    {
      "check": "result_above",
      "path": "snap.aegis.snapPress",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "reserve.aegis.reserved",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "reserve.aegis.ammo",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "hit.aegis.snapAway",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "hit.aegis.snapHit",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "hit.aegis.doorOpen",
      "min": 2
    },
    {
      "check": "result_above",
      "path": "hit.aegis.finsOpen",
      "min": 2
    },
    {
      "check": "result_above",
      "path": "last.aegis.defenceLaunch",
      "min": 2
    },
    {
      "check": "result_below",
      "path": "last.aegis.ammo",
      "max": 0
    },
    {
      "check": "result_above",
      "path": "last.threatsGone",
      "min": 2
    }
  ]
}