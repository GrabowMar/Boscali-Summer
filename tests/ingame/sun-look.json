{
  "name": "sun-look",
  "mods": ["boscalisummer"],
  "timeout_s": 240,
  "timescale": 1,
  "_note": "Picture evidence for the sun from the cockpit, over open sea north of the island (the ground war shoots sim aircraft over land). Noon under fair cumulus: three looks at the sun 6 s apart, each with the weather readout (viewLightTransmission says whether cloud was on the line of sight, sunDiscRed/Blue the glow written to the disc). Then the setting sun (map latitude puts sunset at 18.0, due west).",
  "ops": [
    {"op": "atmosphere", "time_of_day": 12, "conditions": 0.1, "cloud_height": 2500, "wind_speed": 3, "wind_heading": 90, "wind_turbulence": 0.1, "moon_phase": 14},
    {"op": "seat", "id": "player", "aircraft": "FS-20 Vortex", "near": [0, 130000], "altitude": 1200, "speed": 200, "heading": 180, "view": "cockpit", "timeout": 30},
    {"op": "fly", "id": "player", "program": [{"level": 220}]},
    {"op": "wait", "seconds": 20},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.PinSky", "args": {"sky": 8}, "store": "pin"},
    {"op": "wait", "seconds": 15},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Look", "args": {"pitch": -36, "yaw": 0, "seconds": 40}, "store": "look_noon"},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "args": {}, "store": "noon_a"},
    {"op": "capture", "name": "sun-noon-a", "hide_ui": false},
    {"op": "wait", "seconds": 6},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "args": {}, "store": "noon_b"},
    {"op": "capture", "name": "sun-noon-b", "hide_ui": false},
    {"op": "wait", "seconds": 6},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "args": {}, "store": "noon_c"},
    {"op": "capture", "name": "sun-noon-c", "hide_ui": false},
    {"op": "wait", "seconds": 6},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "args": {}, "store": "noon_d"},
    {"op": "capture", "name": "sun-noon-d", "hide_ui": false},
    {"op": "atmosphere", "time_of_day": 17.9, "conditions": 0.1, "cloud_height": 2500, "wind_speed": 3, "wind_heading": 90, "wind_turbulence": 0.1, "moon_phase": 14},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Look", "args": {"pitch": -2, "yaw": 89, "seconds": 30}, "store": "look_set"},
    {"op": "wait", "seconds": 5},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "args": {}, "store": "set"},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout", "args": {}, "store": "pilot_set"},
    {"op": "capture", "name": "sun-set", "hide_ui": false},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "result_below", "path": "noon_a.sunDiscRed", "max": 12001},
    {"check": "result_below", "path": "set.sunDiscRed", "max": 4000},
    {"check": "result_below", "path": "set.sunDiscBlue", "max": 400}
  ]
}
