            "seconds": 3000
          }
        }
      ]
    },
    {
      "op": "wait",
      "seconds": 5
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Wing.Runtime.WingAiProof.Call",
      "store": "call",
      "args": {
        "lead": "lead",
        "count": 3
      }
