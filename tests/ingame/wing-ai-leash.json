{
  "name": "wing-ai-leash",
  "_notes": "Wing AI fix 2026-10-19 (WingService.Combat AnchorOf): three wingmen (the wing's cap), #3/#4 MOVE to the south-west coast (-30, -38 km), 30+ km from the circling lead, as element B, arrive and orbit there, two Primeva FS-20s are spawned beside them and B is ordered ENGAGE. Before the fix every B member was taken back with reason Leash the tick after it engaged (leashed to A's anchor, the lead, >20 km away).",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 600,
  "environment": {
    "config": {
      "bepinex": {
        "Logging.Disk": {
          "WriteUnityLog": true
        }
      },
      "boscalisummer": {
        "Trenches": {
          "Enabled": false
        },
        "TheaterOps": {
          "Enabled": false
        },
        "Events": {
          "Enabled": false
        },
        "Garrisons": {
          "Enabled": false
        },
        "DynamicOperations": {
          "Enabled": false
        },
        "Debug": {
          "WingVerboseLogging": true
        }
      }
    }
  },
