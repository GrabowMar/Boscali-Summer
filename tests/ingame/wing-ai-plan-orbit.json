    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Wing.Runtime.WingAiProof.Read",
      "store": "p570"
    },
    {
      "op": "wait",
      "seconds": 30
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Wing.Runtime.WingAiProof.Read",
      "store": "p600"
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "alive",
      "ids": [
        "lead"
      ]
    },
    {
      "check": "log_match",
      "pattern": "\\[Wing\\] tick step \\d+ failed",
      "max": 0
    },
    {
      "check": "result_equals",
      "path": "plan.ok",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "p600.plan.steps.A1.state",
      "value": "Done"
    },
    {
      "check": "result_above",
      "path": "p600.plan.steps.A1.ended",
      "min": 180
    },
    {
      "check": "log_match",
      "pattern": "\\[Plan\\] A2 Rtb: ",
      "min": 1
    },
    {
      "check": "log_match",
      "pattern": "\\[Plan\\] A\\d blocked",
      "max": 0
    }
  ]
}
