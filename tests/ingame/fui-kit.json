{
  "name": "fui-kit",
  "mods": ["wingcommand", "boscalisummer"],
  "timeout_s": 240,
  "ops": [
    {"op": "spawn", "id": "lead", "type": "FS-20 Vortex", "at": {"map": [0, 0]}, "altitude": 800, "speed": 120, "heading": 0},
    {"op": "timescale", "value": 1},
    {"op": "fly", "id": "lead", "program": [{"orbit": {"bank": 15, "seconds": 200}}]},
    {"op": "wait", "seconds": 5},
    {"op": "call", "method": "NOAvionics.Ui.AvDiagnostics.Start", "store": "start", "args": {"blur": true}},
    {"op": "wait", "seconds": 30},
    {"op": "call", "method": "NOAvionics.Ui.AvDiagnostics.Read", "store": "live"},
    {"op": "call", "method": "NOAvionics.Ui.AvDiagnostics.Stop", "store": "stop"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "result_above", "path": "start.bundle", "min": 1},
    {"check": "result_above", "path": "live.blur_frames", "min": 1}
  ]
}
