{
  "name": "night-vision",
  "mods": ["boscalisummer"],
  "timeout_s": 360,
  "timescale": 1,
  "_note": "Picture and readout evidence for the night-vision looks, at 23:00 over open sea north of the island (the ground war shoots sim aircraft over land). Under a pinned clear sky; friendly FS-20s fly 300 m and 3 km ahead as the hot units (the seated player is flown by the sim to hold formation, which hides the combat HUD). Stills: naked eye, vanilla, white phosphor, fused, fused at HIGH gain, then noon is switched on under the goggles to make the tube gate. Last, goggles off: the mod must have handed vanilla's volume back.",
  "environment": {"config": {"bepinex": {"Logging.Disk": {"WriteUnityLog": true}}}},
  "ops": [
    {"op": "atmosphere", "time_of_day": 23, "conditions": 0.1, "cloud_height": 2500, "wind_speed": 3, "wind_heading": 90, "wind_turbulence": 0.1, "moon_phase": 14},
    {"op": "seat", "id": "player", "aircraft": "FS-20 Vortex", "near": [0, 130000], "altitude": 3000, "speed": 220, "heading": 0, "view": "cockpit", "timeout": 30},
    {"op": "fly", "id": "player", "program": [{"level": 300}]},
    {"op": "wait", "seconds": 20},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.PinSky", "args": {"sky": 1}, "store": "pin"},
    {"op": "wait", "seconds": 12},
    {"op": "spawn", "id": "lead", "type": "FS-20 Vortex", "faction": "Boscali", "at": {"near": {"id": "player", "offset": [25, 4, -300]}}, "altitude": 3004, "speed": 220, "heading": 0},
    {"op": "fly", "id": "lead", "program": [{"level": 300}]},
    {"op": "spawn", "id": "far", "type": "FS-20 Vortex", "faction": "Boscali", "at": {"near": {"id": "player", "offset": [-250, 60, -3000]}}, "altitude": 3060, "speed": 220, "heading": 0},
    {"op": "fly", "id": "far", "program": [{"level": 300}]},
    {"op": "wait", "seconds": 6},
    {"op": "capture", "name": "nvg-0-naked", "hide_ui": false},

    {"op": "call", "method": "BoscaliSummer.Modules.QoL.Runtime.NightVisionAutomation.Set", "args": {"on": true, "look": "Vanilla"}, "store": "set_vanilla"},
    {"op": "wait", "seconds": 4},
    {"op": "call", "method": "BoscaliSummer.Modules.QoL.Runtime.NightVisionAutomation.Readout", "args": {}, "store": "vanilla"},
    {"op": "capture", "name": "nvg-1-vanilla", "hide_ui": false},

    {"op": "call", "method": "BoscaliSummer.Modules.QoL.Runtime.NightVisionAutomation.Set", "args": {"look": "WhitePhosphor", "gain": 0}, "store": "set_white"},
    {"op": "wait", "seconds": 6},
    {"op": "call", "method": "BoscaliSummer.Modules.QoL.Runtime.NightVisionAutomation.Readout", "args": {}, "store": "white"},
    {"op": "capture", "name": "nvg-2-white", "hide_ui": false},

    {"op": "spawn", "id": "close", "type": "FS-20 Vortex", "faction": "Boscali", "at": {"near": {"id": "player", "offset": [-14, 3, -90]}}, "altitude": 3003, "speed": 220, "heading": 0},
    {"op": "fly", "id": "close", "program": [{"level": 300}]},
    {"op": "call", "method": "BoscaliSummer.Modules.QoL.Runtime.NightVisionAutomation.Set", "args": {"look": "Fused"}, "store": "set_fused"},
    {"op": "wait", "seconds": 5},
    {"op": "call", "method": "BoscaliSummer.Modules.QoL.Runtime.NightVisionAutomation.Readout", "args": {}, "store": "fused"},
    {"op": "capture", "name": "nvg-3-fused", "hide_ui": false},

    {"op": "perf_window", "store": "perf_fused", "seconds": 8, "warmup": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.QoL.Runtime.NightVisionAutomation.Set", "args": {"look": "Vanilla"}, "store": "set_vanilla_perf"},
    {"op": "perf_window", "store": "perf_vanilla", "seconds": 8, "warmup": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.QoL.Runtime.NightVisionAutomation.Set", "args": {"look": "Fused"}, "store": "set_fused_again"},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.QoL.Runtime.NightVisionAutomation.Set", "args": {"gain": 3}, "store": "set_high"},
    {"op": "wait", "seconds": 5},
    {"op": "call", "method": "BoscaliSummer.Modules.QoL.Runtime.NightVisionAutomation.Readout", "args": {}, "store": "high"},
    {"op": "capture", "name": "nvg-4-fused-high", "hide_ui": false},

    {"op": "call", "method": "BoscaliSummer.Modules.QoL.Runtime.NightVisionAutomation.Set", "args": {"gain": 0}, "store": "set_auto"},
    {"op": "wait", "seconds": 5},
    {"op": "call", "method": "BoscaliSummer.Modules.QoL.Runtime.NightVisionAutomation.Readout", "args": {}, "store": "before_flash"},
    {"op": "atmosphere", "time_of_day": 12, "conditions": 0.1, "cloud_height": 2500, "wind_speed": 3, "wind_heading": 90, "wind_turbulence": 0.1, "moon_phase": 14},
    {"op": "wait", "seconds": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.QoL.Runtime.NightVisionAutomation.Readout", "args": {}, "store": "flash"},
    {"op": "capture", "name": "nvg-5-gate", "hide_ui": false},

    {"op": "call", "method": "BoscaliSummer.Modules.QoL.Runtime.NightVisionAutomation.Set", "args": {"on": false}, "store": "set_off"},
    {"op": "wait", "seconds": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.QoL.Runtime.NightVisionAutomation.Readout", "args": {}, "store": "off"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_match", "pattern": "Exception", "max": 0},
    {"check": "result_above", "path": "vanilla.active", "min": 0.5},
    {"check": "result_below", "path": "vanilla.ownsGain", "max": 0.5},
    {"check": "result_above", "path": "white.ownsGain", "min": 0.5},
    {"check": "result_above", "path": "white.metered", "min": 0.5},
    {"check": "result_below", "path": "white.passAge", "max": 3},
    {"check": "result_below", "path": "white.hot", "max": 0.5},
    {"check": "result_above", "path": "fused.hot", "min": 0.5},
    {"check": "result_above", "path": "fused.draws", "min": 0.5},
    {"check": "result_below", "path": "before_flash.gating", "max": 0.5},
    {"check": "result_above", "path": "flash.gating", "min": 0.5},
    {"check": "result_below", "path": "off.ownsGain", "max": 0.5},
    {"check": "result_below", "path": "off.active", "max": 0.5}
  ]
}
