    {"op": "fly", "id": "player", "program": [{"level": 2100}]},
    {"op": "spawn", "id": "skimmer", "type": "FS-20 Vortex", "at": {"near": {"id": "player", "offset": [300, -282, 1800]}}, "altitude": 14, "speed": 230, "heading": 0},
    {"op": "fly", "id": "skimmer", "program": [{"level": 2100}]},
