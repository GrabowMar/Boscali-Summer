        "Logging.Disk": {
          "WriteUnityLog": true
        }
      },
      "boscalisummer": {
        "Kaiju": {
          "HardpointToughness": 2.5
        }
      }
    }
  },
  "ops": [
    {
      "op": "spawn",
      "id": "lead",
      "type": "FS-20 Vortex",
      "faction": "Boscali",
      "at": {
        "map": [
          15000,
          -30000
        ]
