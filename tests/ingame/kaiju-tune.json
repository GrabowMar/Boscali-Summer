      "store": "weather",
      "args": {
        "regime": "Broken",
        "conditions": 0.9,
        "cloudHeight": 2200,
        "seed": 91
      }
    },
    {
      "op": "camera",
      "position": [
        15000,
        700,
        -20000
      ],
      "heading": 0,
      "pitch": 6,
      "fov": 60
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Kaiju.KaijuAutomation.Step",
