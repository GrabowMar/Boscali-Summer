{
  "name": "str-3-reduced-dom",
  "description": "STR engine proof in Domination, ground steering without vehicles (D9): a hostile tracked at an owned airbase produces a DEFEND card, and no assault or recon card exists without a carrier.",
  "mission": "Domination",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 400,
  "environment": {
    "config": {
      "bepinex": {
        "Logging.Disk": {
          "WriteUnityLog": true
        }
      }
    }
  },
  "ops": [
    {
      "op": "seat",
      "id": "player",
      "faction": "Boscali",
      "near": [
        0,
        0
      ],
      "altitude": 9000,
      "speed": 200,
      "heading": 0
    },
    {
      "op": "fly",
      "id": "player",
      "program": [
        {
          "orbit": {
            "bank": 30,
            "seconds": 300
          }
        }
      ]
    },
    {
      "op": "wait",
      "seconds": 20
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r0"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Track",
      "args": {
        "faction": "Boscali",
        "seconds": 40
      },
      "store": "t1"
    },
    {
      "op": "wait",
      "seconds": 25
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r1"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.GroundProof.Read",
      "args": {},
      "store": "d1"
    },
    {
      "op": "wait",
      "seconds": 20
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.GroundProof.Read",
      "args": {},
      "store": "d2"
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_above",
      "path": "t1.planted",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "r1.war.boscali.defendCards",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "r1.war.boscali.assaultCardsWithoutCarriers",
      "max": 0
    },
    {
      "check": "result_below",
      "path": "r1.war.boscali.faults",
      "max": 0
    },
    {
      "check": "result_equals",
      "path": "d1.ground.boscali.reason",
      "value": "NO_VEHICLES"
    },
    {
      "check": "result_equals",
      "path": "d1.ground.primeva.reason",
      "value": "NO_VEHICLES"
    },
    {
      "check": "result_below",
      "path": "d2.ground.boscali.members",
      "max": 0
    },
    {
      "check": "result_below",
      "path": "d2.ground.primeva.members",
      "max": 0
    },
    {
      "check": "result_below",
      "path": "d2.hook.overrides",
      "max": 0
    },
    {
      "check": "log_match",
      "pattern": "\\[TheaterOps\\].*staff fault",
      "max": 0
    },
    {
      "check": "log_match",
      "pattern": "Exception",
      "max": 0
    }
  ]
}
