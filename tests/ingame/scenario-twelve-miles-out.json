      "method": "BoscaliSummer.Modules.Scenario.Runtime.ScenarioAutomation.Disable",
      "args": {
        "units": "ardent"
      },
      "store": "kill_ardent"
    },
    {
      "op": "wait",
      "seconds": 25
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Scenario.Runtime.ScenarioAutomation.World",
      "args": {
        "units": "calder_spirit,raider_1,raider_2,raider_helo,summer_two"
      },
      "store": "world_air"
    },
    {
      "op": "capture",
      "name": "24-air",
      "hide_ui": false
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Scenario.Runtime.ScenarioAutomation.Disable",
      "args": {
        "units": "raider_1,raider_2,raider_helo"
      },
      "store": "kill_air"
    },
    {
      "op": "wait",
      "seconds": 35
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Scenario.Runtime.ScenarioAutomation.State",
      "store": "end"
    },
    {
      "op": "capture",
      "name": "25-end",
      "hide_ui": false
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_equals",
      "path": "intro.script",
      "value": "tmo-sim"
    },
    {
      "check": "result_equals",
      "path": "joined.side",
      "value": "Pmc"
    },
    {
      "check": "result_equals",
      "path": "joined.flight_controls_enabled",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "joined.join_menu_open",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "world_seat.peace",
      "value": 1
    },
    {
      "check": "result_below",
      "path": "world_enroute.tracks_Boscali_PMC",
      "max": 0.5
    },
    {
      "check": "result_below",
      "path": "world_enroute.tracks_Primeva_PMC",
      "max": 0.5
    },
    {
      "check": "result_below",
      "path": "world_enroute.tracks_PMC_Boscali",
      "max": 0.5
    },
    {
      "check": "result_below",
      "path": "world_enroute.tracks_PMC_Primeva",
      "max": 0.5
    },
    {
      "check": "result_above",
      "path": "world_enroute.tracks_Primeva_Boscali",
      "min": 0.5
    },
    {
      "check": "result_above",
      "path": "world_boats_late.tracks_PMC_Pirates",
      "min": 0.5
    },
    {
      "check": "result_below",
      "path": "world_boats_late.tracks_Pirates_Boscali",
      "max": 0.5
    },
    {
      "check": "log_match",
      "pattern": "\\[Pmc\\] HQ made",
      "min": 1
    },
    {
      "check": "log_match",
      "pattern": "\\[Pmc\\] Pirates HQ made",
      "min": 1
    },
    {
      "check": "log_match",
      "pattern": "\\[Scenario\\] the pilot is seated in a",
      "min": 1
    },
    {
      "check": "log_match",
      "pattern": "\\[Pmc\\] .*(no FactionHQ|HQ could not|HQ spawn failed)",
      "max": 0
    },
    {
      "check": "log_match",
      "pattern": "Exception.*(FactionHQ|FactionRegistry|MissionStatsTracker|Pmc|Radar|TargetDetector|Scenario)|(FactionHQ|FactionRegistry|MissionStatsTracker|Pmc|Radar|TargetDetector|Scenario).*Exception",
      "max": 0
    },
    {
      "check": "log_match",
      "pattern": "was not found in lookup|MissionLoadException|Failed to load mission",
      "max": 0
    },
    {
      "check": "log_match",
      "pattern": "\\[Scenario\\] (no aircraft|this mission has no|.*could not be (decoded|read))|screen clip:",
      "max": 0
    },
    {
      "check": "log_match",
      "pattern": "NullReferenceException",
      "max": 12
    },
    {
      "check": "result_equals",
      "path": "kill_ardent.threw",
      "value": ""
    },
    {
      "check": "result_equals",
      "path": "end.finished",
      "value": 1
