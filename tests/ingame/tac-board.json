        "offsetY": 0,
        "shade": 0.45,
        "declutter": "Full",
        "opacity": 1.0,
        "scopeMode": "Auto",
        "sway": true,
        "corners": true,
        "showLamps": true,
        "showSystemsStrip": true,
        "showGauges": true,
        "showTicker": true,
        "pageThreat": true,
        "pageShot": true,
        "pageMissileCam": true,
        "pageApproach": true,
        "pageWing": true,
        "pageStrike": true,
        "pageDock": true,
        "pageObjective": true,
        "pageSystems": true,
        "threatHoldSeconds": 6.0,
        "pageMinSeconds": 3.0
