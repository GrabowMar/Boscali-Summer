{
  "_note": "The TAC BOARD in the cockpit, ONE run for every look. Cruise first, the dock geometry probe, then ten looks, each set through HudAutomation.Configure (the SET console's own settings contract) with 2 s for the board's 10 Hz tick and a capture: cruise-wide (the defaults, every option set explicitly), look-stack, look-wide-scale07, look-wide-scale13-moved (scale 1.3, 300 left, 120 down), look-shade0, look-shade1, look-lean, look-minimal, look-board-off (the game's own weapon, countermeasure and power panels must be back; the restyled kill feed and map stay) and look-board-on. Then the cruise SYSTEMS strip with the THREAT page switched off (the mission's own radar emitter keeps the THREAT page up from the first second otherwise, so every look above is a THREAT look; round 1 of the in-game run never saw the strip): cruise-systems-wide and cruise-systems-stack. Then a bandit head-on at 8 km, the missile shot (shot, shot-later, after) and the tracker probe. Configure changes the options IN MEMORY ONLY: the config file is never written and the last op puts the pilot's own values back (cfg_restored), so a run leaves the player's saved settings alone. results.json holds the dock / fire / msl probes and what each Configure applied (cfg_*). The checks assert the options really reached the contract, that the shot happened and that the Unity log has no Exception; nothing asserts the board's pixels, that is read off the captures.",
  "name": "tac-board",
  "description": "TAC BOARD looks in one cockpit run: wide, stack, scale 0.7 and 1.3 moved, shade 0 and 1, lean, minimal, board off and on; then four DL EVT LOG lines through the game's feed, then a missile shot.",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 300,
  "environment": {
    "config": {
      "bepinex": {
        "Logging.Disk": {
          "WriteUnityLog": true
        }
      }
    }
  },
  "ops": [
    {
      "op": "seat",
      "id": "player",
      "altitude": 3000,
      "speed": 220,
      "heading": 0,
      "view": "cockpit"
    },
    {
      "op": "record",
      "ids": [
        "*"
      ],
      "hz": 5
    },
    {
      "op": "wait",
      "seconds": 6
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Dock",
      "args": {},
      "store": "dock"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Configure",
      "args": {
        "enabled": true,
        "layout": "Wide",
        "scale": 1.0,
        "offsetX": 0,
        "offsetY": 0,
        "shade": 0.45,
        "declutter": "Full",
        "opacity": 1.0,
        "scopeMode": "Auto",
        "sway": true,
        "corners": true,
        "showLamps": true,
        "showSystemsStrip": true,
        "showGauges": true,
        "showTicker": true,
        "pageThreat": true,
        "pageShot": true,
        "pageMissileCam": true,
        "pageApproach": true,
        "pageWing": true,
        "pageStrike": true,
        "pageDock": true,
        "pageObjective": true,
        "pageSystems": true,
        "threatHoldSeconds": 6.0,
        "pageMinSeconds": 3.0
      },
      "store": "cfg_wide"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "capture",
      "name": "cruise-wide"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Configure",
      "args": {
        "enabled": true,
        "layout": "Stack",
        "scale": 1.0,
        "offsetX": 0,
        "offsetY": 0,
        "shade": 0.45,
        "declutter": "Full"
      },
      "store": "cfg_stack"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "capture",
      "name": "look-stack"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Configure",
      "args": {
        "enabled": true,
        "layout": "Wide",
        "scale": 0.7,
        "offsetX": 0,
        "offsetY": 0,
        "shade": 0.45,
        "declutter": "Full"
      },
      "store": "cfg_scale07"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "capture",
      "name": "look-wide-scale07"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Configure",
      "args": {
        "enabled": true,
        "layout": "Wide",
        "scale": 1.3,
        "offsetX": 300,
        "offsetY": 120,
        "shade": 0.45,
        "declutter": "Full"
      },
      "store": "cfg_scale13"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "capture",
      "name": "look-wide-scale13-moved"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Configure",
      "args": {
        "enabled": true,
        "layout": "Wide",
        "scale": 1.0,
        "offsetX": 0,
        "offsetY": 0,
        "shade": 0.0,
        "declutter": "Full"
      },
      "store": "cfg_shade0"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "capture",
      "name": "look-shade0"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Configure",
      "args": {
        "enabled": true,
        "layout": "Wide",
        "scale": 1.0,
        "offsetX": 0,
        "offsetY": 0,
        "shade": 1.0,
        "declutter": "Full"
      },
      "store": "cfg_shade1"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "capture",
      "name": "look-shade1"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Configure",
      "args": {
        "enabled": true,
        "layout": "Wide",
        "scale": 1.0,
        "offsetX": 0,
        "offsetY": 0,
        "shade": 0.45,
        "declutter": "Lean"
      },
      "store": "cfg_lean"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "capture",
      "name": "look-lean"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Configure",
      "args": {
        "enabled": true,
        "layout": "Wide",
        "scale": 1.0,
        "offsetX": 0,
        "offsetY": 0,
        "shade": 0.45,
        "declutter": "Minimal"
      },
      "store": "cfg_minimal"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "capture",
      "name": "look-minimal"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Configure",
      "args": {
        "enabled": false,
        "layout": "Wide",
        "scale": 1.0,
        "offsetX": 0,
        "offsetY": 0,
        "shade": 0.45,
        "declutter": "Full"
      },
      "store": "cfg_off"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "capture",
      "name": "look-board-off"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Configure",
      "args": {
        "enabled": true,
        "layout": "Wide",
        "scale": 1.0,
        "offsetX": 0,
        "offsetY": 0,
        "shade": 0.45,
        "declutter": "Full"
      },
      "store": "cfg_on"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "capture",
      "name": "look-board-on"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Configure",
      "args": {
        "enabled": true,
        "layout": "Wide",
        "pageThreat": false
      },
      "store": "cfg_systems_wide"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "capture",
      "name": "cruise-systems-wide"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Feed",
      "args": {},
      "store": "feed"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "capture",
      "name": "event-log"
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "capture",
      "name": "event-log-later"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Configure",
      "args": {
        "layout": "Stack"
      },
      "store": "cfg_systems_stack"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "capture",
      "name": "cruise-systems-stack"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Configure",
      "args": {
        "layout": "Wide",
        "pageThreat": true
      },
      "store": "cfg_threat_back"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "spawn",
      "id": "bandit",
      "type": "FS-20 Vortex",
      "faction": "Primeva",
      "at": {
        "map": [
          0,
          8000
        ]
      },
      "altitude": 3000,
      "speed": 200,
      "heading": 180
    },
    {
      "op": "wait",
      "seconds": 3
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Fire",
      "args": {},
      "store": "fire"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "capture",
      "name": "shot"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Missiles",
      "args": {},
      "store": "msl"
    },
    {
      "op": "wait",
      "seconds": 5
    },
    {
      "op": "capture",
      "name": "shot-later"
    },
    {
      "op": "wait",
      "seconds": 10
    },
    {
      "op": "capture",
      "name": "after"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Hud.Runtime.HudAutomation.Configure",
      "args": {
        "restore": true
      },
      "store": "cfg_restored"
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "alive",
      "ids": [
        "player"
      ]
    },
    {
      "check": "result_equals",
      "path": "cfg_wide.layout",
      "value": "Wide"
    },
    {
      "check": "result_equals",
      "path": "cfg_stack.layout",
      "value": "Stack"
    },
    {
      "check": "result_equals",
      "path": "cfg_scale13.offsetX",
      "value": 300
    },
    {
      "check": "result_equals",
      "path": "cfg_scale13.offsetY",
      "value": 120
    },
    {
      "check": "result_equals",
      "path": "cfg_shade0.shade",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "cfg_shade1.shade",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "cfg_lean.declutter",
      "value": "Lean"
    },
    {
      "check": "result_equals",
      "path": "cfg_minimal.declutter",
      "value": "Minimal"
    },
    {
      "check": "result_equals",
      "path": "cfg_off.enabled",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "cfg_on.enabled",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "cfg_systems_wide.pageThreat",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "cfg_threat_back.pageThreat",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "cfg_restored.saved",
      "value": false
    },
    {
      "check": "result_equals",
      "path": "feed.ok",
      "value": true
    },
    {
      "check": "result_above",
      "path": "msl.count",
      "min": 1
    },
    {
      "check": "log_match",
      "pattern": "Exception",
      "max": 0
    }
  ]
}
