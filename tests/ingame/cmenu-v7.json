{
  "name": "cmenu-v7",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 120,
  "ops": [
    {
      "op": "seat",
      "id": "player",
      "altitude": 1500,
      "speed": 200,
      "heading": 0,
      "view": "cockpit"
    },
    {
      "op": "record",
      "ids": [
        "player"
      ],
      "hz": 2
    },
    {
      "op": "wait",
      "seconds": 4
    },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Menu", "args": { "category": "weapons" }, "store": "weapons" },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Menu", "args": { "category": "lights" }, "store": "lights" },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Menu", "args": { "category": "flight" }, "store": "flight" },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Menu", "args": { "category": "wing" }, "store": "wing" },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Menu", "args": { "category": "comms" }, "store": "comms" },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Menu", "args": { "category": "radio" }, "store": "radio" },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Menu", "args": { "category": "support" }, "store": "support" },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Menu", "args": { "category": "view" }, "store": "view" },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Menu", "args": { "category": "defence" }, "store": "defence" },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Menu", "args": { "category": "targets" }, "store": "targets" },
    {
      "op": "capture",
      "name": "cockpit-hud"
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    { "check": "status_ok" },
    { "check": "alive", "ids": [ "player" ] },
    { "check": "result_above", "path": "weapons.categories", "min": 10 },
    { "check": "result_above", "path": "weapons.category_found", "min": 1 },
    { "check": "result_above", "path": "lights.category_found", "min": 1 },
    { "check": "result_above", "path": "flight.category_found", "min": 1 },
    { "check": "result_above", "path": "wing.category_found", "min": 1 },
    { "check": "result_above", "path": "comms.category_found", "min": 1 },
    { "check": "result_above", "path": "radio.category_found", "min": 1 },
    { "check": "result_above", "path": "support.category_found", "min": 1 },
    { "check": "result_above", "path": "view.category_found", "min": 1 },
    { "check": "result_above", "path": "defence.category_found", "min": 1 },
    { "check": "result_above", "path": "targets.category_found", "min": 1 },
    { "check": "result_above", "path": "flight.count", "min": 3 },
    { "check": "result_above", "path": "comms.count", "min": 4 },
    { "check": "result_above", "path": "view.count", "min": 1 },
    { "check": "result_above", "path": "defence.count", "min": 1 }
  ]
}
