{
  "name": "landing-zone",
  "description": "Landing zone: HALO stick and VG_HAMILCAR / VG_Kestrel / VG_HawcX released against a designated target fly to the zone instead; moving the zone mid-flight diverts nothing; clearing restores designated targeting; a dead launcher's zone lapses.",
  "mods": ["boscalisummer"],
  "timeout_s": 1500,
  "ops": [
    { "op": "spawn", "id": "lead", "type": "VL-49 Tarantula", "faction": "Boscali", "at": { "map": [0, 0] }, "altitude": 2000, "speed": 55, "heading": 0 },
    { "op": "spawn", "id": "bandit", "type": "FS-20 Vortex", "faction": "Primeva", "at": { "map": [0, 60000] }, "altitude": 6000, "speed": 150, "heading": 180 },
    { "op": "observe", "follow": "lead" },
    { "op": "wait", "seconds": 5 },

    { "op": "call", "method": "BoscaliSummer.Garrisons.AirborneAutomation.Step", "args": { "action": "lzfit" }, "store": "fit" },
    { "op": "wait", "seconds": 8 },
    { "op": "call", "method": "BoscaliSummer.Garrisons.AirborneAutomation.Step", "args": { "action": "lz", "do": "set", "x": 1200, "z": 3500 }, "store": "zone1" },
    { "op": "call", "method": "BoscaliSummer.Garrisons.AirborneAutomation.Step", "args": { "action": "lzdrop", "ax": -2500, "az": 3500 }, "store": "drop" },
    { "op": "wait", "seconds": 20 },
    { "op": "call", "method": "BoscaliSummer.Garrisons.AirborneAutomation.Step", "args": { "action": "lzstatus" }, "store": "glide1" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "lz", "do": "status" }, "store": "prime" },
    { "op": "call", "method": "BoscaliSummer.Garrisons.AirborneAutomation.Step", "args": { "action": "lz", "do": "set", "x": -4000, "z": 9000 }, "store": "zone2" },
    { "op": "wait", "seconds": 35 },
    { "op": "call", "method": "BoscaliSummer.Garrisons.AirborneAutomation.Step", "args": { "action": "lzstatus" }, "store": "glide2" },
    { "op": "wait", "seconds": 45 },
    { "op": "call", "method": "BoscaliSummer.Garrisons.AirborneAutomation.Step", "args": { "action": "lzstatus" }, "store": "smokeCheck" },
    { "op": "wait", "seconds": 50 },
    { "op": "call", "method": "BoscaliSummer.Garrisons.AirborneAutomation.Step", "args": { "action": "lzstatus" }, "store": "landed" },

    { "op": "spawn", "id": "jet", "type": "SFB-81 Darkreach", "faction": "Boscali", "at": { "map": [3000, -16000] }, "altitude": 9000, "speed": 200, "heading": 0 },
    { "op": "wait", "seconds": 5 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "ground", "range": 8000, "type": "HLT-L" }, "store": "target" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "lz", "do": "neartarget", "dx": 1500, "dz": 0 }, "store": "gzone" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "launch", "key": "VG_Hamilcar", "at": "ground" }, "store": "hamLaunch" },
    { "op": "wait", "seconds": 35 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "lz", "do": "status" }, "store": "hamMid" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "lz", "do": "set", "x": -6000, "z": 26000 }, "store": "gzone2" },
    { "op": "wait", "seconds": 35 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "lz", "do": "status" }, "store": "hamMoved" },
    { "op": "wait", "seconds": 240 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "hamilcar", "do": "status" }, "store": "hamDown" },

    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "lz", "do": "kill", "x": 0, "z": 0 }, "store": "kill1" },
    { "op": "spawn", "id": "jet2", "type": "SFB-81 Darkreach", "faction": "Boscali", "at": { "map": [3000, -16000] }, "altitude": 9000, "speed": 200, "heading": 0 },
    { "op": "wait", "seconds": 5 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "lz", "do": "neartarget", "dx": 1500, "dz": 0 }, "store": "kzone" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "launch", "key": "VG_Kestrel", "at": "ground" }, "store": "kesLaunch" },
    { "op": "wait", "seconds": 35 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "lz", "do": "status" }, "store": "kesOrbit" },

    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "lz", "do": "kill", "x": 0, "z": 0 }, "store": "kill2" },
    { "op": "spawn", "id": "jet3", "type": "SFB-81 Darkreach", "faction": "Boscali", "at": { "map": [3000, -16000] }, "altitude": 9000, "speed": 200, "heading": 0 },
    { "op": "wait", "seconds": 5 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "lz", "do": "neartarget", "dx": 1500, "dz": 0 }, "store": "hzone" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "launch", "key": "VG_HawcX", "at": "ground" }, "store": "hawLaunch" },
    { "op": "wait", "seconds": 10 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "lz", "do": "status" }, "store": "hawMid" },
    { "op": "wait", "seconds": 10 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "lz", "do": "status" }, "store": "hawLate" },
    { "op": "wait", "seconds": 45 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "lz", "do": "status" }, "store": "hawDown" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "status" }, "store": "vgStatus" },

    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "lz", "do": "clear" }, "store": "cleared" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "launch", "key": "VG_Hamilcar", "at": "ground" }, "store": "ham2Launch" },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "lz", "do": "kill", "x": 0, "z": 0 }, "store": "killed" },
    { "op": "wait", "seconds": 240 },
    { "op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": { "action": "hamilcar", "do": "status" }, "store": "ham2Down" },
    { "op": "end" }
  ],
  "checks": [
    { "check": "status_ok" },
    { "check": "result_above", "path": "fit.bays", "min": 0.5 },
    { "check": "result_above", "path": "fit.troops", "min": 0.5 },
    { "check": "result_above", "path": "zone1.has", "min": 0.5 },
    { "check": "result_above", "path": "drop.aboard", "min": 15 },
    { "check": "result_below", "path": "drop.left", "max": 9 },
    { "check": "result_above", "path": "glide1.jumpers", "min": 7 },
    { "check": "result_below", "path": "glide1.toZone", "max": 3000 },
    { "check": "result_above", "path": "glide1.toAim", "min": 2800 },
    { "check": "result_below", "path": "glide2.toZone", "max": 1600 },
    { "check": "result_above", "path": "smokeCheck.smoke", "min": 0.5 },
    { "check": "result_below", "path": "landed.jumpers", "max": 0.5 },
    { "check": "result_above", "path": "zone2.has", "min": 0.5 },

    { "check": "result_above", "path": "gzone.has", "min": 0.5 },
    { "check": "result_below", "path": "hamMid.aimToZone", "max": 1 },
    { "check": "result_equals", "path": "hamMid.lzCaptured", "value": 1 },
    { "check": "result_below", "path": "hamMoved.hamToProbe", "max": 7000 },
    { "check": "result_above", "path": "hamMoved.hamToZone", "min": 3500 },
    { "check": "result_above", "path": "hamDown.hamilcar.landed", "min": 1 },
    { "check": "result_above", "path": "hamDown.hamilcar.unloaded", "min": 1 },
    { "check": "result_below", "path": "hamDown.hamilcar.vehicleDist", "max": 700 },

    { "check": "result_below", "path": "kesOrbit.kestrelCentreToProbe", "max": 1 },

    { "check": "result_above", "path": "hzone.has", "min": 0.5 },
    { "check": "result_above", "path": "vgStatus.VG_HawcX_deathRange", "min": 1200 },
    { "check": "result_below", "path": "vgStatus.VG_HawcX_deathRange", "max": 1800 },

    { "check": "result_below", "path": "cleared.has", "max": 0.5 },
    { "check": "result_above", "path": "ham2Down.hamilcar.landDist", "min": 60 },
    { "check": "result_below", "path": "ham2Down.hamilcar.landDist", "max": 900 },
    { "check": "result_below", "path": "killed.has", "max": 0.5 },
    { "check": "log_match", "pattern": "NullReferenceException", "max": 0 }
  ]
}
