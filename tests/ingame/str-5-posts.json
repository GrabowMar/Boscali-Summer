{
  "name": "str-5-posts",
  "description": "STR command posts as strike targets, mission Escalation: the staff board is live with no panel open, confirmed enemy posts are feed rows with display names and global positions, the STRIKE COMMAND POST card's SubjectId is a feed row, killing the post completes the card and pays the bounty once, the respawned post pays 0, a post whose commander is away pays 0 and spends no entry. See tools/Str-Scenarios.py.",
  "mission": "Escalation",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 700,
  "environment": {
    "config": {
      "bepinex": {
        "Logging.Disk": {
          "WriteUnityLog": true
        }
      },
      "boscalisummer": {
        "HighCommand": {
          "TransfersEnabled": false,
          "PostRespawnSeconds": 10
        }
      }
    }
  },
  "ops": [
    {
      "op": "seat",
      "id": "player",
      "faction": "Boscali",
      "near": [
        -5000,
        30000
      ],
      "altitude": 9000,
      "speed": 200,
      "heading": 0
    },
    {
      "op": "fly",
      "id": "player",
      "program": [
        {
          "orbit": {
            "bank": 30,
            "seconds": 520
          }
        }
      ]
    },
    {
      "op": "wait",
      "seconds": 30
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.HighCommand.Runtime.HighCommandAutomation.Read",
      "args": {},
      "store": "h0"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.HighCommand.Runtime.HighCommandAutomation.Confirm",
      "args": {},
      "store": "cf"
    },
    {
      "op": "wait",
      "seconds": 6
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.HighCommand.Runtime.HighCommandAutomation.Read",
      "args": {},
      "store": "h1"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Command",
      "args": {
        "faction": "Boscali",
        "verb": "pick",
        "card": 0
      },
      "store": "pk"
    },
    {
      "op": "wait",
      "seconds": 35
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Open",
      "args": {
        "page": "board"
      },
      "store": "o"
    },
    {
      "op": "wait",
      "seconds": 3
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.DynamicOperations.Runtime.SortieAutomation.OfferPost",
      "args": {},
      "store": "offer"
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.DynamicOperations.Runtime.SortieAutomation.Read",
      "args": {},
      "store": "s1"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a1"
    },
    {
      "op": "capture",
      "name": "live-post-board",
      "hide_ui": false
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.HighCommand.Runtime.HighCommandAutomation.Kill",
      "args": {
        "office": -1,
        "away": false
      },
      "store": "k1"
    },
    {
      "op": "wait",
      "seconds": 5
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.HighCommand.Runtime.HighCommandAutomation.Read",
      "args": {},
      "store": "h2"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.DynamicOperations.Runtime.SortieAutomation.WingRead",
      "args": {},
      "store": "wr1"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a2"
    },
    {
      "op": "wait",
      "seconds": 15
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.HighCommand.Runtime.HighCommandAutomation.Confirm",
      "args": {},
      "store": "cf2"
    },
    {
      "op": "wait",
      "seconds": 6
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.HighCommand.Runtime.HighCommandAutomation.Read",
      "args": {},
      "store": "h3"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.HighCommand.Runtime.HighCommandAutomation.Kill",
      "args": {
        "office": -1,
        "away": false
      },
      "store": "k2"
    },
    {
      "op": "wait",
      "seconds": 3
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.HighCommand.Runtime.HighCommandAutomation.Read",
      "args": {},
      "store": "h4"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.HighCommand.Runtime.HighCommandAutomation.Kill",
      "args": {
        "office": -3,
        "away": true
      },
      "store": "k3"
    },
    {
      "op": "wait",
      "seconds": 3
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.HighCommand.Runtime.HighCommandAutomation.Read",
      "args": {},
      "store": "h5"
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_equals",
      "path": "h0.view.available",
      "value": 1
    },
    {
      "check": "result_above",
      "path": "h0.view.own",
      "min": 6
    },
    {
      "check": "result_equals",
      "path": "h0.view.enemy",
      "value": 0
    },
    {
      "check": "result_above",
      "path": "h0.view.statusLen",
      "min": 20
    },
    {
      "check": "result_equals",
      "path": "h0.host.paidTotal",
      "value": 0
    },
    {
      "check": "result_above",
      "path": "cf.confirmed",
      "min": 2
    },
    {
      "check": "result_above",
      "path": "h1.view.enemy",
      "min": 2
    },
    {
      "check": "result_equals",
      "path": "h1.view.siteIsObjectName",
      "value": 0
    },
    {
      "check": "result_above",
      "path": "h1.view.positionMatchesBuilding",
      "min": 2
    },
    {
      "check": "result_equals",
      "path": "h1.view.positionMismatch",
      "value": 0
    },
    {
      "check": "result_above",
      "path": "h1.view.bountyRows",
      "min": 2
    },
    {
      "check": "result_equals",
      "path": "h1.view.claimedRows",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "h1.view.statusLen",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "offer.made",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "offer.subjectInFeed",
      "value": 1
    },
    {
      "check": "result_above",
      "path": "offer.subject",
      "min": 0
    },
    {
      "check": "result_equals",
      "path": "offer.targetUp",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "offer.markerKnown",
      "value": 1
    },
    {
      "check": "result_above",
      "path": "offer.nameLen",
      "min": 8
    },
    {
      "check": "result_equals",
      "path": "offer.acceptedNow",
      "value": 1
    },
    {
      "check": "result_above",
      "path": "s1.sorties.cardCount",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a1.view.posts",
      "min": 2
    },
    {
      "check": "result_above",
      "path": "a1.overlay.tags.post",
      "min": 2
    },
    {
      "check": "result_equals",
      "path": "k1.ok",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "k1.disabled",
      "value": 1
    },
    {
      "check": "result_above",
      "path": "k1.paid",
      "min": 1000
    },
    {
      "check": "result_equals",
      "path": "k1.claimed",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "h2.lastPick.inFeed",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "wr1.state",
      "value": 1
    },
    {
      "check": "result_above",
      "path": "h2.host.paidTotal",
      "min": 1000
    },
    {
      "check": "result_equals",
      "path": "h3.lastPick.inFeed",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "h3.lastPick.claimed",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "h3.lastPick.bounty",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "k2.ok",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "k2.paid",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "k2.claimed",
      "value": 1
    },
    {
      "check": "result_equals",
      "path": "k3.ok",
      "value": true
    },
    {
      "check": "result_equals",
      "path": "k3.paid",
      "value": 0
    },
    {
      "check": "result_equals",
      "path": "k3.claimed",
      "value": 0
    },
    {
      "check": "log_match",
      "pattern": "Exception",
      "max": 0
    }
  ]
}
