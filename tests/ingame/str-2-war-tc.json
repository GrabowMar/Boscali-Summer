    {
      "op": "wait",
      "seconds": 22
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r7"
    },
    {
      "op": "wait",
      "seconds": 15
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r8"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Freeze",
      "args": {
        "seconds": 20
      },
      "store": "fz"
