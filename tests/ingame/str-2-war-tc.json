    {
      "op": "wait",
      "seconds": 50
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r2"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Command",
      "args": {
        "faction": "Boscali",
        "verb": "pick",
        "card": 0
      },
      "store": "p1"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r3"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Command",
      "args": {
        "faction": "Boscali",
        "verb": "pick",
        "card": 0,
        "actor": 777
