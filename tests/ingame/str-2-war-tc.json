{
  "name": "str-2-war-tc",
  "description": "STR engine proof in Terminal Control (no ground report needed): place names, first deck, staff pick that never overrides a pilot, redirect, lock, veto, command expiry, host age, an own-base DEFEND card in a full deck, focus, no faults. See tools/Str-Scenarios.py.",
  "mission": "Terminal Control",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 700,
  "environment": {
    "config": {
      "bepinex": {
        "Logging.Disk": {
          "WriteUnityLog": true
        }
      }
    }
  },
  "ops": [
    {
      "op": "seat",
      "id": "player",
      "faction": "Boscali",
      "near": [
        50000,
        15000
      ],
      "altitude": 9000,
      "speed": 200,
      "heading": 0
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.CensusProof.Read",
      "args": {},
      "store": "c0"
    },
    {
      "op": "fly",
      "id": "player",
      "program": [
        {
          "orbit": {
            "bank": 30,
            "seconds": 400
          }
        }
      ]
    },
    {
      "op": "wait",
      "seconds": 25
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r1"
    },
    {
      "op": "wait",
      "seconds": 5
    },
