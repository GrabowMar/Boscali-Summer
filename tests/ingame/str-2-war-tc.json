      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r10"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.CensusProof.Read",
      "args": {},
      "store": "c2"
    },
    {
      "op": "end"
    }
