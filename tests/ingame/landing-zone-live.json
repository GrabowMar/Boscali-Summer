{
  "name": "landing-zone-live",
  "description": "Live setup for the manual map/cue pass: player seated in a Tarantula with a fitted HALO mount, no zone yet (the zone is set by real right-clicks afterwards).",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "timeout_s": 300,
  "ops": [
    { "op": "spawn", "id": "lead", "type": "VL-49 Tarantula", "faction": "Boscali", "at": { "map": [-6000, 10000] }, "altitude": 2000, "speed": 55, "heading": 90 },
    { "op": "seat", "id": "player", "near": [-6000, 10000], "altitude": 2000, "speed": 55, "heading": 90, "view": "cockpit" },
    { "op": "wait", "seconds": 5 },
    { "op": "call", "method": "BoscaliSummer.Garrisons.AirborneAutomation.Step", "args": { "action": "lzfit" }, "store": "fit" },
    { "op": "wait", "seconds": 5 },
    { "op": "call", "method": "BoscaliSummer.Garrisons.AirborneAutomation.Step", "args": { "action": "lz", "do": "status" }, "store": "before" },
    { "op": "end" }
  ],
  "checks": [
    { "check": "status_ok" },
    { "check": "result_above", "path": "fit.troops", "min": 0.5 },
    { "check": "log_match", "pattern": "NullReferenceException", "max": 0 }
  ]
}
