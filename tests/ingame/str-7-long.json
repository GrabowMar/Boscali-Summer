{
  "name": "str-7-long",
  "description": "STR engine proof, fifteen minutes in Terminal Control: an operation ends by a condition that can happen (not the 600 s ceiling) and what a SECURED one pays equals the table and the ledger. See tools/Str-Scenarios.py.",
  "mission": "Terminal Control",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 2400,
  "environment": {
    "config": {
      "bepinex": {
        "Logging.Disk": {
          "WriteUnityLog": true
        }
      }
    }
  },
  "ops": [
    {
      "op": "seat",
      "id": "player",
      "faction": "Boscali",
      "near": [
        50000,
        15000
      ],
      "altitude": 9000,
      "speed": 200,
      "heading": 0
    },
    {
      "op": "fly",
      "id": "player",
      "program": [
        {
          "orbit": {
            "bank": 30,
            "seconds": 1000
          }
        }
      ]
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.GroundProof.Arm",
      "args": {
        "kinds": "ASSAULT,DEFEND"
      },
      "store": "arm"
    },
    {
      "op": "wait",
      "seconds": 150
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r1"
    },
    {
      "op": "wait",
      "seconds": 150
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r2"
    },
    {
      "op": "wait",
      "seconds": 150
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r3"
    },
    {
      "op": "wait",
      "seconds": 150
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r4"
    },
    {
      "op": "wait",
      "seconds": 150
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r5"
    },
    {
      "op": "wait",
      "seconds": 150
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.WarProof.Read",
      "args": {},
      "store": "r6"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.TheaterOps.Runtime.GroundProof.Read",
      "args": {},
      "store": "g"
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_above",
      "path": "r6.war.boscali.resultOutcomeSet",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "r6.war.boscali.resultWhyIsTimeLimit",
      "max": 0
    },
    {
      "check": "result_below",
      "path": "r6.war.boscali.check.rewardMismatch",
      "max": 0
    },
    {
      "check": "result_below",
      "path": "r6.war.boscali.check.rewardLedgerDelta",
      "max": 0
    },
    {
      "check": "result_below",
      "path": "r6.war.boscali.faults",
      "max": 0
    },
    {
      "check": "log_match",
      "pattern": "Exception",
      "max": 0
    }
  ]
}
