{
  "name": "ops-loops",
  "mission": "Escalation",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 1000,
  "ops": [
    { "op": "seat", "id": "player", "altitude": 1500, "speed": 180, "heading": 0 },
    { "op": "wait", "seconds": 20 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb", "store": "readiness", "args": { "verb": "readiness", "floor": 5 } },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Open", "store": "fronts", "args": { "tab": 1 } },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb", "store": "sync", "args": { "verb": "sync" } },
    { "op": "wait", "seconds": 3 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb", "store": "train_queue", "args": { "verb": "queue", "front": 2, "programme": 7 } },
    { "op": "wait", "seconds": 2 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb", "store": "train_fund1", "args": { "verb": "donate", "front": 2, "programme": 7, "amount": 10 } },
    { "op": "wait", "seconds": 2 },
    { "op": "wait", "seconds": 2 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.SoloRead", "store": "train_funded", "args": {} },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Window", "store": "orbit_open", "args": { "front": 0 } },
    { "op": "wait", "seconds": 2 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb", "store": "scan", "args": { "verb": "scan", "unit": "player" } },
    { "op": "wait", "seconds": 8 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Read", "store": "after_scan", "args": {} },
    { "op": "capture", "name": "loops_orbit" },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Window", "store": "net_open", "args": { "front": 1 } },
    { "op": "wait", "seconds": 3 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb", "store": "hop", "args": { "verb": "hop" } },
    { "op": "wait", "seconds": 15 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.SoloRead", "store": "after_hop", "args": {} },
    { "op": "capture", "name": "loops_network_held" },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Window", "store": "sof_open", "args": { "front": 2 } },
    { "op": "wait", "seconds": 150 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Read", "store": "sof_150", "args": {} },
    { "op": "wait", "seconds": 150 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Read", "store": "sof_trained", "args": {} },
    { "op": "wait", "seconds": 180 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Read", "store": "sof_ready", "args": {} },
    { "op": "capture", "name": "loops_shadow_team" },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.Verb", "store": "recon", "args": { "verb": "recon" } },
    { "op": "wait", "seconds": 10 },
    { "op": "call", "method": "BoscaliSummer.Modules.Support.Runtime.OpsAutomation.SoloRead", "store": "after_recon", "args": {} },
    { "op": "capture", "name": "loops_shadow_recon" },
    { "op": "end" }
  ],
  "checks": [
    { "check": "status_ok" },
    { "check": "result_above", "path": "train_queue.request", "min": 0.5 },
    { "check": "result_above", "path": "train_funded.spentSinceVerb", "min": 5 },
    { "check": "result_above", "path": "hop.request", "min": 0.5 },
    { "check": "result_above", "path": "sof_150.cyberMyHeld", "min": 0.5 },
    { "check": "result_above", "path": "sof_ready.sofReady", "min": 0.5 },
    { "check": "result_above", "path": "recon.request", "min": 0.5 },
    { "check": "result_above", "path": "after_recon.reconMission", "min": 0.5 },
    { "check": "result_above", "path": "after_recon.reconMine", "min": 0.5 }
  ]
}
