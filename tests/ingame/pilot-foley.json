{
  "name": "pilot-foley",
  "mods": ["boscalisummer"],
  "timeout_s": 120,
  "timescale": 1,
  "_note": "Recorded cockpit one-shots, each counted by immersionFoleyPlayed: the kneeboard page flip (through the gallery, as SQD STUDIO does), a ricochet on a bullet hit, a harness creak as the load builds, a hull thud on a warhead. The hits are real damage, so the aircraft is the worse for it.",
  "ops": [
    {"op": "atmosphere", "time_of_day": 13, "conditions": 0.1, "cloud_height": 2500, "wind_speed": 3, "wind_heading": 90, "wind_turbulence": 0.1, "moon_phase": 14},
    {"op": "seat", "id": "player", "aircraft": "FS-20 Vortex", "altitude": 4000, "speed": 200, "heading": 90, "view": "cockpit", "timeout": 30},
    {"op": "fly", "id": "player", "program": [{"level": 320}]},
    {"op": "wait", "seconds": 8},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout", "args": {}, "store": "quiet"},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Configure", "args": {"kneeboardCard": 4}, "store": "flip"},
    {"op": "wait", "seconds": 1.2},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout", "args": {}, "store": "flipped"},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.InjectHit", "args": {"pierce": 500, "blast": 0, "parts": 1}, "store": "shot"},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout", "args": {}, "store": "pinged"},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.InjectG", "args": {"g": 7, "seconds": 6}, "store": "pull"},
    {"op": "wait", "seconds": 5},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout", "args": {}, "store": "creaked"},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.InjectHit", "args": {"blast": 300, "parts": 1}, "store": "boom"},
    {"op": "wait", "seconds": 1.5},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout", "args": {}, "store": "thudded"},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Configure", "args": {"kneeboardCard": 0}, "store": "restore"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "result_below", "path": "quiet.immersionFoleyPlayed", "max": 0.5},
    {"check": "result_above", "path": "flipped.immersionFoleyPlayed", "min": 1},
    {"check": "result_below", "path": "flipped.immersionFoleyPlayed", "max": 1.5},
    {"check": "result_above", "path": "pinged.immersionFoleyPlayed", "min": 2},
    {"check": "result_below", "path": "pinged.immersionFoleyPlayed", "max": 2.5},
    {"check": "result_above", "path": "creaked.immersionFoleyPlayed", "min": 3},
    {"check": "result_above", "path": "thudded.immersionFoleyPlayed", "min": 4},
    {"check": "result_above", "path": "thudded.pilotStress", "min": 0.99}
  ]
}
