{
  "name": "weather-lattice",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 300,
  "ops": [
    {
      "op": "spawn",
      "id": "lead",
      "type": "FS-20 Vortex",
      "at": {
        "map": [
          0,
          0
        ]
      },
      "altitude": 450,
      "speed": 110,
      "heading": 0
    },
    {
      "op": "fly",
      "id": "lead",
      "program": [
        {
          "level": 120
        }
      ]
    },
    {
      "op": "observe",
      "follow": "lead"
    },
    {
      "op": "wait",
      "seconds": 20
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.PinSky",
      "store": "pin8",
      "args": {
        "sky": 8
      }
    },
    {
      "op": "wait",
      "seconds": 12
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout",
      "store": "sky8",
      "args": {
        "requireClouds": true
      }
    },
    {
      "op": "camera",
      "position": [
        0,
        500,
        0
      ],
      "heading": 30,
      "pitch": 6,
      "fov": 70
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "capture",
      "name": "lattice-08-fair-cumulus",
      "hide_ui": true
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.PinSky",
      "store": "pin17",
      "args": {
        "sky": 17
      }
    },
    {
      "op": "wait",
      "seconds": 12
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout",
      "store": "sky17",
      "args": {
        "requireClouds": true
      }
    },
    {
      "op": "camera",
      "position": [
        0,
        500,
        0
      ],
      "heading": 30,
      "pitch": 6,
      "fov": 70
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "capture",
      "name": "lattice-17-isolated-cb",
      "hide_ui": true
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.PinSky",
      "store": "pin44",
      "args": {
        "sky": 44
      }
    },
    {
      "op": "wait",
      "seconds": 12
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout",
      "store": "sky44",
      "args": {
        "requireClouds": true
      }
    },
    {
      "op": "camera",
      "position": [
        0,
        500,
        0
      ],
      "heading": 30,
      "pitch": 6,
      "fov": 70
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "capture",
      "name": "lattice-44-supercell-day",
      "hide_ui": true
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.PinSky",
      "store": "unpin",
      "args": {
        "sky": 0
      }
    },
    {
      "op": "wait",
      "seconds": 3
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout",
      "store": "after"
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_above",
      "path": "sky8.skyPin",
      "min": 7.5
    },
    {
      "check": "result_below",
      "path": "sky8.skyPin",
      "max": 8.5
    },
    {
      "check": "result_above",
      "path": "sky8.activeGroupCount",
      "min": 20
    },
    {
      "check": "result_below",
      "path": "sky8.activeCellCount",
      "max": 0.5
    },
    {
      "check": "result_above",
      "path": "sky17.skyPin",
      "min": 16.5
    },
    {
      "check": "result_below",
      "path": "sky17.skyPin",
      "max": 17.5
    },
    {
      "check": "result_above",
      "path": "sky17.activeGroupCount",
      "min": 20
    },
    {
      "check": "result_above",
      "path": "sky44.skyPin",
      "min": 43.5
    },
    {
      "check": "result_below",
      "path": "sky44.skyPin",
      "max": 44.5
    },
    {
      "check": "result_above",
      "path": "sky44.activeCellCount",
      "min": 10
    },
    {
      "check": "result_below",
      "path": "sky44.activeGroupCount",
      "max": 0.5
    },
    {
      "check": "result_below",
      "path": "after.skyPin",
      "max": 0.5
