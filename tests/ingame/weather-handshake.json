{
  "name": "weather-handshake",
  "mods": ["boscalisummer"],
  "timeout_s": 240,
  "ops": [
    {"op": "seat", "id": "player", "altitude": 1500, "speed": 180, "heading": 0, "view": "cockpit"},
    {"op": "wait", "seconds": 30},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "host"},
    {"op": "wait", "seconds": 20},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "later"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_match", "pattern": "Exception", "max": 0},
    {"check": "result_above", "path": "host.protocol", "min": 7.5},
    {"check": "result_below", "path": "host.protocol", "max": 8.5},
    {"check": "result_above", "path": "host.captured", "min": 0.5},
    {"check": "result_below", "path": "host.keySeedIsLegacy", "max": 0.5},
    {"check": "result_above", "path": "host.ownNatives", "min": 0.5},
    {"check": "result_below", "path": "host.syncSeen", "max": 0.5},
    {"check": "result_below", "path": "host.syncPending", "max": 0.5},
    {"check": "result_above", "path": "host.keySeed", "min": 0.5},
    {"check": "result_above", "path": "host.keyHeading", "min": -0.5},
    {"check": "result_below", "path": "host.keyHeading", "max": 360.5},
    {"check": "result_above", "path": "host.tapeId", "min": 0.5},
    {"check": "result_below", "path": "later.syncSeen", "max": 0.5},
    {"check": "result_above", "path": "later.ownNatives", "min": 0.5},
    {"check": "result_below", "path": "later.nativeConditions", "max": 0.6001},
    {"check": "result_below", "path": "later.sunFlips", "max": 0.5}
  ]
}
