{
  "name": "chaff",
  "_note": "The chaff dispenser on the seated player: fitted with a load, a salvo spends bundles and puts live RadarChaff in the scene, and a radar missile fired on the beam hears them (the seekers' own 'Target chaff angle' log line, counted by AceRadialAutomation.Chaff). One aircraft of each faction 30 km astern, so whichever side the player is on there is a hostile to own the missile.",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 150,
  "environment": {
    "config": {
      "bepinex": {
        "Logging.Disk": {
          "WriteUnityLog": true
        }
      }
    }
  },
  "ops": [
    { "op": "seat", "id": "player", "altitude": 6000, "speed": 220, "heading": 0, "view": "orbit" },
    { "op": "spawn", "id": "owner1", "type": "CI-22 Cricket", "faction": "Primeva", "at": { "near": { "id": "player", "offset": [0, 0, 30000] } }, "speed": 140 },
    { "op": "spawn", "id": "owner2", "type": "CI-22 Cricket", "faction": "Boscali", "at": { "near": { "id": "player", "offset": [3000, 0, 30000] } }, "speed": 140 },
    { "op": "record", "ids": ["player"], "hz": 2 },
    { "op": "wait", "seconds": 7 },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Chaff", "args": { "action": "status" }, "store": "fit" },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Menu", "args": { "category": "defence" }, "store": "defence" },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Menu", "args": { "category": "targets" }, "store": "targets" },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Menu", "args": { "category": "weapons" }, "store": "weapons" },
    { "op": "mark", "text": "one salvo: bundles leave, ammo drops" },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Chaff", "args": { "action": "pop" }, "store": "pop" },
    { "op": "wait", "seconds": 0.7 },
    { "op": "capture", "name": "chaff-salvo" },
    { "op": "wait", "seconds": 0.8 },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Chaff", "args": { "action": "status" }, "store": "popped" },
    { "op": "mark", "text": "a radar missile from 7 km on the beam; salvos while it flies in" },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Chaff", "args": { "action": "threat", "range": 7000 }, "store": "threat" },
    { "op": "wait", "seconds": 3 },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Chaff", "args": { "action": "pop" }, "store": "pop2" },
    { "op": "wait", "seconds": 1.5 },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Chaff", "args": { "action": "pop" }, "store": "pop3" },
    { "op": "wait", "seconds": 1.5 },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Chaff", "args": { "action": "pop" }, "store": "pop4" },
    { "op": "wait", "seconds": 1.5 },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Chaff", "args": { "action": "pop" }, "store": "pop5" },
    { "op": "wait", "seconds": 8 },
    { "op": "call", "method": "BoscaliSummer.Modules.Autopilot.Runtime.AceRadialAutomation.Chaff", "args": { "action": "status" }, "store": "end" },
    { "op": "end" }
  ],
  "checks": [
    { "check": "status_ok" },
    { "check": "result_above", "path": "fit.fitted", "min": 1 },
    { "check": "result_above", "path": "fit.ammo", "min": 24 },
    { "check": "result_above", "path": "defence.count", "min": 3 },
    { "check": "result_above", "path": "popped.bundles", "min": 1 },
    { "check": "result_above", "path": "end.heard", "min": 1 },
    { "check": "result_above", "path": "end.threatsGone", "min": 1 },
    { "check": "result_above", "path": "end.seduced", "min": 1 },
    { "check": "log_match", "pattern": "ChaffDispenser|chaff dispenser not fitted", "max": 0 }
  ]
}
