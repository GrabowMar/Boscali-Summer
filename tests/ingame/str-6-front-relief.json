      "hide_ui": false
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Focus",
      "args": {
        "kind": "effort"
      },
      "store": "f2"
    },
    {
      "op": "wait",
      "seconds": 6
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a5"
    },
    {
      "op": "wait",
      "seconds": 20
