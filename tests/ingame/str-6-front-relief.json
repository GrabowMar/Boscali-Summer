{
  "name": "str-6-front-relief",
  "description": "STR slice U4 live proof on the relief map, mission Terminal Control: the Station Board panel plumbing of U2 and U3 plus the map overlay of U4: the overlay draws a tag per proposal and front (overlay.tags), a raycast at a tag and at the first friendly airbase icon hits the right thing (Probe, ProbeAt), a click on a tag selects it and opens the card, and the card's primary button picks the proposal through the hub (Press map.card.primary) and the effort goes live; the overlay's cost stays inside the budget. Sorties (pres-sortie), redirect, wing, stale and held-wave blocks wait for the sorties, wing and wave work of S7 and S10. Absorbs str-6-front-plumbing-relief. The pick lock and picker name (lockSeconds 60..121, pickedByLocal) belong to the engine slice S4 and are asserted there.",
  "mission": "Terminal Control",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 390,
  "environment": {
    "config": {
      "bepinex": {
        "Logging.Disk": {
          "WriteUnityLog": true
        }
      }
    }
  },
  "ops": [
    {
      "op": "seat",
      "id": "player",
      "faction": "Boscali",
      "near": [
        50000,
        15000
      ],
      "altitude": 9000,
      "speed": 200,
      "heading": 0
    },
    {
      "op": "fly",
      "id": "player",
      "program": [
        {
          "orbit": {
            "bank": 30,
            "seconds": 540
          }
        }
      ]
    },
    {
      "op": "wait",
      "seconds": 20
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Open",
      "args": {
        "page": "board"
      },
      "store": "o0"
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a0"
    },
    {
      "op": "wait",
      "seconds": 60
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a1"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.ProbeAt",
      "args": {
        "kind": "airbase",
        "n": 1
      },
      "store": "pa"
    },
    {
      "op": "capture",
      "name": "str-overlay-proposals",
      "hide_ui": false
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Press",
      "args": {
        "id": "tab.sitrep"
      },
      "store": "t1"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a1s"
    },
    {
      "op": "capture",
      "name": "str-sitrep",
      "hide_ui": false
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Press",
      "args": {
        "id": "tab.info"
      },
      "store": "t2"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a1l"
    },
    {
      "op": "capture",
      "name": "str-info",
      "hide_ui": false
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Press",
      "args": {
        "id": "tab.board"
      },
      "store": "t3"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Focus",
      "args": {
        "kind": "proposal",
        "index": 1
      },
      "store": "f1"
    },
    {
      "op": "wait",
      "seconds": 6
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
