{
  "name": "pilot-immersion",
  "mods": ["boscalisummer"],
  "timeout_s": 330,
  "timescale": 1,
  "_note": "Cockpit pilot immersion acceptance, then an interleaved per-feature perf A/B after warm-up (frame time via perf_window, per-effect CPU via fxMs.* in the readouts). Scripted sim flight hides the vanilla HUD, so the visor is told to ignore it. InjectG drives the vanilla-equation fallback; vanilla GLOC reads are verified at cruise.",
  "ops": [
    {"op": "atmosphere", "time_of_day": 13, "conditions": 0.1, "cloud_height": 2500, "wind_speed": 3, "wind_heading": 90, "wind_turbulence": 0.1, "moon_phase": 14},
    {"op": "seat", "id": "player", "aircraft": "FS-20 Vortex", "altitude": 4000, "speed": 200, "heading": 90, "view": "cockpit", "timeout": 30},
    {"op": "fly", "id": "player", "program": [{"level": 320}]},
    {"op": "wait", "seconds": 6},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Configure", "args": {"visorIgnoreHud": true}, "store": "visor_forced"},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout", "args": {}, "store": "cruise"},
    {"op": "capture", "name": "pilot-cruise", "hide_ui": false},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Look", "args": {"pitch": 52, "yaw": 0, "seconds": 4}, "store": "look_down"},
    {"op": "wait", "seconds": 1.5},
    {"op": "capture", "name": "pilot-body-down", "hide_ui": false},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Look", "args": {"pitch": 48, "yaw": -32, "seconds": 4}, "store": "look_left"},
    {"op": "wait", "seconds": 1.5},
    {"op": "capture", "name": "pilot-kneeboard", "hide_ui": false},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Configure", "args": {"kneeboardCard": 4}, "store": "card_duck"},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Look", "args": {"pitch": 48, "yaw": -32, "seconds": 4}, "store": "look_left2"},
    {"op": "wait", "seconds": 1.5},
    {"op": "capture", "name": "pilot-kneeboard-picture", "hide_ui": false},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Configure", "args": {"kneeboardCard": 0}, "store": "card_mission"},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Configure", "args": {"kneeboardRefresh": true}, "store": "kneeboard_refresh"},
    {"op": "wait", "seconds": 12},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout", "args": {}, "store": "cruise_later"},

    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.InjectG", "args": {"g": 7, "seconds": 12}, "store": "inject7"},
    {"op": "wait", "seconds": 5},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout", "args": {}, "store": "strain"},
    {"op": "capture", "name": "pilot-strain", "hide_ui": false},
    {"op": "wait", "seconds": 8},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.InjectG", "args": {"g": 9.5, "seconds": 20}, "store": "inject95"},
    {"op": "wait", "seconds": 7},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout", "args": {}, "store": "greyout"},
    {"op": "capture", "name": "pilot-greyout", "hide_ui": false},
    {"op": "wait", "seconds": 16},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout", "args": {}, "store": "after"},

    {"op": "perf_window", "store": "perf_on_1", "seconds": 12, "warmup": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.SetEnabled", "args": {"enabled": false}, "store": "off1"},
    {"op": "perf_window", "store": "perf_off_1", "seconds": 12, "warmup": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.SetEnabled", "args": {"enabled": true}, "store": "on2"},
    {"op": "perf_window", "store": "perf_on_2", "seconds": 12, "warmup": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.SetEnabled", "args": {"enabled": false}, "store": "off2"},
    {"op": "perf_window", "store": "perf_off_2", "seconds": 12, "warmup": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.SetEnabled", "args": {"enabled": true}, "store": "on3"},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Configure", "args": {"reflection": false}, "store": "norefl1"},
    {"op": "perf_window", "store": "perf_norefl_1", "seconds": 12, "warmup": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Configure", "args": {"reflection": true}, "store": "refl1"},
    {"op": "perf_window", "store": "perf_on_3", "seconds": 12, "warmup": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Configure", "args": {"reflection": false}, "store": "norefl2"},
    {"op": "perf_window", "store": "perf_norefl_2", "seconds": 12, "warmup": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Configure", "args": {"reflection": true}, "store": "refl2"},
    {"op": "perf_window", "store": "perf_on_4", "seconds": 12, "warmup": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Immersion.Runtime.ImmersionAutomation.Readout", "args": {}, "store": "final"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "result_above", "path": "cruise.pilotVanillaGloc", "min": 1},
    {"check": "result_above", "path": "cruise.pilotBodyBound", "min": 1},
    {"check": "result_above", "path": "cruise.pilotOwnedTextures", "min": 1},
    {"check": "result_above", "path": "cruise.pilotShadowsAvailable", "min": 1},
    {"check": "result_above", "path": "cruise.kneeboardBound", "min": 1},
    {"check": "result_above", "path": "cruise_later.kneeboardRenders", "min": 2},
    {"check": "result_below", "path": "cruise_later.kneeboardRenderMs", "max": 2},
    {"check": "result_below", "path": "cruise.pilotStickGripErrorMetres", "max": 0.01},
    {"check": "result_below", "path": "cruise.pilotExertion", "max": 0.15},
    {"check": "result_above", "path": "cruise.visorVisible", "min": 1},
    {"check": "result_above", "path": "cruise_later.immersionBreathPlayed", "min": 4},
    {"check": "result_above", "path": "cruise_later.immersionRecordedVoices", "min": 9},
    {"check": "result_above", "path": "strain.pilotStraining", "min": 1},
    {"check": "result_above", "path": "greyout.pilotGreyout", "min": 0.2},
    {"check": "result_above", "path": "greyout.visorBrow", "min": 0.2},
    {"check": "result_above", "path": "greyout.visorVisible", "min": 1}
  ]
}
