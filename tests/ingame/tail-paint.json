{
  "name": "tail-paint",
  "mods": ["boscalisummer"],
  "timeout_s": 330,
  "timescale": 1,
  "_note": "Squadron insignia on the tail fin: the bake lands on the player's aircraft, is packed to the livery's own format (the 22 MB working copy becomes a stock-sized one), both finishes, and strips cleanly; frame time is sampled interleaved with the paint off and on (the paint adds no renderer and no per-frame work, so the windows should be indistinguishable). The FS-20's fin faces share one mirrored UV island, so its paint leaves the squadron number off. The automation overrides never touch the player's saved config. Close-ups are written to BepInEx/cache/BoscaliSummer/tailpaint-*.png by a throwaway camera.",
  "ops": [
    {"op": "atmosphere", "time_of_day": 13, "conditions": 0.1, "cloud_height": 2500, "wind_speed": 3, "wind_heading": 90, "wind_turbulence": 0.1, "moon_phase": 14},
    {"op": "seat", "id": "player", "aircraft": "FS-20 Vortex", "altitude": 3000, "speed": 200, "heading": 90, "view": "orbit", "timeout": 30},
    {"op": "fly", "id": "player", "program": [{"level": 320}]},
    {"op": "wait", "seconds": 6},
    {"op": "call", "method": "BoscaliSummer.Modules.Progression.Visuals.TailPaintAutomation.Configure", "args": {"mode": "Off"}, "store": "plain"},
    {"op": "wait", "seconds": 2},
    {"op": "perf_window", "store": "perf_off_1", "seconds": 10, "warmup": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Progression.Visuals.TailPaintAutomation.Configure", "args": {"mode": "Colour", "emblem": "1.3.1.3.2.5.0.42"}, "store": "configured"},
    {"op": "wait", "seconds": 7},
    {"op": "call", "method": "BoscaliSummer.Modules.Progression.Visuals.TailPaintAutomation.Readout", "args": {}, "store": "painted"},
    {"op": "capture", "name": "tail-paint-orbit", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Progression.Visuals.TailPaintAutomation.Capture", "args": {"name": "colour-outboard", "side": 1, "distance": 7}, "store": "shot_outboard"},
    {"op": "call", "method": "BoscaliSummer.Modules.Progression.Visuals.TailPaintAutomation.Capture", "args": {"name": "colour-inboard", "side": -1, "distance": 7}, "store": "shot_inboard"},
    {"op": "call", "method": "BoscaliSummer.Modules.Progression.Visuals.TailPaintAutomation.Capture", "args": {"name": "colour-far", "side": 1, "distance": 28}, "store": "shot_far"},
    {"op": "perf_window", "store": "perf_on_1", "seconds": 10, "warmup": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Progression.Visuals.TailPaintAutomation.Configure", "args": {"mode": "LowVis"}, "store": "lowvis_set"},
    {"op": "wait", "seconds": 7},
    {"op": "call", "method": "BoscaliSummer.Modules.Progression.Visuals.TailPaintAutomation.Capture", "args": {"name": "lowvis-outboard", "side": 1, "distance": 7}, "store": "shot_lowvis"},
    {"op": "call", "method": "BoscaliSummer.Modules.Progression.Visuals.TailPaintAutomation.Configure", "args": {"mode": "Off"}, "store": "off_set"},
    {"op": "wait", "seconds": 7},
    {"op": "call", "method": "BoscaliSummer.Modules.Progression.Visuals.TailPaintAutomation.Capture", "args": {"name": "plain-outboard", "side": 1, "distance": 7}, "store": "stripped"},
    {"op": "perf_window", "store": "perf_off_2", "seconds": 10, "warmup": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Progression.Visuals.TailPaintAutomation.Configure", "args": {"mode": "Colour"}, "store": "colour_again"},
    {"op": "wait", "seconds": 7},
    {"op": "perf_window", "store": "perf_on_2", "seconds": 10, "warmup": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Progression.Visuals.TailPaintAutomation.Readout", "args": {}, "store": "final"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "result_above", "path": "painted.shader", "min": 1},
    {"check": "result_above", "path": "painted.aircraftPainted", "min": 1},
    {"check": "result_above", "path": "painted.coats", "min": 1},
    {"check": "result_above", "path": "painted.coatsPacked", "min": 1},
    {"check": "result_above", "path": "painted.numberLeftOff", "min": 1},
    {"check": "result_below", "path": "painted.lastBakeMs", "max": 50},
    {"check": "result_below", "path": "painted.coatBytes", "max": 6000000},
    {"check": "result_below", "path": "stripped.aircraftPainted", "max": 0.5},
    {"check": "result_below", "path": "stripped.coats", "max": 0.5},
    {"check": "result_above", "path": "final.aircraftPainted", "min": 1},
    {"check": "result_above", "path": "final.coatsPacked", "min": 1},
    {"check": "result_above", "path": "final.bakes", "min": 3},
    {"check": "result_above", "path": "final.packs", "min": 3}
  ]
}
