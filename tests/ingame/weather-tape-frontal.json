{
  "name": "weather-tape-frontal",
  "mods": ["boscalisummer"],
  "timeout_s": 420,
  "ops": [
    {"op": "seat", "id": "player", "altitude": 1500, "speed": 180, "heading": 0, "view": "cockpit"},
    {"op": "wait", "seconds": 20},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.ForceWeather", "store": "enter", "args": {"regime": "Fair", "seed": 20260918, "modelAge": 0}},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.SetFixtureTape", "store": "t0", "args": {"seed": 20260918, "story": 0, "offsetKm": 0, "dynamic": false}},
    {"op": "wait", "seconds": 25},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "r0"},
    {"op": "capture", "name": "frontal-0"},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.SetFixtureTape", "store": "t150", "args": {"seed": 20260918, "story": 0, "offsetKm": 150, "dynamic": false}},
    {"op": "wait", "seconds": 25},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "r150"},
    {"op": "capture", "name": "frontal-150"},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.SetFixtureTape", "store": "t215", "args": {"seed": 20260918, "story": 0, "offsetKm": 215, "dynamic": false}},
    {"op": "wait", "seconds": 25},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "r215"},
    {"op": "capture", "name": "frontal-215"},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.SetFixtureTape", "store": "t250", "args": {"seed": 20260918, "story": 0, "offsetKm": 250, "dynamic": false}},
    {"op": "wait", "seconds": 25},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "r250"},
    {"op": "capture", "name": "frontal-250"},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.SetFixtureTape", "store": "t300", "args": {"seed": 20260918, "story": 0, "offsetKm": 300, "dynamic": false}},
    {"op": "wait", "seconds": 25},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "r300"},
    {"op": "capture", "name": "frontal-300"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_match", "pattern": "Exception", "max": 0},
    {"check": "result_below", "path": "r0.keyDynamic", "max": 0.5},
    {"check": "result_above", "path": "r0.markerCount", "min": 0.5},
    {"check": "result_below", "path": "r0.nativeConditions", "max": 0.6001},
    {"check": "result_below", "path": "r0.sunFlips", "max": 0.5},
    {"check": "result_below", "path": "r150.keyDynamic", "max": 0.5},
    {"check": "result_above", "path": "r150.markerCount", "min": 0.5},
    {"check": "result_below", "path": "r150.nativeConditions", "max": 0.6001},
    {"check": "result_below", "path": "r150.sunFlips", "max": 0.5},
    {"check": "result_below", "path": "r215.keyDynamic", "max": 0.5},
    {"check": "result_above", "path": "r215.markerCount", "min": 0.5},
    {"check": "result_below", "path": "r215.nativeConditions", "max": 0.6001},
    {"check": "result_below", "path": "r215.sunFlips", "max": 0.5},
    {"check": "result_below", "path": "r250.keyDynamic", "max": 0.5},
    {"check": "result_above", "path": "r250.markerCount", "min": 0.5},
    {"check": "result_below", "path": "r250.nativeConditions", "max": 0.6001},
    {"check": "result_below", "path": "r250.sunFlips", "max": 0.5},
    {"check": "result_below", "path": "r300.keyDynamic", "max": 0.5},
    {"check": "result_above", "path": "r300.markerCount", "min": 0.5},
    {"check": "result_below", "path": "r300.nativeConditions", "max": 0.6001},
    {"check": "result_below", "path": "r300.sunFlips", "max": 0.5}
  ]
