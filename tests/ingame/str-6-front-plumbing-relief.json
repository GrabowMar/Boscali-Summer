{
  "name": "str-6-front-plumbing-relief",
  "description": "STR slice U2 live proof of the plumbing (hub, reader, verbs, MapFocus) on the relief map, mission Terminal Control: the model equals the host snapshot, a select flies the map to the item, a posture and a pick go out through the hub. Since U3 it presses by control id (StrAutomation.Press) and walks the three tabs; absorbed by str-6-front-relief when the overlay lands.",
  "mission": "Terminal Control",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 330,
  "environment": {
    "config": {
      "bepinex": {
        "Logging.Disk": {
          "WriteUnityLog": true
        }
      }
    }
  },
  "ops": [
    {
      "op": "seat",
      "id": "player",
      "faction": "Boscali",
      "near": [
        50000,
        15000
      ],
      "altitude": 9000,
      "speed": 200,
      "heading": 0
    },
    {
      "op": "fly",
      "id": "player",
      "program": [
        {
          "orbit": {
            "bank": 30,
            "seconds": 540
          }
        }
      ]
    },
    {
      "op": "wait",
      "seconds": 20
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Open",
      "args": {
        "page": "board"
      },
      "store": "o0"
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a0"
    },
    {
      "op": "wait",
      "seconds": 60
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a1"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Press",
      "args": {
        "id": "tab.sitrep"
      },
      "store": "t1"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a1s"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Press",
      "args": {
        "id": "tab.log"
      },
      "store": "t2"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a1l"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Press",
      "args": {
        "id": "tab.board"
      },
      "store": "t3"
    },
    {
      "op": "wait",
      "seconds": 1
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Focus",
      "args": {
        "kind": "proposal",
        "index": 1
      },
      "store": "f1"
    },
    {
      "op": "wait",
      "seconds": 6
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a2"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Press",
      "args": {
        "id": "posture.bold"
      },
      "store": "p1"
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a3"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Press",
      "args": {
        "id": "prop.1.pick"
      },
      "store": "k1"
    },
    {
      "op": "wait",
      "seconds": 6
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a4"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Focus",
      "args": {
        "kind": "effort"
      },
      "store": "f2"
    },
    {
      "op": "wait",
      "seconds": 6
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.StrAutomation.Read",
      "args": {},
      "store": "a5"
    },
    {
      "op": "wait",
      "seconds": 2
    },
    {
      "op": "end"
    }
  ],
  "checks": [
    {
      "check": "status_ok"
    },
    {
      "check": "result_equals",
      "path": "a0.hub",
      "value": true
    },
    {
      "check": "result_above",
      "path": "a0.view.revision",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a1.view.fronts",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "a1.check.frontsDelta",
      "max": 0
    },
    {
      "check": "result_above",
      "path": "a1.view.proposals",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "a1.check.proposalsDelta",
      "max": 0
    },
    {
      "check": "result_equals",
      "path": "f1.ok",
      "value": true
    },
    {
      "check": "result_above",
      "path": "a2.link.selectedKind",
      "min": 2
    },
    {
      "check": "result_above",
      "path": "a2.map.focusOffset",
      "min": 0
    },
    {
      "check": "result_below",
      "path": "a2.map.focusOffset",
      "max": 0.08
    },
    {
      "check": "result_below",
      "path": "a2.map.flat",
      "max": 0
    },
    {
      "check": "result_above",
      "path": "p1.pressed",
      "min": 1
    },
    {
      "check": "result_equals",
      "path": "a3.view.posture",
      "value": 2
    },
    {
      "check": "result_above",
      "path": "k1.pressed",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a4.view.effort.live",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "a4.check.effortDelta",
      "max": 0
    },
    {
      "check": "result_above",
      "path": "a4.view.effort.idChanges",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a5.map.focusOffset",
      "min": 0
    },
    {
      "check": "result_below",
      "path": "a5.map.focusOffset",
      "max": 0.08
    },
    {
      "check": "result_above",
      "path": "a0.panel.present",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a0.panel.screenActive",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a1.view.ageSeconds",
      "min": 0
    },
    {
      "check": "result_below",
      "path": "a1.view.ageSeconds",
      "max": 15
    },
    {
      "check": "result_above",
      "path": "t1.ok",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "a1s.panel.page",
      "min": 1
    },
    {
      "check": "result_below",
      "path": "a1s.panel.page",
      "max": 1
    },
    {
      "check": "result_above",
      "path": "a1l.panel.page",
      "min": 2
    },
    {
      "check": "result_above",
      "path": "t3.ok",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "p1.ok",
      "min": 1
    },
    {
      "check": "result_above",
      "path": "k1.ok",
      "min": 1
    },
    {
      "check": "log_match",
      "pattern": "Exception",
      "max": 0
    }
  ]
}
