{
  "name": "weather-console-tape",
  "mods": ["boscalisummer"],
  "timeout_s": 360,
  "ops": [
    {"op": "seat", "id": "player", "altitude": 1500, "speed": 180, "heading": 0, "view": "cockpit"},
    {"op": "wait", "seconds": 20},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "settled", "args": {"action": "settle"}},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "opened", "args": {"action": "open"}},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "next1", "args": {"action": "press", "control": "StoryNext"}},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "next2", "args": {"action": "press", "control": "StoryNext"}},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "prev", "args": {"action": "press", "control": "StoryPrev"}},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "tapeStory"},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "auto", "args": {"action": "press", "control": "StoryAuto"}},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "reroll", "args": {"action": "press", "control": "Reroll"}},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "squall", "args": {"action": "press", "control": "ScenSquall"}},
    {"op": "wait", "seconds": 5},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "squallTape"},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "front5", "args": {"action": "press", "control": "Front5"}},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "reset", "args": {"action": "press", "control": "ScenReset"}},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "closed", "args": {"action": "close"}},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_match", "pattern": "Exception", "max": 0},
    {"check": "result_above", "path": "settled.settled", "min": 0.5},
    {"check": "result_above", "path": "opened.open", "min": 0.5},
    {"check": "result_above", "path": "next1.pressed", "min": 0.5},
    {"check": "result_above", "path": "next1.story", "min": 0.5},
    {"check": "result_below", "path": "next1.story", "max": 1.5},
    {"check": "result_above", "path": "next2.story", "min": 1.5},
    {"check": "result_below", "path": "next2.story", "max": 2.5},
    {"check": "result_above", "path": "prev.story", "min": 0.5},
    {"check": "result_below", "path": "prev.story", "max": 1.5},
    {"check": "result_above", "path": "tapeStory.markerCount", "min": -0.5},
    {"check": "result_above", "path": "auto.pressed", "min": 0.5},
    {"check": "result_above", "path": "auto.story", "min": -0.5},
    {"check": "result_below", "path": "auto.story", "max": 0.5},
    {"check": "result_above", "path": "reroll.pressed", "min": 0.5},
    {"check": "result_above", "path": "reroll.salt", "min": 0.5},
    {"check": "result_above", "path": "squall.story", "min": 1.5},
    {"check": "result_below", "path": "squall.story", "max": 2.5},
    {"check": "result_above", "path": "squall.sets", "min": 2.5},
    {"check": "result_below", "path": "squall.sets", "max": 3.5},
    {"check": "result_above", "path": "squallTape.markerCount", "min": 0.5},
    {"check": "result_below", "path": "front5.pressed", "max": 0.5},
    {"check": "result_above", "path": "reset.story", "min": -0.5},
    {"check": "result_below", "path": "reset.story", "max": 0.5},
    {"check": "result_above", "path": "reset.sets", "min": -0.5},
    {"check": "result_below", "path": "reset.sets", "max": 0.5},
    {"check": "result_above", "path": "reset.running", "min": 0.5},
    {"check": "result_below", "path": "closed.open", "max": 0.5}
  ]
}
