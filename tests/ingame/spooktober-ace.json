{
  "name": "spooktober-ace",
  "_note": "Task 9: the FALLEN ACE on GHOST. Spawned over open sea 8 km ahead of the seated FS-20 (220 m/s, level), its only prey; two minutes of fighting (moods, blinks, tracks, damage dealt read from Unit.damageCredit), then a solid hull hit (blink) and three lethal wounds through the game's Pilot.TakeDamage (a refused bail-out between): lives 3 -> 2 -> 1 -> defeated, chain 1 -> 2. Then a faked remote join evicts a fresh ace and GHOST and refuses the next spawn. Ends with reset (the progress entry is real).",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 600,
  "environment": {
    "config": {
      "bepinex": {
        "Logging.Disk": {
          "WriteUnityLog": true
        }
      }
    }
  },
  "ops": [
    {
      "op": "seat",
      "id": "player",
      "faction": "Boscali",
      "aircraft": "FS-20 Vortex",
      "near": [
        50000,
        0
      ],
      "altitude": 5000,
      "speed": 220,
      "heading": 90
    },
    {
      "op": "fly",
      "id": "player",
      "program": [
        {
          "level": 900
        }
      ]
    },
    {
      "op": "record",
      "ids": [
        "player",
        "ace"
      ],
      "hz": 2
    },
    {
      "op": "wait",
      "seconds": 5
    },
    {
      "op": "mark",
      "text": "chain: menu unlocked, the kaiju recorded as beaten, so the ace's defeat moves the chain to 2"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "reset"
      },
      "store": "fresh"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "solve",
        "puzzle": "all"
      },
      "store": "solved"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "defeat",
        "boss": "Kaiju"
      },
      "store": "kaiju"
    },
    {
      "op": "mark",
      "text": "over open sea east of the island: FALLEN ACE 8 km ahead of the player, nose on; the player's FS-20 is its only prey"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "spawn",
        "boss": "FallenAce"
      },
      "store": "spawn"
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "ace_status"
      },
      "store": "s0"
    },
    {
      "op": "wait",
      "seconds": 30
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "ace_status"
      },
      "store": "s1"
    },
    {
      "op": "wait",
      "seconds": 30
    },
    {
      "op": "call",
      "method": "BoscaliSummer.Spooktober.SpooktoberAutomation.Step",
      "args": {
        "action": "ace_status"
      },
      "store": "s2"
