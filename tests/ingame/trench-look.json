{
  "name": "trench-look",
  "description": "Trench look and logic, live on Escalation. Lets the front dig, then captures the first position from a bay close-up, a wide crest view, its far end (nearest-station LOD must read LOD0 there) and a low pass, with status snapshots carrying LOD, camera distance and terrain tint. Then marks the line cut off while the field still reads it as owned, so the relief path must bring it back within ~30s, and runs on long enough for an exhausted front to rescan (the overlap refusal logs ride on that rescan). Read the captures and grep bepinex.log for relieved / rescanning / lies along.",
  "mission": "Escalation",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 720,
  "environment": {
    "config": {
      "bepinex": {
        "Logging.Disk": {
          "WriteUnityLog": true
        }
      }
    }
  },
  "ops": [
    { "op": "spawn", "id": "eye", "type": "UH-90 Ibis", "faction": "Boscali", "at": { "map": [0, 0] }, "altitude": 9000, "speed": 60, "heading": 0 },
    { "op": "observe", "follow": "eye" },
    { "op": "wait", "seconds": 150 },
    { "op": "call", "method": "BoscaliSummer.Modules.Trenches.Runtime.TrenchAutomation.Step", "args": { "action": "status" }, "store": "dug" },

    { "op": "call", "method": "BoscaliSummer.Modules.Trenches.Runtime.TrenchAutomation.Step", "args": { "action": "view", "line": 0, "along": 0.5, "distance": 12, "height": 3 }, "store": "view_bay" },
    { "op": "wait", "seconds": 4 },
    { "op": "capture", "name": "trench-bay", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Modules.Trenches.Runtime.TrenchAutomation.Step", "args": { "action": "view", "line": 0, "along": 0.45, "distance": 45, "height": 14 }, "store": "view_wide" },
    { "op": "wait", "seconds": 3 },
    { "op": "capture", "name": "trench-wide", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Modules.Trenches.Runtime.TrenchAutomation.Step", "args": { "action": "view", "line": 0, "along": 0.0, "distance": 10, "height": 3 }, "store": "view_end" },
    { "op": "wait", "seconds": 3 },
    { "op": "call", "method": "BoscaliSummer.Modules.Trenches.Runtime.TrenchAutomation.Step", "args": { "action": "status" }, "store": "at_end" },
    { "op": "capture", "name": "trench-end", "hide_ui": true },
    { "op": "call", "method": "BoscaliSummer.Modules.Trenches.Runtime.TrenchAutomation.Step", "args": { "action": "view", "line": 0, "along": 0.5, "distance": 420, "height": 160 }, "store": "view_pass" },
    { "op": "wait", "seconds": 3 },
    { "op": "capture", "name": "trench-low-pass", "hide_ui": true },

    { "op": "call", "method": "BoscaliSummer.Modules.Trenches.Runtime.TrenchAutomation.Step", "args": { "action": "cutoff", "line": 0 }, "store": "cutoff" },
    { "op": "wait", "seconds": 45 },
    { "op": "call", "method": "BoscaliSummer.Modules.Trenches.Runtime.TrenchAutomation.Step", "args": { "action": "status" }, "store": "after_relief" },

    { "op": "wait", "seconds": 300 },
    { "op": "call", "method": "BoscaliSummer.Modules.Trenches.Runtime.TrenchAutomation.Step", "args": { "action": "status" }, "store": "late" },
    { "op": "call", "method": "BoscaliSummer.Modules.Trenches.Runtime.TrenchAutomation.Step", "args": { "action": "view", "line": 0, "along": 0.3, "distance": 12, "height": 3 }, "store": "view_late" },
    { "op": "wait", "seconds": 4 },
    { "op": "capture", "name": "trench-bay-late", "hide_ui": true },
    { "op": "end" }
  ]
}
