{
  "name": "weather-settings",
  "mods": ["boscalisummer"],
  "timeout_s": 420,
  "ops": [
    {"op": "seat", "id": "player", "altitude": 1500, "speed": 180, "heading": 0, "view": "cockpit"},
    {"op": "wait", "seconds": 20},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "settled", "args": {"action": "settle"}},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "start"},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "held", "args": {"action": "press", "control": "Hold"}},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "afterHold"},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "paced1", "args": {"action": "press", "control": "PaceUp"}},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "paced2", "args": {"action": "press", "control": "PaceUp"}},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "afterPace"},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "resumed", "args": {"action": "press", "control": "Hold"}},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "afterResume"},
    {"op": "wait", "seconds": 65},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "idle"},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Console", "store": "back", "args": {"action": "settle"}},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "end"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_match", "pattern": "Exception", "max": 0},
    {"check": "result_above", "path": "settled.settled", "min": 0.5},
    {"check": "result_above", "path": "start.settingsPace", "min": 2.5},
    {"check": "result_below", "path": "start.settingsPace", "max": 3.5},
    {"check": "result_above", "path": "start.settingsTapeMoves", "min": 0.5},
    {"check": "result_above", "path": "start.keyDynamic", "min": 0.5},
    {"check": "result_below", "path": "held.running", "max": 0.5},
    {"check": "result_below", "path": "afterHold.settingsTapeMoves", "max": 0.5},
    {"check": "result_below", "path": "afterHold.keyDynamic", "max": 0.5},
    {"check": "result_above", "path": "afterPace.settingsPace", "min": 4.5},
    {"check": "result_below", "path": "afterPace.settingsPace", "max": 5.5},
    {"check": "result_above", "path": "afterPace.keySpeed", "min": 29},
    {"check": "result_below", "path": "afterPace.keySpeed", "max": 45.1},
    {"check": "result_above", "path": "resumed.running", "min": 0.5},
    {"check": "result_above", "path": "afterResume.settingsTapeMoves", "min": 0.5},
    {"check": "result_above", "path": "afterResume.keyDynamic", "min": 0.5},
    {"check": "result_above", "path": "idle.settingsPace", "min": 4.5},
    {"check": "result_below", "path": "idle.settingsPace", "max": 5.5},
    {"check": "result_above", "path": "idle.keyDynamic", "min": 0.5},
    {"check": "result_above", "path": "end.settingsPace", "min": 2.5},
    {"check": "result_below", "path": "end.settingsPace", "max": 3.5},
    {"check": "result_above", "path": "end.keyDynamic", "min": 0.5}
  ]
}
