{
  "name": "weather-natives-held",
  "mods": ["boscalisummer"],
  "timeout_s": 900,
  "ops": [
    {"op": "seat", "id": "player", "altitude": 1500, "speed": 180, "heading": 0, "view": "cockpit"},
    {"op": "atmosphere", "time_of_day": 12, "conditions": 0.1, "cloud_height": 2000, "wind_speed": 8, "wind_heading": 270, "wind_turbulence": 0, "moon_phase": 14},
    {"op": "wait", "seconds": 20},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.ForceWeather", "store": "overcast", "args": {"regime": "Overcast", "cloudHeight": 1200, "seed": 20260918, "modelAge": 0}},
    {"op": "wait", "seconds": 100},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "overcast"},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.PinSky", "store": "veil", "args": {"sky": 4}},
    {"op": "wait", "seconds": 100},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "veil"},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.PinSky", "store": "opaque", "args": {"sky": 33}},
    {"op": "wait", "seconds": 100},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "opaque"},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.SetFixtureTape", "store": "early", "args": {"seed": 20260918, "story": 0, "offsetKm": 0, "dynamic": false}},
    {"op": "wait", "seconds": 100},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "early"},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.SetFixtureTape", "store": "late", "args": {"seed": 20260918, "story": 0, "offsetKm": 215, "dynamic": false}},
    {"op": "wait", "seconds": 100},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "late"},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.SetFixtureTape", "store": "cold", "args": {"seed": 20260918, "story": 1, "offsetKm": 200, "dynamic": false}},
    {"op": "wait", "seconds": 100},
    {"op": "call", "method": "BoscaliSummer.Modules.Weather.Runtime.WeatherAutomation.Readout", "store": "cold"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_match", "pattern": "Exception", "max": 0},
    {"check": "result_below", "path": "overcast.keyDynamic", "max": 0.5},
    {"check": "result_above", "path": "overcast.nativeConditions", "min": 0.5},
    {"check": "result_below", "path": "overcast.nativeConditions", "max": 0.6001},
    {"check": "result_below", "path": "overcast.sunFlips", "max": 0.5},
    {"check": "result_above", "path": "overcast.cloudHeight", "min": 250},
    {"check": "result_below", "path": "overcast.cloudHeight", "max": 1100},
    {"check": "result_above", "path": "overcast.nativeSunActive", "min": 0.5},
    {"check": "result_below", "path": "veil.nativeConditions", "max": 0.2},
    {"check": "result_above", "path": "veil.cloudHeight", "min": 4000},
    {"check": "result_above", "path": "opaque.nativeConditions", "min": 0.5},
    {"check": "result_below", "path": "opaque.nativeConditions", "max": 0.6001},
    {"check": "result_above", "path": "opaque.cloudHeight", "min": 2500},
    {"check": "result_below", "path": "opaque.sunFlips", "max": 0.5},
    {"check": "result_above", "path": "opaque.nativeSunActive", "min": 0.5},
    {"check": "result_below", "path": "early.keyDynamic", "max": 0.5},
    {"check": "result_above", "path": "early.markerCount", "min": 0.5},
    {"check": "result_below", "path": "early.nativeConditions", "max": 0.6001},
    {"check": "result_below", "path": "late.keyDynamic", "max": 0.5},
    {"check": "result_above", "path": "late.markerCount", "min": 0.5},
    {"check": "result_below", "path": "late.nativeConditions", "max": 0.6001},
    {"check": "result_below", "path": "late.sunFlips", "max": 0.5},
    {"check": "result_below", "path": "cold.keyDynamic", "max": 0.5},
    {"check": "result_below", "path": "cold.nativeConditions", "max": 0.6001},
    {"check": "result_below", "path": "cold.sunFlips", "max": 0.5},
    {"check": "result_above", "path": "cold.nativeSunActive", "min": 0.5},
    {"check": "result_above", "path": "overcast.ownNatives", "min": 0.5},
    {"check": "result_above", "path": "overcast.baselineWindSpeed", "min": 0.5},
    {"check": "result_above", "path": "overcast.nativeWindSpeed", "min": 0.5},
    {"check": "result_above", "path": "overcast.nativeWindVeerDeg", "min": -1},
    {"check": "result_below", "path": "overcast.nativeWindVeerDeg", "max": 1},
    {"check": "result_above", "path": "overcast.nativeTurbulence", "min": 0},
    {"check": "result_below", "path": "overcast.nativeTurbulence", "max": 1.1},
    {"check": "result_above", "path": "veil.nativeWindSpeed", "min": 0.5},
    {"check": "result_above", "path": "veil.nativeWindVeerDeg", "min": -1},
    {"check": "result_below", "path": "veil.nativeWindVeerDeg", "max": 1},
    {"check": "result_above", "path": "veil.nativeTurbulence", "min": 0},
    {"check": "result_below", "path": "veil.nativeTurbulence", "max": 1.1},
    {"check": "result_above", "path": "opaque.nativeWindSpeed", "min": 0.5},
    {"check": "result_above", "path": "opaque.nativeWindVeerDeg", "min": -1},
    {"check": "result_below", "path": "opaque.nativeWindVeerDeg", "max": 1},
    {"check": "result_above", "path": "opaque.nativeTurbulence", "min": 0},
    {"check": "result_below", "path": "opaque.nativeTurbulence", "max": 1.1},
    {"check": "result_above", "path": "early.nativeWindSpeed", "min": 0.5},
    {"check": "result_above", "path": "early.nativeWindVeerDeg", "min": -1},
    {"check": "result_below", "path": "early.nativeWindVeerDeg", "max": 1},
    {"check": "result_above", "path": "early.nativeTurbulence", "min": 0},
    {"check": "result_below", "path": "early.nativeTurbulence", "max": 1.1},
    {"check": "result_above", "path": "late.nativeWindSpeed", "min": 0.5},
    {"check": "result_above", "path": "late.nativeWindVeerDeg", "min": -1},
    {"check": "result_below", "path": "late.nativeWindVeerDeg", "max": 1},
    {"check": "result_above", "path": "late.nativeTurbulence", "min": 0},
    {"check": "result_below", "path": "late.nativeTurbulence", "max": 1.1},
    {"check": "result_above", "path": "cold.nativeWindSpeed", "min": 0.5},
    {"check": "result_above", "path": "cold.nativeWindVeerDeg", "min": -1},
    {"check": "result_below", "path": "cold.nativeWindVeerDeg", "max": 1},
    {"check": "result_above", "path": "cold.nativeTurbulence", "min": 0},
    {"check": "result_below", "path": "cold.nativeTurbulence", "max": 1.1},
    {"check": "result_above", "path": "late.localFrontKind", "min": -0.5},
    {"check": "result_above", "path": "cold.localFrontKind", "min": -0.5}
  ]
}
