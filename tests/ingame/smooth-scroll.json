{
  "name": "smooth-scroll",
  "_note": "Kit scrollers glide: open the first rail screen with a page taller than its viewport, send one wheel notch down then one up through a real raycast at the viewport centre, and sample the content for 30 frames. The hit must reach the scroller (gaps included), the move must spread over several frames, never back up, and land on one 56 px step.",
  "mods": [
    "boscalisummer"
  ],
  "timeout_s": 300,
  "environment": {
    "config": {
      "com.marci.boscalisummer": {
        "Mission": {
          "AskAtStart": false
        }
      }
    }
  },
  "ops": [
    { "op": "seat", "id": "player", "altitude": 1500, "speed": 180, "heading": 0 },
    { "op": "wait", "seconds": 15 },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.ScrollAutomation.Open",
      "args": { "codes": "SET,PILOT,EVN,MIS,OPS,FAC,STR,WMC,COM,RAD" },
      "store": "open"
    },
    { "op": "wait", "seconds": 2 },
    { "op": "capture", "name": "scroll_before" },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.ScrollAutomation.Wheel",
      "args": { "notches": -1 },
      "store": "down"
    },
    { "op": "wait", "seconds": 2 },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.ScrollAutomation.Read",
      "args": {},
      "store": "downRead"
    },
    { "op": "capture", "name": "scroll_after_down" },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.ScrollAutomation.Wheel",
      "args": { "notches": 1 },
      "store": "up"
    },
    { "op": "wait", "seconds": 2 },
    {
      "op": "call",
      "method": "BoscaliSummer.Modules.Command.Runtime.ScrollAutomation.Read",
      "args": {},
      "store": "upRead"
    },
    { "op": "end" }
  ],
  "checks": [
    { "check": "result_equals", "path": "down.ok", "value": true },
    { "check": "result_equals", "path": "down.handlerIsScroller", "value": true },
    { "check": "result_equals", "path": "downRead.monotonic", "value": true },
    { "check": "result_equals", "path": "upRead.monotonic", "value": true },
    { "check": "log_match", "pattern": "Boscali Summer\\].*Exception", "max": 0 }
  ]
}
