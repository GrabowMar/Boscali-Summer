<Project Sdk="Microsoft.NET.Sdk">
  <!-- Wing WMC rework pure units (spec 2026-10-04): a standalone runner so the slice stays testable on its own. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\modules\Wing\Domain\Pure\*.cs" LinkBase="Pure" />
  </ItemGroup>
</Project>
