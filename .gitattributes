# Normalise text to LF in the repository; each checkout picks its own line endings.
* text=auto

*.cs diff=csharp

*.png binary
*.ogg binary
*.bundle binary

# The Blueprinter pack is over GitHub's 100 MB file limit, so it goes through Git LFS.
/assets/BoscaliSummer.nobp filter=lfs diff=lfs merge=lfs -text
