# Build output
**/bin/
**/obj/
build/
dist/
*.dll
*.pdb
*.exe
.dll-backup/

# Test artifacts
TestResults/
*.trx

# Logs
*.log

# Local session trace exports
/trajectory-*.json

# Stray local tooling droppings
.appdata/
.codex-remote-attachments/
decompiled_src/
/custom gui.png

# Editors / IDEs
.vs/
.vscode/
.idea/
*.user
*.suo
*.DotSettings.user

# Operating-system metadata
Thumbs.db
.DS_Store

# Markdown docs and agent instructions are local-only, never published; the README is the
# one public document.
*.md
!/README.md

# Local agent tooling (kept on disk, out of the repo)
.agents/
.superpowers/
.claude/
.opencode/
.cursor/
.cursorrules
.nomodkit/

# Local design/spec/archive material (kept on disk, out of the repo)
/design/
/docs/superpowers/
/archive/
/screenshots/

# CI workflows are maintained outside the repo
.github/workflows/

# Patch / merge cruft
*.orig
*.rej
__pycache__/

# Source art (Blender, textures, previews, versioned bundle exports) stays local; only the
# bundles the csproj embeds are published.
/assets/**
!/assets/FutureOps/
!/assets/FutureOps/CargoShip.nobp
*.blend
*.blend1
modules/Vanguard/Assets/Models/
modules/Events/Assets/Source/
/docs/
!/CHANGELOG.md
