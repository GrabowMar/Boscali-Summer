# ---------------------------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------------------------
**/bin/
**/obj/
build/
dist/
*.dll
*.pdb
*.exe
*.nupkg
.dll-backup/

# Test and run artifacts (sim reports, offline renders, result dumps)
TestResults/
*.trx
*.log
/reports/
/output/
/trajectory-*.json

# ---------------------------------------------------------------------------------------------
# Documentation: Markdown is local-only (specs, plans, agent notes); only these are published
# ---------------------------------------------------------------------------------------------
*.md
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
/docs/*
!/docs/COMMUNITY_FIXES_2026-10-14.md
!/docs/MISSION_COMPATIBILITY.md

# ---------------------------------------------------------------------------------------------
# Source art stays local: Blender files, textures, previews and versioned bundle exports.
# Only the bundles the csproj embeds are published.
# ---------------------------------------------------------------------------------------------
/assets/**
!/assets/BoscaliSummer.nobp
*.blend
*.blend1
modules/Vanguard/Assets/Models/
modules/Events/Assets/Source/
# Particle FX prefabs/materials are generated by tools/ParticleFx (ship Core/Fx/Assets/particles.bundle)
/tools/ParticleFx/Fx/Prefabs/
/tools/ParticleFx/Fx/Materials/
/tools/ParticleFx/previews/

# ---------------------------------------------------------------------------------------------
# Local material kept on disk, out of the repo
# ---------------------------------------------------------------------------------------------
/design/
/docs/superpowers/
/archive/
/screenshots/
/research_notes/
/Python/
/tmp/
decompiled_src/
/custom gui.png

# Agent and tooling state
.agents/
.superpowers/
.claude/
.opencode/
.cursor/
.cursorrules
.nomodkit/
.paw-work/
.appdata/
.codex-remote-attachments/

# CI workflows are maintained outside the repo
.github/workflows/

