# ---------------------------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------------------------
**/bin/
**/obj/
build/
dist/
*.dll
*.pdb
*.exe
*.nupkg
.dll-backup/

# Test and run artifacts (sim reports, offline renders, result dumps)
TestResults/
*.trx
*.log
/reports/
/output/
/trajectory-*.json
# nomodkit owns development tools and links its tests into the mod checkout.
/tests/
/tools/

# ---------------------------------------------------------------------------------------------
# Documentation: Markdown is local-only (specs, plans, agent notes); only these are published
# ---------------------------------------------------------------------------------------------
*.md
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
/docs/*
!/docs/COMMUNITY_FIXES_2026-10-14.md
!/docs/MISSION_COMPATIBILITY.md
!/docs/GAMEMODES.md

# ---------------------------------------------------------------------------------------------
# Source art stays local: Blender files, textures, previews and versioned bundle exports.
# Only the bundles the csproj embeds are published.
# ---------------------------------------------------------------------------------------------
/assets/**
!/assets/BoscaliSummer.nobp
!/assets/SkylarkVTOL/
!/assets/SkylarkVTOL/Unity/
!/assets/SkylarkVTOL/Unity/skylark.bundle
*.blend
*.blend1
modules/Vanguard/Assets/Models/
modules/Events/Assets/Source/

# ---------------------------------------------------------------------------------------------
# Local material kept on disk, out of the repo
# ---------------------------------------------------------------------------------------------
/design/
/docs/superpowers/
/archive/
/screenshots/
/research_notes/
/Python/
/tmp/
decompiled_src/
/custom gui.png

# Agent and tooling state; publish only the two maintained nomod skills and MCP configuration.
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/nomodkit/
!.agents/skills/boscali-nomod/
.agents/skills/nomodkit/*
.agents/skills/boscali-nomod/*
!.agents/skills/nomodkit/SKILL.md
!.agents/skills/boscali-nomod/SKILL.md
.codex/*
!.codex/config.toml
.superpowers/
.claude/
.opencode/
.cursor/
.cursorrules
.nomodkit/
.paw-work/
.appdata/
.codex-remote-attachments/

# CI workflows are maintained outside the repo
.github/workflows/

# ---------------------------------------------------------------------------------------------
# Editors, OS and merge cruft
# ---------------------------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.user
*.suo
*.DotSettings.user
Thumbs.db
desktop.ini
.DS_Store
*.orig
*.rej
*.bak
*.tmp
*.swp
__pycache__/

.env.local
