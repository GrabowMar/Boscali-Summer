{
  "name": "ky44-recovery",
  "description": "KY-44 fighter recovery: drop both bay fighters, let them fly off, recall them; the datalink capture flies each to the gate and up onto the lowered trapeze, the bay stows them and closes. Captures from below.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "timeout_s": 420,
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}, "Megaplane": {"BayPayload": "Fighters"}}}},
  "ops": [
    {"op": "seat", "id": "carrier", "aircraft": "KY-44 Groza", "near": [10000, -35000], "altitude": 6000, "speed": 150, "heading": 90, "view": "orbit", "timeout": 60},
    {"op": "record", "ids": ["*"], "hz": 2},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Bay", "args": {"id": "carrier", "slot": 0}, "store": "go1"},
    {"op": "wait", "seconds": 9},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Bay", "args": {"id": "carrier", "slot": 1}, "store": "go2"},
    {"op": "wait", "seconds": 20},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Bay", "args": {"id": "carrier"}, "store": "away"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Bay", "args": {"id": "carrier", "recall": true}, "store": "recall"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -90, "y": -60, "z": -40, "lx": 0, "ly": -20, "lz": 10, "fov": 50}, "store": "v1"},
    {"op": "wait", "seconds": 40},
    {"op": "capture", "name": "recover-approach", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Bay", "args": {"id": "carrier"}, "store": "mid"},
    {"op": "wait", "seconds": 30},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -28, "y": -60, "z": 10, "lx": 0, "ly": -12, "lz": 16, "fov": 55}, "store": "v2"},
    {"op": "capture", "name": "recover-under", "hide_ui": true},
    {"op": "wait", "seconds": 40},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Bay", "args": {"id": "carrier"}, "store": "late"},
    {"op": "capture", "name": "recover-late", "hide_ui": true},
    {"op": "wait", "seconds": 50},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Bay", "args": {"id": "carrier"}, "store": "end"},
    {"op": "capture", "name": "recover-end", "hide_ui": true},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "alive", "ids": ["carrier"]},
    {"check": "result_equals", "path": "away.releasedAlive", "value": 2},
    {"check": "result_equals", "path": "recall.recalled", "value": 2},
    {"check": "result_equals", "path": "end.stowed", "value": 2},
    {"check": "result_equals", "path": "end.visuals", "value": 2},
    {"check": "result_equals", "path": "end.releasedAlive", "value": 0},
    {"value": 2, "check": "result_equals", "path": "away.releasedFriendly"},
    {"value": 0, "check": "result_equals", "path": "end.door"}
  ]
}
