{
  "name": "ky44-skywell-service",
  "description": "Fly an armed and depleted Vortex into Groza's exterior Skywell service area and check a completed fuel and ammunition transfer.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "timeout_s": 220,
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}, "Weather": {"Enabled": false}}}},
  "ops": [
    {"op": "wait_until", "path": "BoscaliSummer.Modules.Megaplane.MegaplaneTemplate.Definition", "truthy": true, "timeout_s": 45},
    {"op": "seat", "id": "carrier", "faction": "Boscali", "aircraft": "KY-44 Groza", "near": [25000, 0], "altitude": 6000, "speed": 130, "heading": 0, "view": "orbit", "timeout": 60},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist", "args": {"id": "carrier", "throttle": 0.54, "pitch": 0, "gear": false}},
    {"op": "wait", "seconds": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSkywellProbe.Read", "args": {"id": "carrier", "action": "trigger"}},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneSkywellProbe.Read", "args": {"id": "carrier", "until": true}, "eq": "Tow", "timeout_s": 35},
    {"op": "spawn", "id": "receiver", "type": "FS-20 Vortex", "faction": "Boscali", "at": {"near": {"id": "carrier", "offset": [0, -28, 128]}}, "speed": 124, "heading": 0},
    {"op": "fly", "id": "receiver", "program": [{"level": 140}]},
    {"op": "record", "ids": ["carrier", "receiver"], "hz": 2},
    {"op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": {"action": "skybind", "id": "carrier", "rx": "receiver"}, "store": "bound"},
    {"op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": {"action": "pitarm", "rx": "receiver"}},
    {"op": "wait", "seconds": 0.35},
    {"op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": {"action": "drain", "rx": "receiver", "fuel": 0.3, "stations": 1}, "store": "drain"},
    {"op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": {"action": "pit", "rx": "receiver", "order": "both"}},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneSkywellProbe.Read", "args": {"id": "carrier", "until": true}, "eq": "Service", "timeout_s": 95},
    {"op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": {"action": "skyview", "angle": "below"}},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "groza-skywell-servicing", "hide_ui": true},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneSkywellProbe.Read", "args": {"id": "carrier", "until": true}, "eq": "Tow", "timeout_s": 50},
    {"op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": {"action": "rxstatus", "rx": "receiver"}, "store": "serviced"},
    {"op": "call", "method": "BoscaliSummer.Vanguard.VanguardAutomation.Step", "args": {"action": "status"}, "store": "tender"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"check": "alive", "ids": ["carrier", "receiver"]},
    {"check": "result_equals", "path": "bound.ok", "value": true},
    {"check": "result_above", "path": "drain.fired", "min": 0},
    {"check": "result_above", "path": "drain.missing", "min": 0},
    {"check": "result_above", "path": "serviced.rxFuel", "min": 0.35},
    {"check": "result_above", "path": "serviced.rxHandoffs", "min": 0},
    {"check": "result_above", "path": "serviced.rxFuelJobs", "min": 0},
    {"check": "result_above", "path": "serviced.rxStops", "min": 0},
    {"check": "result_below", "path": "tender.skywellRoundsN", "max": 6}
  ]
}
