{
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}}}},
  "name": "ky44-groza-nose-assist",
  "description": "Exercise the real pilot inputs and forward-speed envelope, photograph the moving forebody intakes, and hit each native damage island independently.",
  "timeout_s": 150,
  "ops": [
    {"op": "atmosphere","time_of_day": 14,"conditions": 0.1,"cloud_height": 4200},
    {"op": "seat","id": "carrier","aircraft": "KY-44 Groza","near": [-24500,-17400],"altitude": 180,"speed": 53,"heading": 150,"view": "orbit","timeout": 60},
    {"op": "wait","seconds": 2},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier","throttle": 0.65,"pitch": -0.65,"gear": false,"speed": 53}},
    {"op": "wait","seconds": 4},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier"},"store": "gearUp"},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier","throttle": 0,"pitch": -0.65,"gear": true,"speed": 53}},
    {"op": "wait","seconds": 4},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier"},"store": "idle"},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier","throttle": 0.65,"pitch": 0,"gear": true,"speed": 53}},
    {"op": "wait","seconds": 4},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier"},"store": "neutral"},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier","throttle": 0.65,"pitch": -0.65,"gear": true,"speed": 48}},
    {"op": "wait","seconds": 8},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier"},"store": "rotate"},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier","gearGeometry": true},"store": "gearGeometry"},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View","args": {"id": "carrier","x": -27.5,"y": 13,"z": 91,"lx": -12.85,"ly": -5.65,"lz": 78.8,"fov": 32}},
    {"op": "wait","seconds": 0.8},
    {"op": "capture","name": "ky44-assist-open","hide_ui": true},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View","args": {"id": "carrier","x": -64,"y": 29,"z": 117,"lx": -4,"ly": -2,"lz": 82,"fov": 49}},
    {"op": "wait","seconds": 0.8},
    {"op": "capture","name": "ky44-assist-forebody","hide_ui": true},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier","throttle": 0.65,"pitch": -0.65,"gear": true,"speed": 126}},
    {"op": "wait","seconds": 7},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier"},"store": "cruise"},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View","args": {"id": "carrier","x": -27.5,"y": 13,"z": 91,"lx": -12.85,"ly": -5.65,"lz": 78.8,"fov": 32}},
    {"op": "wait","seconds": 0.8},
    {"op": "capture","name": "ky44-assist-closed","hide_ui": true},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier","throttle": 0.65,"pitch": -0.65,"gear": true,"speed": 0}},
    {"op": "wait","seconds": 3},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier"},"store": "nearStill"},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier","throttle": 0.65,"pitch": -0.65,"gear": true,"speed": 48}},
    {"op": "wait","seconds": 4},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier"},"store": "redemand"},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Hit","args": {"id": "carrier","nodes": "noseAssist_L","pierce": 4000,"times": 30},"store": "leftHit"},
    {"op": "wait","seconds": 4},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier"},"store": "one"},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View","args": {"id": "carrier","x": -41,"y": 12,"z": 105,"lx": -8,"ly": -4,"lz": 80,"fov": 49}},
    {"op": "wait","seconds": 0.8},
    {"op": "capture","name": "ky44-assist-damage","hide_ui": true},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Hit","args": {"id": "carrier","nodes": "noseAssist_R","pierce": 4000,"times": 30},"store": "rightHit"},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier","throttle": 0.65,"pitch": 0,"gear": true,"speed": 53}},
    {"op": "wait","seconds": 5},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier"},"store": "settled"},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier","throttle": 0.65,"pitch": -0.65,"gear": true,"speed": 48}},
    {"op": "wait","seconds": 8},
    {"op": "call","method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist","args": {"id": "carrier"},"store": "unassisted"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean","sources": ["Boscali Summer"]},
    {"check": "result_equals","path": "rotate.installed","value": 2},
    {"check": "result_equals","path": "rotate.leftOwner","value": "noseAssist_L"},
    {"check": "result_equals","path": "rotate.rightOwner","value": "noseAssist_R"},
    {"check": "result_below","path": "gearUp.assist","max": 0.01},
    {"check": "result_below","path": "idle.assist","max": 0.01},
    {"check": "result_below","path": "neutral.assist","max": 0.01},
    {"check": "result_below","path": "cruise.assist","max": 0.01},
    {"check": "result_below","path": "nearStill.assist","max": 0.01},
    {"check": "result_below","path": "unassisted.assist","max": 0.01},
    {"check": "result_below","path": "cruise.leftLid","max": 1},
    {"check": "result_below","path": "cruise.rightLid","max": 1},
    {"check": "result_above","path": "cruise.forward","min": 107},
    {"check": "result_below","path": "nearStill.forward","max": 30},
    {"check": "result_above","path": "nearStill.forward","min": 0.5},
    {"check": "result_above","path": "rotate.assist","min": 0.85},
    {"check": "result_above","path": "rotate.leftLid","min": 62},
    {"check": "result_above","path": "rotate.rightLid","min": 62},
    {"check": "result_above","path": "rotate.pitch","min": 7},
    {"check": "result_above","path": "rotate.climb","min": 7},
    {"check": "result_above","path": "redemand.assist","min": 0.85},
    {"check": "result_equals","path": "one.leftAttached","value": false},
    {"check": "result_equals","path": "one.rightAttached","value": true},
    {"check": "result_below","path": "one.leftPower","max": 0.005},
    {"check": "result_above","path": "one.rightPower","min": 0.9},
    {"check": "result_above","path": "one.assist","min": 0.45},
    {"check": "result_below","path": "one.assist","max": 0.55},
    {"check": "result_equals","path": "unassisted.disabled","value": false},
    {"check": "result_equals","path": "unassisted.rightAttached","value": false}
  ]
}
