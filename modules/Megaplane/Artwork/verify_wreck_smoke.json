{
  "name": "ky44-wreck-smoke-and-water-spray",
  "description": "Measure live particles after real terrain and open-water impacts, including settled wreckage.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "timeout_s": 150,
  "environment": {"resolution": [1440, 810], "config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "Weather": {"Enabled": false}}}},
  "ops": [
    {"op": "atmosphere", "time_of_day": 14, "conditions": 0.025, "cloud_height": 5300},
    {"op": "wait_until", "path": "BoscaliSummer.Modules.Megaplane.MegaplaneClientMapReadyPatch.Registered", "eq": true, "timeout_s": 75},
    {"op": "spawn", "type": "KY-44 Groza", "id": "land", "at": {"map": [-24500,-17400]}, "altitude": 350, "speed": 100, "heading": 142},
    {"op": "observe", "follow": "land"},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "release", "profile": "heavy", "id": "land"}},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "created", "profile": "heavy"}, "truthy": true, "timeout_s": 15},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "overview", "profile": "heavy"}},
    {"op": "wait", "seconds": 11},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneVisualProbe.Inspect", "args": {"step": "wreck"}, "store": "land"},
    {"op": "capture", "name": "groza-hillside-plume", "hide_ui": true},
    {"op": "spawn", "type": "KY-44 Groza", "id": "sea", "at": {"map": [-24500,-16000]}, "altitude": 350, "speed": 100, "heading": 142},
    {"op": "observe", "follow": "sea"},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "release", "profile": "water", "id": "sea"}},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "created", "profile": "water"}, "truthy": true, "timeout_s": 15},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "overview", "profile": "water"}},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneVisualProbe.Inspect", "args": {"step": "wreck"}, "store": "spray"},
    {"op": "capture", "name": "groza-spray", "hide_ui": true},
    {"op": "wait", "seconds": 13},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneVisualProbe.Inspect", "args": {"step": "wreck"}, "store": "sea"},
    {"op": "capture", "name": "groza-sea-settled", "hide_ui": true},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"check": "result_equals", "path": "land.Water", "value": false},
    {"check": "result_above", "path": "land.count", "min": 45},
    {"check": "result_below", "path": "land.count", "max": 361},
    {"check": "result_above", "path": "land.height", "min": 38},
    {"check": "result_above", "path": "land.width", "min": 45},
    {"check": "result_equals", "path": "spray.Water", "value": true},
    {"check": "result_above", "path": "spray.count", "min": 10},
    {"check": "result_equals", "path": "sea.Water", "value": true},
    {"check": "result_equals", "path": "sea.count", "value": 0}
  ]
}
