{
  "name": "ky44-seated-impact-ejected",
  "description": "Real cockpit, native pilot health, game camera and network rescue identity after the original aircraft is removed.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}, "Weather": {"Enabled": false}}}},
  "timeout_s": 85,
  "ops": [
    {"op": "atmosphere", "time_of_day": 14, "conditions": 0.025, "cloud_height": 5400},
    {"op": "seat", "id": "carrier", "aircraft": "KY-44 Groza", "near": [-24500, -17400], "altitude": 280, "speed": 70, "heading": 142, "view": "cockpit", "timeout": 60},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "crewArm", "profile": "ejected", "id": "carrier"}, "store": "before"},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "crewReady", "profile": "ejected"}, "truthy": true, "timeout_s": 16},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "crewRelease", "profile": "ejected"}, "store": "release"},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "crewWreck", "profile": "ejected"}, "truthy": true, "timeout_s": 22},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "crewInspect", "profile": "ejected"}, "store": "impact"},
    {"op": "wait", "seconds": 15},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "crewInspect", "profile": "ejected"}, "store": "after"},
    {"op": "capture", "name": "ky44-seated-ejected", "hide_ui": false},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"check": "result_equals", "path": "before.seated", "value": true},
    {"check": "result_equals", "path": "before.dead", "value": false},
    {"check": "result_equals", "path": "before.ejected", "value": false},
    {"check": "result_equals", "path": "before.sourceLive", "value": true},
    {"check": "result_equals", "path": "before.hudSeated", "value": true},
    {"check": "result_equals", "path": "before.rescueCount", "value": 0},
    {"check": "result_above", "path": "before.health", "min": 70},
    {"check": "result_equals", "path": "after.fields", "value": 1},
    {"check": "result_equals", "path": "after.sourcePresent", "value": false},
    {"check": "result_equals", "path": "after.seated", "value": false},
    {"check": "result_equals", "path": "after.hudSeated", "value": false},
    {"check": "result_equals", "path": "after.camera", "value": true},
    {"check": "result_equals", "path": "after.pivot", "value": true},
    {"check": "result_equals", "path": "after.attachedView", "value": false},
    {"check": "result_equals", "path": "after.kills", "value": 1},
    {"check": "result_equals", "path": "after.dead", "value": false},
    {"check": "result_equals", "path": "after.rescueCount", "value": 1},
    {"check": "result_equals", "path": "after.playerOwnsRescue", "value": true},
    {"check": "result_above", "path": "after.health", "min": 0},
    {"check": "result_equals", "path": "after.sameRescue", "value": true},
    {"check": "result_above", "path": "release.rescueAtRelease", "min": 1}
  ]
}
