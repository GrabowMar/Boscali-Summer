{
  "name": "ky44-damaged-aircraft-finish",
  "description": "Compare a stock Darkreach's damage shader and a Groza wingtip before damage, with partial damage, and after separation.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "timeout_s": 150,
  "environment": {"resolution": [1440, 810], "config": {"boscalisummer": {"Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "Weather": {"Enabled": false}}}},
  "ops": [
    {"op": "atmosphere", "time_of_day": 14, "conditions": 0.025, "cloud_height": 5300},
    {"op": "spawn", "type": "SFB-81 Darkreach", "id": "reference", "at": {"map": [-26500, -18000]}, "altitude": 1500, "speed": 118, "heading": 150},
    {"op": "observe", "follow": "reference"},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneVisualProbe.Inspect", "args": {"step": "stock", "id": "reference", "view": true}, "store": "stockIntact"},
    {"op": "wait", "seconds": 0.3},
    {"op": "capture", "name": "darkreach-clean-skin", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneVisualProbe.Inspect", "args": {"step": "stock", "id": "reference", "impact": 41}},
    {"op": "wait", "seconds": 0.5},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneVisualProbe.Inspect", "args": {"step": "stock", "id": "reference"}, "store": "stockDamaged"},
    {"op": "capture", "name": "darkreach-damaged-skin", "hide_ui": true},
    {"op": "wait_until", "path": "BoscaliSummer.Modules.Megaplane.MegaplaneClientMapReadyPatch.Registered", "eq": true, "timeout_s": 75},
    {"op": "seat", "id": "carrier", "aircraft": "KY-44 Groza", "near": [-24500, -17400], "altitude": 1450, "speed": 120, "heading": 150, "view": "orbit", "timeout": 50},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneVisualProbe.Inspect", "args": {"step": "skin", "id": "carrier", "view": true}},
    {"op": "wait", "seconds": 0.35},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneVisualProbe.Inspect", "args": {"step": "skin", "id": "carrier"}, "store": "clean"},
    {"op": "capture", "name": "groza-clean-skin", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSectionProbe.Section", "args": {"id": "carrier", "site": "tip", "impact": 41}},
    {"op": "wait", "seconds": 0.55},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneVisualProbe.Inspect", "args": {"step": "skin", "id": "carrier"}, "store": "damaged"},
    {"op": "capture", "name": "groza-damaged-skin", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSectionProbe.Section", "args": {"id": "carrier", "site": "tip", "impact": 38}},
    {"op": "wait", "seconds": 0.55},
    {"op": "capture", "name": "groza-heavy-skin", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSectionProbe.Section", "args": {"id": "carrier", "site": "tip", "impact": 35}},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneVisualProbe.Inspect", "args": {"step": "skin", "id": "carrier"}, "store": "separated"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"check": "result_equals", "path": "stockIntact.owner", "value": "wing2_L"},
    {"check": "result_equals", "path": "stockIntact.shader", "value": "Shader Graphs/AircraftSkin"},
    {"check": "result_above", "path": "stockIntact.hp", "min": 96},
    {"check": "result_below", "path": "stockDamaged.hp", "max": 85},
    {"check": "result_equals", "path": "clean.tip", "value": 0},
    {"check": "result_equals", "path": "clean.other", "value": 0},
    {"check": "result_equals", "path": "damaged.attached", "value": true},
    {"check": "result_above", "path": "damaged.hp", "min": 50},
    {"check": "result_below", "path": "damaged.hp", "max": 70},
    {"check": "result_equals", "path": "damaged.mapped", "value": true},
    {"check": "result_above", "path": "damaged.geometry", "min": 3},
    {"check": "result_equals", "path": "damaged.other", "value": 0},
    {"check": "result_equals", "path": "separated.attached", "value": false},
    {"check": "result_equals", "path": "separated.mapped", "value": true},
    {"check": "result_equals", "path": "separated.other", "value": 0}
  ]
}
