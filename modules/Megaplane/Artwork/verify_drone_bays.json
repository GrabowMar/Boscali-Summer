{
  "name": "ky44-drone-bays",
  "description": "Check six protected launch cells and native port/starboard Remora release, with the exposed loadout and main ramp left independent.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "timeout_s": 135,
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}, "Weather": {"Enabled": false}}}},
  "ops": [
    {"op": "wait_until", "path": "BoscaliSummer.Modules.Megaplane.MegaplaneTemplate.Definition", "truthy": true, "timeout_s": 45},
    {"op": "seat", "id": "carrier", "aircraft": "KY-44 Groza", "near": [10000, -35000], "altitude": 3400, "speed": 130, "heading": 0, "view": "orbit", "timeout": 60},
    {"op": "record", "ids": ["carrier"], "hz": 2},
    {"op": "wait", "seconds": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneWingBayProbe.Read", "args": {"id": "carrier"}, "store": "loaded"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -83, "y": -35, "z": 12, "lx": -81, "ly": -3, "lz": -11, "fov": 52}},
    {"op": "wait", "seconds": 0.5},
    {"op": "capture", "name": "groza-wing-magazine-closed", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneWingBayProbe.Read", "args": {"id": "carrier", "fire": true}, "store": "trigger1"},
    {"op": "wait", "seconds": 0.78},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneWingBayProbe.Read", "args": {"id": "carrier"}, "store": "opening"},
    {"op": "capture", "name": "groza-wing-drone-doors", "hide_ui": true},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneWingBayProbe.Read", "args": {"id": "carrier"}, "store": "first"},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneWingBayProbe.Read", "args": {"id": "carrier", "until": "ready"}, "eq": true, "timeout_s": 15},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneWingBayProbe.Read", "args": {"id": "carrier", "fire": true}, "store": "trigger2"},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneWingBayProbe.Read", "args": {"id": "carrier"}, "store": "second"},
    {"op": "wait", "seconds": 5},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneWingBayProbe.Read", "args": {"id": "carrier"}, "store": "secured"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"check": "alive", "ids": ["carrier"]},
    {"check": "result_equals", "path": "loaded.configured", "value": 6},
    {"check": "result_equals", "path": "loaded.loaded", "value": 6},
    {"check": "result_equals", "path": "loaded.rails", "value": 6},
    {"check": "result_equals", "path": "loaded.clear", "value": true},
    {"check": "result_equals", "path": "loaded.closed", "value": true},
    {"check": "result_equals", "path": "loaded.fits", "value": true},
    {"check": "result_equals", "path": "loaded.bayAmmo", "value": 6},
    {"check": "result_equals", "path": "loaded.externalAmmo", "value": 4},
    {"check": "result_equals", "path": "trigger1.triggered", "value": true},
    {"check": "result_above", "path": "opening.port", "min": 0.35},
    {"check": "result_equals", "path": "opening.starboard", "value": 0},
    {"check": "result_equals", "path": "opening.released", "value": 0},
    {"check": "result_equals", "path": "first.bayAmmo", "value": 5},
    {"check": "result_equals", "path": "first.released", "value": 1},
    {"check": "result_equals", "path": "trigger2.triggered", "value": true},
    {"check": "result_equals", "path": "second.bayAmmo", "value": 4},
    {"check": "result_equals", "path": "second.released", "value": 2},
    {"check": "result_equals", "path": "second.portReleased", "value": 1},
    {"check": "result_equals", "path": "second.starboardReleased", "value": 1},
    {"check": "result_above", "path": "second.starboard", "min": 0.35},
    {"check": "result_equals", "path": "second.externalAmmo", "value": 4},
    {"check": "result_equals", "path": "second.ramp", "value": 0},
    {"check": "result_equals", "path": "secured.closed", "value": true}
  ]
}
