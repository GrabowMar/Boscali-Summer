{
  "name": "ky44-localized-damage",
  "description": "Fresh aircraft for each location. Hit the first outside collider twice, detach only the target, then inspect the opening and the undamaged structure.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}, "Weather": {"Enabled": false}}}},
  "timeout_s": 80,
  "matrix": {"site": ["tip", "flap", "engine", "hull"]},
  "ops": [
    {"op": "atmosphere", "time_of_day": 14, "conditions": 0.025, "cloud_height": 5400},
    {"op": "seat", "id": "carrier", "aircraft": "KY-44 Groza", "near": [-24500, -17400], "altitude": 1450, "speed": 120, "heading": 150, "view": "orbit", "timeout": 60},
    {"op": "record", "ids": ["carrier"], "hz": 2},
    {"op": "wait", "seconds": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSectionProbe.Section", "args": {"id": "carrier", "site": "${site}", "view": true}},
    {"op": "wait", "seconds": 0.5},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSectionProbe.Section", "args": {"id": "carrier", "site": "${site}"}, "store": "intact"},
    {"op": "capture", "name": "ky44-${site}-intact", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSectionProbe.Section", "args": {"id": "carrier", "site": "${site}", "impact": 18}, "store": "contact1"},
    {"op": "wait", "seconds": 0.65},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSectionProbe.Section", "args": {"id": "carrier", "site": "${site}"}, "store": "first"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSectionProbe.Section", "args": {"id": "carrier", "site": "${site}", "impact": 20}, "store": "contact2"},
    {"op": "wait", "seconds": 0.65},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSectionProbe.Section", "args": {"id": "carrier", "site": "${site}"}, "store": "partial"},
    {"op": "capture", "name": "ky44-${site}-partial", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSectionProbe.Section", "args": {"id": "carrier", "site": "${site}", "native": true}, "store": "nativeContact"},
    {"op": "wait", "seconds": 0.4},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSectionProbe.Section", "args": {"id": "carrier", "site": "${site}", "impact": 76}, "store": "lastContact"},
    {"op": "wait", "seconds": 1.65},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSectionProbe.Section", "args": {"id": "carrier", "site": "${site}"}, "store": "lost"},
    {"op": "capture", "name": "ky44-${site}-separated", "hide_ui": true},
    {"op": "wait", "seconds": 2.3},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSectionProbe.Section", "args": {"id": "carrier", "site": "${site}"}, "store": "settled"},
    {"op": "capture", "name": "ky44-${site}-opening", "hide_ui": true},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"check": "alive", "ids": ["carrier"]},
    {"check": "result_equals", "path": "intact.pickedTarget", "value": true},
    {"check": "result_equals", "path": "intact.ownsArt", "value": true},
    {"check": "result_equals", "path": "intact.attached", "value": true},
    {"check": "result_equals", "path": "first.pickedTarget", "value": true},
    {"check": "result_equals", "path": "first.ownsArt", "value": true},
    {"check": "result_equals", "path": "first.attached", "value": true},
    {"check": "result_equals", "path": "partial.pickedTarget", "value": true},
    {"check": "result_equals", "path": "partial.ownsArt", "value": true},
    {"check": "result_equals", "path": "partial.attached", "value": true},
    {"check": "result_equals", "path": "contact1.pickedTarget", "value": true},
    {"check": "result_equals", "path": "contact2.pickedTarget", "value": true},
    {"check": "result_equals", "path": "lastContact.pickedTarget", "value": true},
    {"check": "result_equals", "path": "intact.health", "value": 100},
    {"check": "result_equals", "path": "intact.affected", "value": 0},
    {"check": "result_above", "path": "first.health", "min": 81.5},
    {"check": "result_below", "path": "first.health", "max": 82.5},
    {"check": "result_above", "path": "partial.health", "min": 61.5},
    {"check": "result_below", "path": "partial.health", "max": 62.5},
    {"check": "result_equals", "path": "first.affected", "value": 1},
    {"check": "result_equals", "path": "partial.affected", "value": 1},
    {"check": "result_equals", "path": "lost.pickedTarget", "value": false},
    {"check": "result_equals", "path": "lost.ownsArt", "value": false},
    {"check": "result_equals", "path": "lost.attached", "value": false},
    {"check": "result_equals", "path": "lost.health", "value": 0},
    {"check": "result_equals", "path": "lost.opposite", "value": 100},
    {"check": "result_equals", "path": "lost.support", "value": 100},
    {"check": "result_equals", "path": "lost.disabled", "value": false},
    {"check": "result_above", "path": "lost.affected", "min": 0},
    {"check": "result_below", "path": "lost.affected", "max": 1},
    {"check": "result_equals", "path": "settled.pickedTarget", "value": false},
    {"check": "result_equals", "path": "settled.ownsArt", "value": false},
    {"check": "result_equals", "path": "settled.attached", "value": false},
    {"check": "result_equals", "path": "settled.health", "value": 0},
    {"check": "result_equals", "path": "settled.opposite", "value": 100},
    {"check": "result_equals", "path": "settled.support", "value": 100},
    {"check": "result_equals", "path": "settled.disabled", "value": false},
    {"check": "result_above", "path": "settled.affected", "min": 0},
    {"check": "result_below", "path": "settled.affected", "max": 1},
    {"check": "result_equals", "path": "intact.hudSections", "value": 46},
    {"check": "result_equals", "path": "intact.hudBound", "value": true},
    {"check": "result_equals", "path": "partial.hudBound", "value": true},
    {"check": "result_equals", "path": "settled.hudOpposite", "value": 0},
    {"check": "result_equals", "path": "nativeContact.pickedTarget", "value": true},
    {"check": "result_equals", "path": "nativeContact.affected", "value": 1},
    {"check": "result_above", "path": "partial.hudAlpha", "min": 0.1},
    {"check": "result_below", "path": "partial.hudAlpha", "max": 0.9},
    {"check": "result_above", "path": "lost.hudGreen", "min": 0},
    {"check": "result_below", "path": "lost.hudGreen", "max": 0.05},
    {"check": "result_above", "path": "lost.hudAlpha", "min": 0.95},
    {"check": "result_below", "path": "lost.hudAlpha", "max": 1},
    {"check": "result_above", "path": "nativeContact.removedHP", "min": 0.1},
    {"check": "result_below", "path": "nativeContact.removedHP", "max": 50}
  ]
}
