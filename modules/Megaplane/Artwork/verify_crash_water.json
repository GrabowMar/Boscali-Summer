{
  "name": "ky44-water-contact",
  "description": "Actual descent across the sea surface. Observe flood progression without land scrape strips.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}, "Weather": {"Enabled": false}}}},
  "timeout_s": 85,
  "matrix": {"profile": ["water"]},
  "ops": [
    {"op": "atmosphere", "time_of_day": 14, "conditions": 0.025, "cloud_height": 5400},
    {"op": "spawn", "type": "KY-44 Groza", "id": "carrier", "at": {"map": [-34000, -42000]}, "altitude": 350, "speed": 100, "heading": 142},
    {"op": "observe", "follow": "carrier"},
    {"op": "record", "ids": ["carrier"], "hz": 7},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "inspect", "profile": "${profile}", "id": "carrier"}, "store": "scene"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "predamage", "profile": "${profile}", "id": "carrier"}, "store": "prep"},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "gearReady", "id": "carrier", "profile": "${profile}"}, "truthy": true, "timeout_s": 24},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "release", "profile": "${profile}", "id": "carrier"}, "store": "started"},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "created", "profile": "${profile}"}, "truthy": true, "timeout_s": 12},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "inspect", "profile": "${profile}"}, "store": "impact"},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "overview", "profile": "${profile}"}},
    {"op": "capture", "name": "ky44-crash-${profile}-first-contact", "hide_ui": true},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "settled", "profile": "${profile}"}, "truthy": true, "timeout_s": 40},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "inspect", "profile": "${profile}"}, "store": "rest"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "overview", "profile": "${profile}"}},
    {"op": "wait", "seconds": 0.35},
    {"op": "capture", "name": "ky44-crash-${profile}-overview", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "close", "profile": "${profile}"}},
    {"op": "wait", "seconds": 0.4},
    {"op": "capture", "name": "ky44-crash-${profile}-structure", "hide_ui": true},
    {"op": "wait", "seconds": 2.0},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "inspect", "profile": "${profile}"}, "store": "later"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"check": "result_equals", "path": "scene.wrecks", "value": 0},
    {"check": "result_equals", "path": "impact.wrecks", "value": 1},
    {"check": "result_equals", "path": "rest.wrecks", "value": 1},
    {"check": "result_equals", "path": "later.wrecks", "value": 1},
    {"check": "result_equals", "path": "rest.first.water", "value": true},
    {"check": "result_equals", "path": "rest.first.settled", "value": true},
    {"check": "result_equals", "path": "rest.first.artMatchesMask", "value": true},
    {"check": "result_equals", "path": "rest.first.oppositeWing", "value": true},
    {"check": "result_equals", "path": "rest.first.center", "value": true},
    {"check": "result_equals", "path": "rest.first.physicsBodies", "value": 0},
    {"check": "result_above", "path": "rest.first.drawMeshes", "min": 18},
    {"check": "result_above", "path": "rest.first.count", "min": 2},
    {"check": "result_below", "path": "rest.first.count", "max": 50},
    {"check": "result_above", "path": "rest.first.width", "min": 40},
    {"check": "result_below", "path": "rest.first.width", "max": 1400},
    {"check": "result_below", "path": "rest.first.surfaceError", "max": 5},
    {"check": "result_equals", "path": "rest.first.marks", "value": 0},
    {"check": "result_equals", "path": "rest.first.gearLegMatches", "value": true},
    {"check": "result_equals", "path": "rest.first.gearDoorMatches", "value": true},
    {"check": "result_equals", "path": "rest.crushMatchesFlight", "value": true},
    {"check": "result_equals", "path": "rest.first.crushedMeshes", "value": 0},
    {"check": "result_equals", "path": "rest.first.maximumCrease", "value": 0},
    {"check": "result_equals", "path": "rest.first.delayedBreaks", "value": 0},
    {"check": "result_equals", "path": "rest.first.releasedBreaks", "value": 0},
    {"check": "result_equals", "path": "rest.first.podRollDegrees", "value": 0},
    {"check": "result_equals", "path": "rest.first.hullHopMeters", "value": 0},
    {"check": "result_equals", "path": "rest.first.panelHopMeters", "value": 0},
    {"check": "result_equals", "path": "rest.first.frontMatches", "value": true}
  ]
}
