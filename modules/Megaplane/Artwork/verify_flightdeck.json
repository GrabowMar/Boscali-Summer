{
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}}}},
  "name": "ky44-groza-flightdeck",
  "description": "Groza native cockpit, damage schematic, legacy loadout, hangar availability, articulated flaps, LODs, and daylight exterior photographs.",
  "timeout_s": 140,
  "ops": [
    {"op": "atmosphere", "time_of_day": 14, "conditions": 0.1, "cloud_height": 4200},
    {"op": "seat", "id": "carrier", "aircraft": "KY-44 Groza", "near": [-24500, -17400], "altitude": 1800, "speed": 130, "heading": 150, "view": "cockpit", "timeout": 60},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "release": true}},
    {"op": "wait", "seconds": 5},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "cockpit"},
    {"op": "capture", "name": "ky44-native-cockpit-hud", "hide_ui": false},
    {"op": "capture", "name": "ky44-native-cockpit", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.SavedFit", "args": {"id": "carrier"}, "store": "legacy"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -1.15, "y": 5.434, "z": 100.691, "lx": -1.15, "ly": 4.794, "lz": 101.611, "fov": 57}, "store": "mfdCam"},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "ky44-live-tactical-display", "hide_ui": false},
    {"op": "seat", "id": "carrier", "view": "orbit"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Gear", "args": {"id": "carrier", "down": true}, "store": "pose_start"},
    {"op": "wait", "seconds": 14},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "gear"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 220, "y": 78, "z": 225, "lx": 0, "ly": 3, "lz": -4, "fov": 51}, "store": "nearcam"},
    {"op": "wait", "seconds": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "near"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -205, "y": 70, "z": 183, "lx": 0, "ly": 0, "lz": 0, "fov": 50}},
    {"op": "wait", "seconds": 1.5},
    {"op": "capture", "name": "ky44-port-sun", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 205, "y": 70, "z": 183, "lx": 0, "ly": 0, "lz": 0, "fov": 50}},
    {"op": "wait", "seconds": 1.5},
    {"op": "capture", "name": "ky44-starboard-sun", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -278, "y": 40, "z": 40, "lx": 0, "ly": 0, "lz": 0, "fov": 48}},
    {"op": "wait", "seconds": 1.5},
    {"op": "capture", "name": "ky44-profile-sun", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 201, "y": 65, "z": -207, "lx": 0, "ly": 0, "lz": 0, "fov": 50}},
    {"op": "wait", "seconds": 1.5},
    {"op": "capture", "name": "ky44-aft-sun", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 110, "y": -95, "z": 130, "lx": 0, "ly": 0, "lz": 0, "fov": 68}},
    {"op": "wait", "seconds": 1.5},
    {"op": "capture", "name": "ky44-underside-sun", "hide_ui": true},
    {"op": "capture", "name": "ky44-near", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 1400, "y": 410, "z": 1150, "lx": 0, "ly": 0, "lz": -4, "fov": 55}, "store": "farcam"},
    {"op": "wait", "seconds": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "far"},
    {"op": "capture", "name": "ky44-distant", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 3000, "y": 600, "z": 2050, "lx": 0, "ly": 0, "lz": 0, "fov": 55}, "store": "fartherCam"},
    {"op": "wait", "seconds": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "midfar"},
    {"op": "capture", "name": "ky44-three-km", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 6500, "y": 1500, "z": 4200, "lx": 0, "ly": 0, "lz": 0, "fov": 55}, "store": "distantCam"},
    {"op": "wait", "seconds": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "distant"},
    {"op": "capture", "name": "ky44-eight-km", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "release": true}, "store": "normal"},
    {"op": "seat", "id": "carrier", "view": "cockpit"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Hit", "args": {"id": "carrier", "nodes": "wing1a_R", "pierce": 900, "times": 3}, "store": "hit"},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "hudsnap"},
    {"op": "capture", "name": "ky44-native-damage-hud", "hide_ui": false},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"check": "result_equals", "path": "cockpit.display", "value": true},
    {"check": "result_below", "path": "cockpit.eyeDistance", "max": 0.05},
    {"check": "result_equals", "path": "near.display", "value": false},
    {"check": "result_above", "path": "gear.flap", "min": 24},
    {"check": "result_above", "path": "near.nearVisible", "min": 1},
    {"check": "result_above", "path": "distant.farVisible", "min": 1},
    {"check": "result_equals", "path": "cockpit.liveTexture", "value": true},
    {"check": "result_equals", "path": "legacy.valid", "value": true},
    {"check": "result_equals", "path": "hudsnap.sections", "value": 46},
    {"check": "result_equals", "path": "hudsnap.damagedSections", "value": ["wing1a_R"]},
    {"check": "result_above", "path": "legacy.darkreachHangars", "min": 1},
    {"check": "result_equals", "path": "legacy.allHangars", "value": true}
  ]
}
