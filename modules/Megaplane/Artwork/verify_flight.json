{
  "name": "ky44-groza-flight",
  "description": "KY-44 Groza acceptance: flies airborne and stable; BL-155 howitzers and VLS missiles fire; CIWS/SAM engage missiles; component damage (wing, hump, body) with failure effects; paratroop + vehicle drop from the ramp; wing-beam drone launch; screenshots into the sandbox capture folder.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "timeout_s": 420,
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}}}},
  "ops": [
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Status", "args": {}, "store": "reg"},
    {"op": "seat", "id": "carrier", "aircraft": "KY-44 Groza", "near": [-24500, -17400], "altitude": 1800, "speed": 130, "heading": 150, "view": "orbit", "timeout": 60},
    {"op": "record", "ids": ["*"], "hz": 2},
    {"op": "wait", "seconds": 5},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Status", "args": {"id": "carrier"}, "store": "start"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 213, "y": 72, "z": 182, "lx": 0, "ly": 3, "lz": -4, "fov": 51}, "store": "v_q34"},
    {"op": "wait", "seconds": 3},
    {"op": "capture", "name": "ky44-q34", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 285, "y": 47, "z": 53, "lx": 0, "ly": 3, "lz": 0, "fov": 47}, "store": "v_profile"},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "ky44-profile", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -207, "y": 87, "z": -204, "lx": 0, "ly": 3, "lz": 1, "fov": 50}, "store": "v_aft"},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "ky44-aft-quarter", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 0, "y": 20, "z": 300, "lx": 0, "ly": 0, "lz": 0, "fov": 50}, "store": "v_front"},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "ky44-front", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 0, "y": 268, "z": 7, "lx": 0, "ly": 0, "lz": -2, "fov": 59}, "store": "v_top"},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "ky44-top", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -1.15, "y": 5.454, "z": 100.461, "lx": -1.15, "ly": 5.364, "lz": 109.881, "fov": 78}, "store": "v_cockpit"},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "ky44-cockpit", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 0.88, "y": 5.804, "z": 95.881, "lx": 0.0, "ly": 4.984, "lz": 102.681, "fov": 83}, "store": "v_deck"},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "ky44-deck", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 75, "y": 9, "z": 35, "lx": 0, "ly": 6, "lz": 15, "fov": 55}, "store": "v_side"},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "ky44-side", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 41, "y": 9, "z": 90, "lx": 4, "ly": 3, "lz": 75, "fov": 48}, "store": "v_sideclose"},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "ky44-side-close", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 120, "y": -28, "z": 15, "lx": 60, "ly": 5, "lz": -5, "fov": 60}, "store": "v_under"},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "ky44-underwing", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -21, "y": -10, "z": 52, "lx": -30, "ly": -5.1, "lz": 27, "fov": 46}, "store": "v_pod"},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "ky44-pod", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -2.5, "y": 5.434, "z": 95.881, "lx": 0.1, "ly": 5.034, "lz": 102.081, "fov": 80}, "store": "v_fdeck"},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "ky44-flightdeck", "hide_ui": true},
    {"op": "wait", "seconds": 16},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Status", "args": {"id": "carrier"}, "store": "hold"},
    {"op": "fly", "id": "carrier", "program": [{"turn": {"heading": 200, "bank": 20}}, {"level": 20}]},
    {"op": "wait", "seconds": 40},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Status", "args": {"id": "carrier"}, "store": "turned"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -37, "y": -2.7, "z": 63.4, "lx": -15.7, "ly": -5.6, "lz": 59.4, "fov": 44}, "store": "v_how"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Fire", "args": {"id": "carrier", "weapon": "Bastion"}, "store": "how0"},
    {"op": "wait", "seconds": 2.5},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Fire", "args": {"id": "carrier", "weapon": "Bastion"}, "store": "how"},
    {"op": "wait", "seconds": 3},
    {"op": "capture", "name": "ky44-howitzer", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 40, "y": 40, "z": -50, "lx": 0, "ly": 14, "lz": 0, "fov": 50}, "store": "v_vls"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Fire", "args": {"id": "carrier", "weapon": "@missile"}, "store": "vls"},
    {"op": "wait", "seconds": 3},
    {"op": "capture", "name": "ky44-vls", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Stores", "args": {"id": "carrier", "reset": true}, "store": "s0"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Threat", "args": {"id": "carrier", "count": 4, "key": "AAM2", "range": 4500}, "store": "t0"},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Threat", "args": {"id": "carrier"}, "store": "t1"},
    {"op": "wait", "seconds": 15},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Threat", "args": {"id": "carrier"}, "store": "t2"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 64, "y": -17.5, "z": 57, "lx": 101.0, "ly": -8.4, "lz": 0, "fov": 50}, "store": "v_pylon"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Stores", "args": {"id": "carrier", "fire": "Remora"}, "store": "d1"},
    {"op": "wait", "seconds": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Stores", "args": {"id": "carrier", "fire": "Manta"}, "store": "d2"},
    {"op": "wait", "seconds": 3},
    {"op": "capture", "name": "ky44-drones", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Stores", "args": {"id": "carrier", "fire": "AB_Paratroopers"}, "store": "p1"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Stores", "args": {"id": "carrier", "fire": "cargo"}, "store": "p2"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -22, "y": -11, "z": -86, "lx": 0, "ly": -5.7, "lz": -64, "fov": 54}, "store": "v_ramp"},
    {"op": "wait", "seconds": 9},
    {"op": "capture", "name": "ky44-ramp-open", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Stores", "args": {"id": "carrier"}, "store": "p3"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 4.7, "y": -0.8, "z": -46, "lx": 0, "ly": -1, "lz": -24, "fov": 76}, "store": "holdinside"},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "ky44-cargo-interior", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 65, "y": 12, "z": -52, "lx": 0, "ly": -155, "lz": -320, "fov": 73}},
    {"op": "wait", "seconds": 20},
    {"op": "capture", "name": "ky44-drop-behind", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Stores", "args": {"id": "carrier"}, "store": "p4"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 213, "y": 72, "z": 182, "lx": 0, "ly": 3, "lz": -4, "fov": 51}, "store": "v_q34b"},
    {"op": "wait", "seconds": 2},
    {"op": "perf_window", "store": "perf_ky44", "seconds": 4, "warmup": 1},
    {"op": "spawn", "id": "stock", "type": "SFB-81 Darkreach", "faction": "Primeva", "at": {"near": {"id": "carrier", "offset": [0, 0, 1500]}}, "altitude": 1800, "speed": 130, "heading": 150},
    {"op": "wait", "seconds": 4},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "stock", "x": 60, "y": 20, "z": 45, "lx": 0, "ly": 0, "lz": 0, "fov": 55}, "store": "v_stock"},
    {"op": "wait", "seconds": 3},
    {"op": "capture", "name": "stock-q34", "hide_ui": true},
    {"op": "perf_window", "store": "perf_stock", "seconds": 4, "warmup": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Hit", "args": {"id": "carrier"}, "store": "dstart"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Hit", "args": {"id": "carrier", "nodes": "wing1a_R", "pierce": 900, "times": 3}, "store": "graze"},
    {"op": "wait", "seconds": 8},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Hit", "args": {"id": "carrier"}, "store": "burning"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 240, "y": 45, "z": -70, "lx": 120, "ly": 0, "lz": -5, "fov": 50}, "store": "vburn"},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "ky44-damage-burning", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Hit", "args": {"id": "carrier", "nodes": "wing1b_L", "pierce": 4000, "times": 30}, "store": "shot"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -260, "y": 60, "z": -120, "lx": -100, "ly": 0, "lz": 0, "fov": 55}, "store": "vbreak"},
    {"op": "wait", "seconds": 2},
    {"op": "capture", "name": "ky44-damage-break", "hide_ui": true},
    {"op": "wait", "seconds": 20},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Hit", "args": {"id": "carrier"}, "store": "winged"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Hit", "args": {"id": "carrier", "nodes": "hump", "heal": true, "pierce": 4000, "times": 30}, "store": "humpshot"},
    {"op": "wait", "seconds": 4},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Hit", "args": {"id": "carrier"}, "store": "humped"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Hit", "args": {"id": "carrier", "nodes": "body_F", "pierce": 4000, "times": 30}, "store": "killshot"},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Hit", "args": {"id": "carrier"}, "store": "bodybroken"},
    {"op": "capture", "name": "ky44-damage-body", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "release": true}},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"check": "column_range", "column": "radar_alt", "ids": ["carrier"], "min": 300, "after": 5},
    {"check": "result_below", "path": "hold.smoothFrameMs", "max": 100},
    {"check": "result_below", "path": "turned.smoothFrameMs", "max": 100},
    {"check": "result_equals", "path": "reg.registered", "value": true},
    {"check": "result_equals", "path": "start.nan", "value": false},
    {"check": "result_equals", "path": "start.fans", "value": 8},
    {"check": "result_above", "path": "hold.altitude", "min": 1650},
    {"check": "result_below", "path": "hold.altitude", "max": 1950},
    {"check": "result_above", "path": "hold.speed", "min": 70},
    {"check": "result_below", "path": "hold.speed", "max": 170},
    {"check": "result_below", "path": "turned.slip", "max": 8},
    {"check": "result_above", "path": "start.sideAmmo", "min": 200},
    {"check": "result_above", "path": "start.missileStations", "min": 2},
    {"check": "result_equals", "path": "how.fired", "value": true},
    {"check": "result_equals", "path": "vls.fired", "value": true},
    {"check": "result_equals", "path": "s0.hasTender", "value": true},
    {"check": "result_equals", "path": "t0.spawned", "value": 4},
    {"check": "result_equals", "path": "t2.alive", "value": 0},
    {"check": "result_above", "path": "t2.pdSpent", "min": 1},
    {"check": "result_above", "path": "p3.door", "min": 0.9},
    {"check": "result_above", "path": "p3.drones", "min": 1},
    {"check": "result_above", "path": "p4.vehiclesNew", "min": 1},
    {"check": "result_above", "path": "burning.burning", "min": 0.5},
    {"check": "result_above", "path": "shot.state.lostCount", "min": 1},
    {"check": "result_below", "path": "winged.liftL", "max": 0.7},
    {"check": "result_equals", "path": "winged.disabled", "value": false},
    {"check": "result_above", "path": "humpshot.before", "min": 99},
    {"check": "result_below", "path": "humpshot.after", "max": 0},
    {"check": "result_equals", "path": "bodybroken.disabled", "value": true},
    {"check": "result_above", "path": "p3.drones", "min": 2}
  ]
}
