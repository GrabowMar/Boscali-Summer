{
  "name": "ky44-forward-hull-ground-strike",
  "description": "A 24-degree nose-down carrier descends freely to terrain. Observe the real point of contact, forward shells, rim, mount separation and roll in the settled field.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}, "Weather": {"Enabled": false}}}, "resolution": [1600, 900]},
  "timeout_s": 85,
  "ops": [
    {"op": "atmosphere", "time_of_day": 14, "conditions": 0.025, "cloud_height": 5400},
    {"op": "spawn", "type": "KY-44 Groza", "id": "carrier", "at": {"map": [-24500, -17400]}, "altitude": 350, "speed": 100, "heading": 142},
    {"op": "observe", "follow": "carrier"},
    {"op": "record", "ids": ["carrier"], "hz": 7},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "inspect", "profile": "forebody", "id": "carrier"}, "store": "scene"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "predamage", "profile": "forebody", "id": "carrier"}, "store": "prep"},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "gearReady", "id": "carrier", "profile": "forebody"}, "truthy": true, "timeout_s": 24},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "release", "profile": "forebody", "id": "carrier"}, "store": "started"},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "created", "profile": "forebody"}, "truthy": true, "timeout_s": 12},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "inspect", "profile": "forebody"}, "store": "impact"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "crease", "profile": "forebody"}, "store": "crease"},
    {"op": "wait", "seconds": 0.22},
    {"op": "capture", "name": "ky44-crash-forebody-crease", "hide_ui": true},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "overview", "profile": "forebody"}},
    {"op": "capture", "name": "ky44-crash-forebody-first-contact", "hide_ui": true},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "settled", "profile": "forebody"}, "truthy": true, "timeout_s": 40},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "inspect", "profile": "forebody"}, "store": "rest"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "overview", "profile": "forebody"}},
    {"op": "wait", "seconds": 0.35},
    {"op": "capture", "name": "ky44-crash-forebody-overview", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "close", "profile": "forebody"}},
    {"op": "wait", "seconds": 0.4},
    {"op": "capture", "name": "ky44-crash-forebody-structure", "hide_ui": true},
    {"op": "wait", "seconds": 2.0},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "inspect", "profile": "forebody"}, "store": "later"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneCrashProbe.Run", "args": {"step": "frontClose", "profile": "forebody"}},
    {"op": "wait", "seconds": 0.35},
    {"op": "capture", "name": "ky44-forebody-wreck-close", "hide_ui": true},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"check": "result_equals", "path": "scene.wrecks", "value": 0},
    {"check": "result_equals", "path": "impact.wrecks", "value": 1},
    {"check": "result_equals", "path": "rest.wrecks", "value": 1},
    {"check": "result_equals", "path": "later.wrecks", "value": 1},
    {"check": "result_equals", "path": "rest.first.water", "value": false},
    {"check": "result_equals", "path": "rest.first.settled", "value": true},
    {"check": "result_equals", "path": "rest.first.artMatchesMask", "value": true},
    {"check": "result_equals", "path": "rest.first.oppositeWing", "value": true},
    {"check": "result_equals", "path": "rest.first.center", "value": true},
    {"check": "result_equals", "path": "rest.first.physicsBodies", "value": 0},
    {"check": "result_above", "path": "rest.first.drawMeshes", "min": 18},
    {"check": "result_above", "path": "rest.first.count", "min": 2},
    {"check": "result_below", "path": "rest.first.count", "max": 50},
    {"check": "result_above", "path": "rest.first.width", "min": 40},
    {"check": "result_below", "path": "rest.first.width", "max": 1400},
    {"check": "result_below", "path": "rest.first.surfaceError", "max": 5},
    {"check": "result_above", "path": "rest.first.marks", "min": 1},
    {"check": "result_equals", "path": "rest.first.gearLegMatches", "value": true},
    {"check": "result_equals", "path": "rest.first.gearDoorMatches", "value": true},
    {"check": "result_equals", "path": "rest.crushMatchesFlight", "value": true},
    {"check": "result_equals", "path": "rest.first.privateMesh", "value": true},
    {"check": "result_below", "path": "rest.sceneFields", "max": 4},
    {"check": "result_above", "path": "impact.motionSamples", "min": 1},
    {"check": "result_below", "path": "impact.measuredSeparation", "max": 0.4},
    {"check": "result_equals", "path": "rest.first.frontMatches", "value": true},
    {"check": "result_above", "path": "rest.first.contactStation", "min": 75},
    {"check": "result_above", "path": "rest.first.delayedBreaks", "min": 2},
    {"check": "result_above", "path": "rest.first.releasedBreaks", "min": 2},
    {"check": "result_above", "path": "rest.first.lastBreakSeconds", "min": 0.1},
    {"check": "result_above", "path": "rest.first.podRollDegrees", "min": 90},
    {"check": "result_below", "path": "rest.first.hullHopMeters", "max": 3.4},
    {"check": "result_above", "path": "rest.first.panelHopMeters", "min": 0.4},
    {"check": "result_above", "path": "rest.motionSamples", "min": 3},
    {"check": "result_above", "path": "rest.measuredPodDegrees", "min": 45},
    {"check": "result_above", "path": "rest.measuredSeparation", "min": 2},
    {"check": "result_equals", "path": "rest.first.front.Fuselage_Cockpit.present", "value": true},
    {"check": "result_equals", "path": "rest.first.front.ForeCheek_L.present", "value": true},
    {"check": "result_equals", "path": "rest.first.front.ForeCheek_R.present", "value": true},
    {"check": "result_equals", "path": "rest.first.front.BridgeCrown.present", "value": true},
    {"check": "result_equals", "path": "rest.first.front.NoseChin.present", "value": true}
  ]
}
