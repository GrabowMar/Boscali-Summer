{
  "name": "ky44-local-damage-and-reactor",
  "description": "Isolate one outboard engine, compare its available power and fan speed with its neighbor, then exercise cooling recovery and a single localized plant failure.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}}}},
  "timeout_s": 160,
  "ops": [
    {"op": "atmosphere", "time_of_day": 14, "conditions": 0.1, "cloud_height": 4200},
    {"op": "seat", "id": "carrier", "aircraft": "KY-44 Groza", "near": [-24500, -17400], "altitude": 2600, "speed": 125, "heading": 150, "view": "orbit", "timeout": 60},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist", "args": {"id": "carrier", "throttle": 0.65, "pitch": 0, "gear": false}},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier"}, "store": "intact"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "hit": "pod4_L", "health": 68}},
    {"op": "wait", "seconds": 8},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier"}, "store": "mild"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "hit": "rudder_R", "health": 65}},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier"}, "store": "rudder"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "hit": "pod4_L", "health": 38}},
    {"op": "wait", "seconds": 5},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier"}, "store": "engineFire"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -178, "y": 37, "z": 20, "lx": -127, "ly": 0, "lz": -10, "fov": 52}},
    {"op": "wait", "seconds": 0.6},
    {"op": "capture", "name": "ky44-local-engine-fire", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "hit": "pod4_L", "health": 0}},
    {"op": "wait", "seconds": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier"}, "store": "engineLost"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 2.7, "y": 34, "z": -15.8, "lx": 0, "ly": 4, "lz": -7.6, "fov": 52}},
    {"op": "wait", "seconds": 0.4},
    {"op": "capture", "name": "ky44-reactor-covered", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "rays": true}, "store": "covered"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "hit": "hump", "health": 0}},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "rays": true}, "store": "access"},
    {"op": "capture", "name": "ky44-reactor-exposed", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "health": 30, "aim": "reactor"}},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier"}, "store": "cooledCore"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "health": 30, "aim": "coolant_L"}},
    {"op": "wait", "seconds": 4},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier"}, "store": "oneLoop"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "health": 30, "aim": "coolant_R"}},
    {"op": "wait", "seconds": 6},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier"}, "store": "warming"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "repair": "coolant_L"}},
    {"op": "wait", "seconds": 7},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier"}, "store": "recovered"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -22, "y": 28, "z": 14, "lx": 0, "ly": 11, "lz": -13.2, "fov": 54}},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "health": 0, "aim": "coolant_L"}},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "health": 0, "aim": "coolant_R"}},
    {"op": "wait", "seconds": 12},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier"}, "store": "rising"},
    {"op": "capture", "name": "ky44-reactor-heating", "hide_ui": true},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "waitFlash": true}, "truthy": true, "timeout_s": 20},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier"}, "store": "breach"},
    {"op": "capture", "name": "ky44-reactor-vent", "hide_ui": true},
    {"op": "wait", "seconds": 7},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier"}, "store": "spent"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"check": "result_equals", "path": "intact.installed", "value": true},
    {"check": "result_equals", "path": "intact.engineCount", "value": 8},
    {"check": "result_equals", "path": "mild.affected", "value": 1},
    {"check": "result_above", "path": "mild.power", "min": 0.67},
    {"check": "result_below", "path": "mild.power", "max": 0.69},
    {"check": "result_above", "path": "mild.thrust", "min": 0.955},
    {"check": "result_below", "path": "mild.thrust", "max": 0.965},
    {"check": "result_equals", "path": "mild.neighbor", "value": 1},
    {"check": "result_above", "path": "mild.rotorRatio", "min": 0.65},
    {"check": "result_below", "path": "mild.rotorRatio", "max": 0.72},
    {"check": "result_equals", "path": "mild.burning", "value": 0},
    {"check": "result_above", "path": "mild.ordinaryEffects", "min": 1},
    {"check": "result_below", "path": "mild.largest", "max": 1.1},
    {"check": "result_above", "path": "rudder.yaw", "min": 0.8},
    {"check": "result_below", "path": "rudder.yaw", "max": 0.99},
    {"check": "result_above", "path": "engineFire.burning", "min": 1},
    {"check": "result_below", "path": "engineFire.largest", "max": 1.2},
    {"check": "result_equals", "path": "engineFire.state", "value": 0},
    {"check": "result_equals", "path": "engineLost.wing", "value": true},
    {"check": "result_equals", "path": "engineLost.affected", "value": 1},
    {"check": "result_equals", "path": "engineLost.neighbor", "value": 1},
    {"check": "result_below", "path": "engineLost.power", "max": 0.001},
    {"check": "result_above", "path": "engineLost.thrust", "min": 0.87},
    {"check": "result_below", "path": "engineLost.thrust", "max": 0.88},
    {"check": "result_equals", "path": "cooledCore.state", "value": 0},
    {"check": "result_equals", "path": "cooledCore.disabled", "value": false},
    {"check": "result_above", "path": "warming.heat", "min": 0.13},
    {"check": "result_below", "path": "warming.heat", "max": 0.6},
    {"check": "result_equals", "path": "recovered.state", "value": 0},
    {"check": "result_equals", "path": "recovered.disabled", "value": false},
    {"check": "result_above", "path": "rising.heat", "min": 0.45},
    {"check": "result_below", "path": "rising.heat", "max": 0.85},
    {"check": "result_equals", "path": "rising.disabled", "value": false},
    {"check": "result_equals", "path": "breach.state", "value": 11},
    {"check": "result_equals", "path": "breach.flashes", "value": 1},
    {"check": "result_equals", "path": "breach.disabled", "value": true},
    {"check": "result_equals", "path": "breach.affected", "value": 1},
    {"check": "result_equals", "path": "breach.neighbor", "value": 1},
    {"check": "result_equals", "path": "breach.ventCloud", "value": true},
    {"check": "result_equals", "path": "spent.state", "value": 12},
    {"check": "result_equals", "path": "spent.flashes", "value": 1},
    {"check": "result_equals", "path": "spent.flashLights", "value": 0},
    {"check": "result_equals", "path": "covered.core", "value": "hump"},
    {"check": "result_equals", "path": "covered.left", "value": "hump"},
    {"check": "result_equals", "path": "covered.right", "value": "hump"},
    {"check": "result_equals", "path": "access.core", "value": "reactor"},
    {"check": "result_equals", "path": "access.left", "value": "coolant_L"},
    {"check": "result_equals", "path": "access.right", "value": "coolant_R"},
    {"check": "result_equals", "path": "oneLoop.state", "value": 0},
    {"check": "result_below", "path": "cooledCore.plantPower", "max": 0.5},
    {"check": "result_above", "path": "cooledCore.plantPower", "min": 0.2},
    {"check": "result_below", "path": "cooledCore.thrust", "max": 0.5}
  ]
}
