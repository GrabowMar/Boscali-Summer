{
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}, "Weather": {"Enabled": false}}}, "resolution": [1600, 900]},
  "name": "ky44-public-pilot-station",
  "timeout_s": 140,
  "ops": [
    {"op": "atmosphere", "time_of_day": 14, "conditions": 0.1, "cloud_height": 4200},
    {"op": "seat", "id": "carrier", "aircraft": "KY-44 Groza", "near": [-24500, -17400], "altitude": 1800, "speed": 130, "heading": 150, "view": "cockpit", "timeout": 60},
    {"op": "wait", "seconds": 2},
    {"op": "read", "path": "CombatHUD.i.aircraft.definition.width", "store": "span"},
    {"op": "read", "path": "CombatHUD.i.aircraft.Player.IsLocalPlayer", "store": "localPilot"},
    {"op": "atmosphere", "time_of_day": 14, "conditions": 0.06, "cloud_height": 4800},
    {"op": "wait", "seconds": 1.7},
    {"op": "write", "path": "CameraStateManager.i.cockpitState.tiltView", "value": 0},
    {"op": "write", "path": "CameraStateManager.i.cockpitState.panView", "value": 0},
    {"op": "wait", "seconds": 0.8},
    {"op": "read", "path": "CameraStateManager.i.cockpitCamRender.enabled", "store": "dayEye"},
    {"op": "capture", "name": "groza-day-hud", "hide_ui": false},
    {"op": "capture", "name": "groza-day-clean", "hide_ui": true},
    {"op": "write", "path": "PlayerSettings.virtualJoystickEnabled", "value": false},
    {"op": "write", "path": "CameraStateManager.i.cockpitState.tiltView", "value": 24},
    {"op": "write", "path": "CameraStateManager.i.cockpitState.panView", "value": 12},
    {"op": "wait", "seconds": 0.8},
    {"op": "read", "path": "CameraStateManager.i.cockpitState.tiltView", "store": "dayTilt"},
    {"op": "capture", "name": "groza-day-instruments-hud", "hide_ui": false},
    {"op": "capture", "name": "groza-day-instruments", "hide_ui": true},
    {"op": "write", "path": "PlayerSettings.virtualJoystickEnabled", "value": true},
    {"op": "atmosphere", "time_of_day": 23, "conditions": 0.06, "cloud_height": 4800},
    {"op": "wait", "seconds": 1.7},
    {"op": "write", "path": "CameraStateManager.i.cockpitState.tiltView", "value": 0},
    {"op": "write", "path": "CameraStateManager.i.cockpitState.panView", "value": 0},
    {"op": "wait", "seconds": 0.8},
    {"op": "read", "path": "CameraStateManager.i.cockpitCamRender.enabled", "store": "nightEye"},
    {"op": "capture", "name": "groza-night-hud", "hide_ui": false},
    {"op": "capture", "name": "groza-night-clean", "hide_ui": true},
    {"op": "write", "path": "PlayerSettings.virtualJoystickEnabled", "value": false},
    {"op": "write", "path": "CameraStateManager.i.cockpitState.tiltView", "value": 24},
    {"op": "write", "path": "CameraStateManager.i.cockpitState.panView", "value": 12},
    {"op": "wait", "seconds": 0.8},
    {"op": "read", "path": "CameraStateManager.i.cockpitState.tiltView", "store": "nightTilt"},
    {"op": "capture", "name": "groza-night-instruments-hud", "hide_ui": false},
    {"op": "capture", "name": "groza-night-instruments", "hide_ui": true},
    {"op": "write", "path": "PlayerSettings.virtualJoystickEnabled", "value": true},
    {"op": "seat", "id": "carrier", "view": "orbit"},
    {"op": "wait", "seconds": 0.6},
    {"op": "read", "path": "CameraStateManager.i.cockpitCamRender.enabled", "store": "outsideEye"},
    {"op": "seat", "id": "carrier", "view": "cockpit"},
    {"op": "wait", "seconds": 0.7},
    {"op": "read", "path": "CameraStateManager.i.cockpitCamRender.enabled", "store": "returnedEye"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"check": "result_equals", "path": "localPilot", "value": true},
    {"check": "result_above", "path": "span", "min": 200},
    {"check": "result_equals", "path": "dayEye", "value": true},
    {"check": "result_above", "path": "dayTilt", "min": 20},
    {"check": "result_equals", "path": "nightEye", "value": true},
    {"check": "result_above", "path": "nightTilt", "min": 20},
    {"check": "result_equals", "path": "outsideEye", "value": false},
    {"check": "result_equals", "path": "returnedEye", "value": true}
  ],
  "description": "Check the shipping build using the native player seat and cockpit camera. Photograph its forward and instrument views in daylight and darkness, then leave and return to the cockpit."
}
