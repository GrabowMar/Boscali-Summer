{
  "name": "ky44-railgun",
  "description": "KY-44 weapons + lift: BL-155 side guns (Tarantula mounts) counted and captured, RKY-44 railgun bay payload lowered, fired and raised, lift jets open with the gear.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "timeout_s": 300,
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}, "Megaplane": {"BayPayload": "Railgun"}}}},
  "ops": [
    {"op": "seat", "id": "carrier", "aircraft": "KY-44 Groza", "near": [10000, -35000], "altitude": 6000, "speed": 150, "heading": 90, "view": "orbit", "timeout": 60},
    {"op": "record", "ids": ["*"], "hz": 2},
    {"op": "wait", "seconds": 4},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Status", "args": {"id": "carrier"}, "store": "st"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -60, "y": -4, "z": 88, "lx": -18, "ly": -8, "lz": 69, "fov": 40}, "store": "v1"},
    {"op": "wait", "seconds": 3},
    {"op": "capture", "name": "mp-guns-fwd-L", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -62, "y": 2, "z": -30, "lx": -18, "ly": -3, "lz": -56, "fov": 40}, "store": "v2"},
    {"op": "wait", "seconds": 3},
    {"op": "capture", "name": "mp-guns-aft-L", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 55, "y": -30, "z": 80, "lx": 18, "ly": -8, "lz": 66, "fov": 40}, "store": "v3"},
    {"op": "wait", "seconds": 3},
    {"op": "capture", "name": "mp-guns-fwd-R-low", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Railgun", "args": {"id": "carrier", "down": true}, "store": "r0"},
    {"op": "wait", "seconds": 14},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Railgun", "args": {"id": "carrier"}, "store": "r1"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -45, "y": -48, "z": 55, "lx": 0, "ly": -22, "lz": 16, "fov": 45}, "store": "v4"},
    {"op": "wait", "seconds": 3},
    {"op": "capture", "name": "mp-railgun-down", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -60, "y": -24, "z": 16, "lx": 0, "ly": -22, "lz": 30, "fov": 40}, "store": "v5"},
    {"op": "wait", "seconds": 3},
    {"op": "capture", "name": "mp-railgun-side", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Railgun", "args": {"id": "carrier", "fire": true}, "store": "r2"},
    {"op": "wait", "seconds": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Railgun", "args": {"id": "carrier"}, "store": "r3"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Gear", "args": {"id": "carrier", "down": true}, "store": "g1"},
    {"op": "wait", "seconds": 18},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Status", "args": {"id": "carrier"}, "store": "st2"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -120, "y": 45, "z": 40, "lx": -85, "ly": 6, "lz": 2, "fov": 45}, "store": "v6"},
    {"op": "wait", "seconds": 3},
    {"op": "capture", "name": "mp-lift-top", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -120, "y": -35, "z": 30, "lx": -85, "ly": -2, "lz": 2, "fov": 45}, "store": "v7"},
    {"op": "wait", "seconds": 3},
    {"op": "capture", "name": "mp-lift-under", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Railgun", "args": {"id": "carrier", "down": false}, "store": "r4"},
    {"op": "wait", "seconds": 16},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Railgun", "args": {"id": "carrier"}, "store": "r5"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "alive", "ids": ["carrier"]},
    {"check": "result_equals", "path": "st.sideGuns", "value": 4},
    {"check": "result_equals", "path": "st.sideStations", "value": 1},
    {"check": "result_equals", "path": "st.railStations", "value": 1},
    {"check": "result_equals", "path": "r1.live", "value": true},
    {"check": "result_equals", "path": "r2.fired", "value": true},
    {"check": "result_equals", "path": "st2.lift", "value": 1},
    {"check": "result_equals", "path": "r5.lower", "value": 0},
    {"value": 1, "check": "result_equals", "path": "r1.lower"},
    {"value": 0, "check": "result_equals", "path": "r5.door"},
    {"value": false, "check": "result_equals", "path": "r5.live"},
    {"check": "result_below", "path": "r3.ammo", "max": 39}
  ]
}
