{
  "name": "ky44-crew-station-systems",
  "description": "Inspect the four physical console materials and three cabin lights under flight, bay cycling, plant damage, leaving the cockpit and loss of bridge power.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}, "Weather": {"Enabled": false}, "Megaplane": {"BayPayload": "Fighters"}}}, "resolution": [1600, 900]},
  "timeout_s": 140,
  "ops": [
    {"op": "atmosphere", "time_of_day": 15, "conditions": 0.03, "cloud_height": 4500},
    {"op": "seat", "id": "carrier", "aircraft": "KY-44 Groza", "near": [-24500, -17400], "altitude": 2100, "speed": 125, "heading": 150, "view": "cockpit", "timeout": 60},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneLightProbe.Cabin", "args": {"id": "carrier"}, "store": "inside"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "ready"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Bay", "args": {"id": "carrier", "slot": 0}, "store": "released"},
    {"op": "wait", "seconds": 18},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "launched"},
    {"op": "seat", "id": "carrier", "view": "orbit"},
    {"op": "wait", "seconds": 0.7},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneLightProbe.Cabin", "args": {"id": "carrier"}, "store": "outside"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "hit": "reactor", "health": 30}, "store": "reactor"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "hit": "coolant_L", "health": 0}, "store": "coolingL"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "hit": "coolant_R", "health": 0}, "store": "coolingR"},
    {"op": "atmosphere", "time_of_day": 1, "conditions": 0.02, "cloud_height": 4900},
    {"op": "seat", "id": "carrier", "view": "cockpit"},
    {"op": "wait", "seconds": 3.0},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneLightProbe.Cabin", "args": {"id": "carrier"}, "store": "night"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "damaged"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Detach", "args": {"id": "carrier", "nodes": "BridgeCrown"}, "store": "roof"},
    {"op": "wait", "seconds": 0.65},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneLightProbe.Cabin", "args": {"id": "carrier"}, "store": "openRoof"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "openCabin"},
    {"op": "write", "path": "CombatHUD.i.aircraft.disabled", "value": true},
    {"op": "wait", "seconds": 0.5},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneLightProbe.Cabin", "args": {"id": "carrier"}, "store": "dark"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "offline"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"check": "result_equals", "path": "inside.installed", "value": 7},
    {"check": "result_equals", "path": "inside.illuminated", "value": 7},
    {"check": "result_equals", "path": "inside.lensesGlowing", "value": true},
    {"check": "result_equals", "path": "ready.crewRoom.stations", "value": 4},
    {"check": "result_equals", "path": "ready.crewRoom.heading", "value": 3},
    {"check": "result_equals", "path": "ready.crewRoom.circuit", "value": 0},
    {"check": "result_equals", "path": "ready.crewRoom.engineering", "value": 0},
    {"check": "result_equals", "path": "ready.crewRoom.cargo", "value": 0},
    {"check": "result_equals", "path": "launched.crewRoom.cargo", "value": 3},
    {"check": "result_equals", "path": "outside.installed", "value": 7},
    {"check": "result_equals", "path": "outside.illuminated", "value": 0},
    {"check": "result_equals", "path": "outside.lensesGlowing", "value": false},
    {"check": "result_equals", "path": "night.installed", "value": 7},
    {"check": "result_equals", "path": "night.illuminated", "value": 7},
    {"check": "result_equals", "path": "night.lensesGlowing", "value": true},
    {"check": "result_equals", "path": "damaged.crewRoom.engineering", "value": 1},
    {"check": "result_equals", "path": "roof.ok", "value": true},
    {"check": "result_equals", "path": "openRoof.illuminated", "value": 7},
    {"check": "result_equals", "path": "openCabin.crewRoom.circuit", "value": 0},
    {"check": "result_equals", "path": "dark.illuminated", "value": 0},
    {"check": "result_equals", "path": "dark.lensesGlowing", "value": false},
    {"check": "result_equals", "path": "offline.crewRoom.heading", "value": -1},
    {"check": "result_equals", "path": "offline.crewRoom.circuit", "value": -1},
    {"check": "result_equals", "path": "offline.crewRoom.engineering", "value": -1},
    {"check": "result_equals", "path": "offline.crewRoom.cargo", "value": -1}
  ]
}
