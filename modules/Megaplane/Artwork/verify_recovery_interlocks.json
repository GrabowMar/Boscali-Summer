{
  "name": "ky44-recovery-interlocks",
  "description": "Bring a released fighter to the trapeze, bank away during lineup, hold level to recover it and relaunch after servicing.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "timeout_s": 330,
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}, "Weather": {"Enabled": false}, "Megaplane": {"BayPayload": "Fighters", "BayFighter": "Fighter1"}}}},
  "ops": [
    {"op": "seat", "id": "carrier", "aircraft": "KY-44 Groza", "near": [10000, -35000], "altitude": 6000, "speed": 130, "heading": 90, "view": "orbit", "timeout": 60},
    {"op": "record", "ids": ["carrier"], "hz": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist", "args": {"id": "carrier", "throttle": 0.6, "pitch": 0, "gear": false}},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneRecoveryProbe.Read", "args": {"id": "carrier", "until": "deck"}, "eq": true, "timeout_s": 20},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Bay", "args": {"id": "carrier", "slot": 0}, "store": "launch"},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneRecoveryProbe.Read", "args": {"id": "carrier", "until": "released"}, "eq": true, "timeout_s": 15},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneRecoveryProbe.Read", "args": {"id": "carrier", "until": "recallable"}, "eq": true, "timeout_s": 15},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Bay", "args": {"id": "carrier", "recall": true}, "store": "recall"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneRecoveryProbe.Read", "args": {"id": "carrier"}, "store": "marshal"},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneRecoveryProbe.Read", "args": {"id": "carrier", "until": "lineup"}, "eq": true, "timeout_s": 80},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneRecoveryProbe.Read", "args": {"id": "carrier"}, "store": "approach"},
    {"op": "fly", "id": "carrier", "program": [{"orbit": {"bank": 40, "seconds": 16}}]},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneRecoveryProbe.Read", "args": {"id": "carrier", "until": "bolter"}, "eq": true, "timeout_s": 12},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneRecoveryProbe.Read", "args": {"id": "carrier"}, "store": "aborted"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist", "args": {"id": "carrier", "throttle": 0.6, "pitch": 0, "gear": false}},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -48, "y": -49, "z": 65, "lx": 0, "ly": -20, "lz": 28, "fov": 48}},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneRecoveryProbe.Read", "args": {"id": "carrier", "until": "captured"}, "eq": "captured", "timeout_s": 95},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneRecoveryProbe.Read", "args": {"id": "carrier"}, "store": "captured"},
    {"op": "capture", "name": "groza-fighter-on-trapeze", "hide_ui": true},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneRecoveryProbe.Read", "args": {"id": "carrier", "until": "secured"}, "eq": true, "timeout_s": 15},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Bay", "args": {"id": "carrier", "slot": 0}, "store": "serviceLaunch"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneRecoveryProbe.Read", "args": {"id": "carrier"}, "store": "servicing"},
    {"op": "timescale", "value": 3},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneRecoveryProbe.Read", "args": {"id": "carrier", "until": "ready"}, "eq": true, "timeout_s": 100},
    {"op": "timescale", "value": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Bay", "args": {"id": "carrier", "slot": 0}, "store": "relaunch"},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneRecoveryProbe.Read", "args": {"id": "carrier", "until": "released"}, "eq": true, "timeout_s": 15},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneRecoveryProbe.Read", "args": {"id": "carrier"}, "store": "relaunched"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"check": "alive", "ids": ["carrier"]},
    {"check": "result_equals", "path": "launch.started", "value": true},
    {"check": "result_equals", "path": "recall.recalled", "value": 1},
    {"check": "result_equals", "path": "marshal.phase", "value": 0},
    {"check": "result_equals", "path": "approach.phase", "value": 1},
    {"check": "result_equals", "path": "approach.deckReady", "value": true},
    {"check": "result_above", "path": "approach.arm", "min": 89},
    {"check": "result_equals", "path": "aborted.phase", "value": 4},
    {"check": "result_equals", "path": "aborted.state", "value": 3},
    {"check": "result_equals", "path": "aborted.deckReady", "value": false},
    {"check": "result_equals", "path": "aborted.friendly", "value": true},
    {"check": "result_above", "path": "aborted.rollCommand", "min": 0.2},
    {"check": "result_equals", "path": "captured.hookedModel", "value": true},
    {"check": "result_equals", "path": "captured.nozzle", "value": true},
    {"check": "result_equals", "path": "captured.burner", "value": false},
    {"check": "result_equals", "path": "captured.alive", "value": false},
    {"check": "result_equals", "path": "serviceLaunch.started", "value": false},
    {"check": "result_above", "path": "servicing.service", "min": 0},
    {"check": "result_equals", "path": "relaunch.started", "value": true},
    {"check": "result_equals", "path": "relaunched.friendly", "value": true},
    {"check": "result_equals", "path": "relaunched.hookedModel", "value": false}
  ]
}
