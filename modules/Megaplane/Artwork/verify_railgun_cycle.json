{
  "name": "ky44-railgun-cycle",
  "description": "Exercise the Trident's mechanical trigger interlocks, reversal, muzzle alignment, recoil, cooldown and safe stow.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "timeout_s": 110,
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}, "Megaplane": {"BayPayload": "Railgun"}}}},
  "ops": [
    {"op": "wait_until", "path": "BoscaliSummer.Modules.Megaplane.MegaplaneTemplate.Definition", "truthy": true, "timeout_s": 45},
    {"op": "seat", "id": "carrier", "aircraft": "KY-44 Groza", "near": [10000, -35000], "altitude": 6000, "speed": 140, "heading": 90, "view": "orbit", "timeout": 60},
    {"op": "record", "ids": ["*"], "hz": 2},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneRailProbe.Cycle", "args": {"id": "carrier", "down": true, "bearing": 65}},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneRailProbe.Cycle", "args": {"id": "carrier", "fire": true}, "store": "opening"},
    {"op": "wait", "seconds": 2.5},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneRailProbe.Cycle", "args": {"id": "carrier", "down": false, "fire": true}, "store": "lowering"},
    {"op": "wait", "seconds": 0.4},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneRailProbe.Cycle", "args": {"id": "carrier", "down": true}, "store": "reversing"},
    {"op": "wait", "seconds": 7},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": 37, "y": -39, "z": 63, "lx": 5, "ly": -16, "lz": 17, "fov": 43}},
    {"op": "wait", "seconds": 1},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneRailProbe.Cycle", "args": {"id": "carrier", "fire": true}, "store": "ready"},
    {"op": "wait", "seconds": 0.10},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneRailProbe.Cycle", "args": {"id": "carrier", "fire": true}, "store": "fired"},
    {"op": "capture", "name": "groza-trident-discharge", "hide_ui": true},
    {"op": "wait", "seconds": 0.14},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneRailProbe.Cycle", "args": {"id": "carrier"}, "store": "stroke"},
    {"op": "wait", "seconds": 0.45},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneRailProbe.Cycle", "args": {"id": "carrier", "down": false, "fire": true}, "store": "cooldown"},
    {"op": "wait", "seconds": 0.5},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneRailProbe.Cycle", "args": {"id": "carrier", "fire": true}, "store": "homing"},
    {"op": "wait", "seconds": 15},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneRailProbe.Cycle", "args": {"id": "carrier", "fire": true}, "store": "stowed"},
    {"op": "capture", "name": "groza-trident-stowed", "hide_ui": true},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"check": "alive", "ids": ["carrier"]},
    {"check": "result_equals", "path": "opening.phase", "value": "Opening"},
    {"check": "result_equals", "path": "opening.ammo", "value": 40},
    {"check": "result_equals", "path": "lowering.phase", "value": "Lowering"},
    {"check": "result_equals", "path": "lowering.live", "value": false},
    {"check": "result_equals", "path": "reversing.phase", "value": "Raising"},
    {"check": "result_equals", "path": "reversing.ammo", "value": 40},
    {"check": "result_equals", "path": "ready.phase", "value": "Deployed"},
    {"check": "result_equals", "path": "ready.live", "value": true},
    {"check": "result_equals", "path": "ready.selected", "value": true},
    {"check": "result_above", "path": "ready.aimX", "min": 0.65},
    {"check": "result_below", "path": "ready.aimY", "max": -0.15},
    {"check": "result_above", "path": "ready.clearance", "min": 0.15},
    {"check": "result_below", "path": "ready.muzzleError", "max": 0.18},
    {"check": "result_below", "path": "ready.muzzleAngle", "max": 0.5},
    {"check": "result_equals", "path": "fired.ammo", "value": 39},
    {"check": "result_equals", "path": "fired.shots", "value": 1},
    {"check": "result_above", "path": "stroke.recoil", "min": 0.20},
    {"check": "result_above", "path": "fired.flash", "min": 0.5},
    {"check": "result_below", "path": "fired.charge", "max": 0.10},
    {"check": "result_below", "path": "fired.muzzleError", "max": 0.18},
    {"check": "result_below", "path": "stroke.muzzleError", "max": 0.18},
    {"check": "result_equals", "path": "cooldown.shots", "value": 1},
    {"check": "result_equals", "path": "homing.phase", "value": "Homing"},
    {"check": "result_equals", "path": "homing.live", "value": false},
    {"check": "result_equals", "path": "stowed.phase", "value": "Stowed"},
    {"check": "result_equals", "path": "stowed.door", "value": 0},
    {"check": "result_equals", "path": "stowed.ammo", "value": 39}
  ]
}
