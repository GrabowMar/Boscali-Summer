{
  "name": "ky44-skywell",
  "description": "Use the native trigger on Groza's dedicated SKYWELL station, verify the tender trails its own mount and then stows, and operate the cargo ramp independently.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "timeout_s": 140,
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}, "Megaplane": {"BayPayload": "Fighters"}}}},
  "ops": [
    {"op": "wait_until", "path": "BoscaliSummer.Modules.Megaplane.MegaplaneTemplate.Definition", "truthy": true, "timeout_s": 45},
    {"op": "seat", "id": "carrier", "aircraft": "KY-44 Groza", "near": [10000, -35000], "altitude": 3000, "speed": 130, "heading": 0, "view": "orbit", "timeout": 60},
    {"ids": ["carrier"], "hz": 2, "op": "record"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist", "args": {"id": "carrier", "throttle": 0.54, "pitch": 0, "gear": false}},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSkywellProbe.Read", "args": {"id": "carrier"}, "store": "fit"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSkywellProbe.Read", "args": {"id": "carrier", "action": "trigger"}, "store": "deploy"},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneSkywellProbe.Read", "args": {"id": "carrier", "until": true}, "eq": "Tow", "timeout_s": 24},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -49, "y": -34, "z": -125, "lx": 0, "ly": -24, "lz": -75, "fov": 58}},
    {"op": "wait", "seconds": 1},
    {"op": "capture", "name": "groza-skywell-tow", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSkywellProbe.Read", "args": {"id": "carrier"}, "store": "tow"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSkywellProbe.Read", "args": {"id": "carrier", "action": "trigger"}, "store": "stowRequest"},
    {"op": "wait_until", "call": "BoscaliSummer.Modules.Megaplane.MegaplaneSkywellProbe.Read", "args": {"id": "carrier", "until": true}, "eq": "Stowed", "timeout_s": 25},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSkywellProbe.Read", "args": {"id": "carrier"}, "store": "stowed"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSkywellProbe.Read", "args": {"id": "carrier", "action": "cargo"}, "store": "cargoTrigger"},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneSkywellProbe.Read", "args": {"id": "carrier"}, "store": "cargoOpen"},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"ids": ["carrier"], "check": "alive"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"value": true, "check": "result_equals", "path": "fit.separated"},
    {"value": "VG_Skywell_Groza", "check": "result_equals", "path": "fit.kitKey"},
    {"value": true, "check": "result_equals", "path": "deploy.triggered"},
    {"value": true, "check": "result_equals", "path": "tow.visible"},
    {"max": -23, "check": "result_below", "path": "tow.tenderY"},
    {"max": -78, "check": "result_below", "path": "tow.tenderZ"},
    {"value": 1, "check": "result_equals", "path": "tow.kitAmmo"},
    {"min": 0, "check": "result_above", "path": "tow.cargoAmmo"},
    {"value": 0, "check": "result_equals", "path": "tow.ramp"},
    {"value": true, "check": "result_equals", "path": "stowRequest.triggered"},
    {"value": "Stowed", "check": "result_equals", "path": "stowed.state"},
    {"value": true, "check": "result_equals", "path": "cargoTrigger.triggered"},
    {"min": 0.1, "check": "result_above", "path": "cargoOpen.ramp"},
    {"value": "Stowed", "check": "result_equals", "path": "cargoOpen.state"}
  ]
}
