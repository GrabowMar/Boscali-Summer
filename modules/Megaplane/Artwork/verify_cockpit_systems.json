{
  "name": "ky44-native-flight-deck-systems",
  "description": "Check both screens from the normal pilot eye, actual actuator and damage indications, and recovery after switching views.",
  "mission": "Free Flight",
  "mods": ["boscalisummer"],
  "environment": {"config": {"boscalisummer": {"Trenches": {"Enabled": false}, "TheaterOps": {"Enabled": false}, "Events": {"Enabled": false}, "Garrisons": {"Enabled": false}, "DynamicOperations": {"Enabled": false}, "Support": {"Enabled": false}, "Weather": {"Enabled": false}}}, "resolution": [1600, 900]},
  "timeout_s": 140,
  "ops": [
    {"op": "atmosphere", "time_of_day": 15, "conditions": 0.03, "cloud_height": 4500},
    {"op": "seat", "id": "carrier", "aircraft": "KY-44 Groza", "near": [-24500, -17400], "altitude": 2100, "speed": 125, "heading": 150, "view": "cockpit", "timeout": 60},
    {"op": "wait", "seconds": 3},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "day"},
    {"op": "capture", "name": "ky44-bridge-from-pilot-seat", "hide_ui": false},
    {"op": "capture", "name": "ky44-bridge-day", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Gear", "args": {"id": "carrier", "down": true}},
    {"op": "wait", "seconds": 1.2},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "transit"},
    {"op": "wait", "seconds": 12.5},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "down"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Assist", "args": {"id": "carrier", "throttle": 0.65, "pitch": -0.65, "gear": true, "speed": 48}},
    {"op": "wait", "seconds": 6},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "lift"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "hit": "pod1_L", "health": 65}},
    {"op": "wait", "seconds": 0.4},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "partial"},
    {"op": "seat", "id": "carrier", "view": "orbit"},
    {"op": "wait", "seconds": 0.6},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "orbit"},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "hit": "pod1_L", "health": 0}},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "hit": "reactor", "health": 30}},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "hit": "coolant_L", "health": 0}},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Plant", "args": {"id": "carrier", "hit": "coolant_R", "health": 0}},
    {"op": "atmosphere", "time_of_day": 1, "conditions": 0.03, "cloud_height": 4500},
    {"op": "seat", "id": "carrier", "view": "cockpit"},
    {"op": "wait", "seconds": 3.5},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.Inspect", "args": {"id": "carrier"}, "store": "night"},
    {"op": "capture", "name": "ky44-bridge-night", "hide_ui": true},
    {"op": "call", "method": "BoscaliSummer.Modules.Megaplane.MegaplaneAutomation.View", "args": {"id": "carrier", "x": -1.15, "y": 5.397, "z": 100.645, "lx": -1.14, "ly": 5.08, "lz": 102.18, "fov": 37}},
    {"op": "wait", "seconds": 0.5},
    {"op": "capture", "name": "ky44-bridge-live-instruments", "hide_ui": true},
    {"op": "end"}
  ],
  "checks": [
    {"check": "status_ok"},
    {"check": "log_clean", "sources": ["Boscali Summer"]},
    {"check": "result_equals", "path": "day.display", "value": true},
    {"check": "result_equals", "path": "day.liveTexture", "value": true},
    {"check": "result_equals", "path": "day.tacticalInView", "value": true},
    {"check": "result_equals", "path": "day.systemsInView", "value": true},
    {"check": "result_below", "path": "day.eyeDistance", "max": 0.06},
    {"check": "result_equals", "path": "day.systems.ready", "value": true},
    {"check": "result_equals", "path": "day.systems.visible", "value": true},
    {"check": "result_equals", "path": "day.systems.pods", "value": [0,0,0,0,0,0,0,0]},
    {"check": "result_equals", "path": "day.systems.gear", "value": 0},
    {"check": "result_equals", "path": "day.systems.assist", "value": 0},
    {"check": "result_equals", "path": "day.systems.plant", "value": 0},
    {"check": "result_equals", "path": "transit.systems.gear", "value": 1},
    {"check": "result_equals", "path": "down.systems.gear", "value": 2},
    {"check": "result_equals", "path": "lift.systems.assist", "value": 1},
    {"check": "result_equals", "path": "partial.systems.port1", "value": 1},
    {"check": "result_equals", "path": "partial.systems.starboard1", "value": 0},
    {"check": "result_equals", "path": "orbit.display", "value": false},
    {"check": "result_equals", "path": "orbit.systems.visible", "value": false},
    {"check": "result_equals", "path": "night.systems.visible", "value": true},
    {"check": "result_equals", "path": "night.systems.port1", "value": 2},
    {"check": "result_equals", "path": "night.systems.starboard1", "value": 0},
    {"check": "result_equals", "path": "night.systems.plant", "value": 1},
    {"check": "result_equals", "path": "night.display", "value": true}
  ]
}
