/* OPS rooms (SPACE, CYBER, SPEC OPS and the imager). Each room owns its surface and ink; the
   Support module reads this sheet through RoomPaint (embedded as BoscaliSummer.Support.rooms.avss).
   These are the rooms' own literal palettes, not kit themes. Body ink is at least 4.5:1 on its
   surface; rules and accents at least 3:1 (OpsLayoutTests.CheckRoomInk pins it). */

.room-space-surface { background: #07141F; color: #EAF2F5; }
.room-space-line    { color: #7FB4D6; border: 1 #7FB4D6; }
.room-space-ink     { color: #EAF2F5; font: 12; tracking: 8; }
.room-space-display { color: #EAF2F5; font: 28; tracking: 12; }
.room-space-limb    { color: #6EBEDE; background: #123044; }
.room-space-dim     { color: #9DB7C7; font: 11; tracking: 6; }
.room-space-console { background: #0B1C2A; color: #EAF2F5; border: 1 #23415A; }

.room-cyber-surface { background: #07090C; color: #D7F5E4; }
.room-cyber-lattice { color: #3D5A52; border: 1 #3D5A52; }
.room-cyber-ink     { color: #D7F5E4; font: 12; tracking: 0; }
.room-cyber-title   { color: #9EE7C2; font: 11 bold; tracking: 4; }
.room-cyber-accent  { color: #C4B5FD; border: 1 #C4B5FD; }
.room-cyber-block   { color: #E8FFF2; font: 32 bold; tracking: 0; }
.room-cyber-pane    { background: #0A0E12; color: #D7F5E4; border: 1 #1F3A33; }
.room-cyber-bar     { background: #0F1A18; color: #9EE7C2; }
.room-cyber-dim     { color: #86A89A; font: 11; tracking: 0; }

.room-specops-map { background: #071319; color: #B9D9DE; }
.room-specops-paper { background: #0D1A22; color: #EDF6F5; border: 1 #55717A; }
.room-specops-ink { color: #EDF6F5; font: 12; tracking: 0; }
.room-specops-title { color: #EDF6F5; font: 16 bold; tracking: 2; }
.room-specops-stamp { color: #FFC36A; font: 11 bold; tracking: 2; border: 1 #FFC36A; }
.room-specops-khaki { color: #B2C8C9; border: 1 #55717A; }
.room-specops-banner { background: #14242C; color: #EDF6F5; font: 11 bold; tracking: 3; }
.room-specops-tape { background: #315562; }

.room-imager-ink  { color: #EFF5F5; font: 12; tracking: 6; }
.room-imager-halo { color: #090E12; background: #090E12 c0; }
.room-imager-pod  { background: #090E12; color: #EFF5F5; border: 1 #EFF5F5; }
.room-imager-dim  { color: #B9C8CD; font: 11; tracking: 4; }
